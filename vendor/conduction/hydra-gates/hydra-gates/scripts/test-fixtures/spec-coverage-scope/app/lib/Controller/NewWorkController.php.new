 * changed, in-scope, untagged method to find. If gate-16 does not FAIL on that
 * arm the gate is dead at every scope and no other arm proves anything.
 *
 * The `.new` suffix keeps it out of the base tree that `gf_build_repo` copies
 * wholesale, without needing a second fixture directory.
 */

namespace OCA\SpecCoverageFixture\Controller;

class NewWorkController
{
    /**
     * Brand-new endpoint added by this PR, deliberately carrying no @spec tag.
     */
    public function renderBrandNewReport(string $id): string
    {
        return 'new:' . $id;
    }
}
