<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:styles><style:presentation-page-layout style:name="AL1T1"><presentation:placeholder presentation:object="title" svg:x="2cm" svg:y="1cm" svg:width="24cm" svg:height="3cm"/><presentation:placeholder presentation:object="outline" svg:x="2cm" svg:y="5cm" svg:width="24cm" svg:height="8cm"/></style:presentation-page-layout></office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PM1"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm"/></style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="PM1"/>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="page1" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1T1">
    <draw:frame draw:layer="layout" presentation:class="title" svg:x="2cm" svg:y="1cm" svg:width="24cm" svg:height="3cm"><draw:text-box><text:p>Fotosynthese</text:p></draw:text-box></draw:frame>
    <draw:frame draw:layer="layout" presentation:class="outline" svg:x="2cm" svg:y="5cm" svg:width="14cm" svg:height="8cm"><draw:text-box><text:list><text:list-item><text:p>Planten maken voedsel</text:p></text:list-item><text:list-item><text:p>Licht, water en CO2</text:p></text:list-item></text:list></draw:text-box></draw:frame>
    <draw:frame draw:name="Blad" svg:x="18cm" svg:y="5cm" svg:width="6cm" svg:height="6cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4//8/AAX+Av6nNYGEAAAAAElFTkSuQmCC</office:binary-data></draw:image><svg:desc>Een blad in de zon</svg:desc></draw:frame>
    <presentation:notes>
     <draw:page-thumbnail draw:layer="layout" presentation:class="page" svg:x="2cm" svg:y="2cm" svg:width="17cm" svg:height="9cm"/>
     <draw:frame draw:layer="layout" presentation:class="notes" svg:x="2cm" svg:y="12cm" svg:width="17cm" svg:height="10cm"><draw:text-box><text:p>Vraag eerst wat ze al weten.</text:p><text:p>Laat ze daarna tekenen.</text:p></draw:text-box></draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page2" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1T1">
    <draw:frame draw:layer="layout" presentation:class="title" svg:x="2cm" svg:y="1cm" svg:width="24cm" svg:height="3cm"><draw:text-box><text:p>Water kookt</text:p></draw:text-box></draw:frame>
    <draw:frame svg:x="2cm" svg:y="5cm" svg:width="14cm" svg:height="3cm"><draw:text-box><text:p>Eerst</text:p></draw:text-box></draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
