                    "version": "1.0.0"
                },
                "language": "en",
                "formality": "formal",
                "instructions": "Example seed data, shipped to show the shape of an entry: replace or delete it. Use British English spelling and address the reader directly as you."
            },
            {
                "@self": {
                    "register": "translation-glossary",
                    "schema": "translation-style-guide",
                    "slug": "example-de",
                    "version": "1.0.0"
                },
                "language": "de",
                "formality": "formal",
                "instructions": "Example seed data, shipped to show the shape of an entry: replace or delete it. Address the reader formally with Sie."
            },
            {
                "@self": {
                    "register": "translation-glossary",
                    "schema": "translation-style-guide",
                    "slug": "example-fr",
                    "version": "1.0.0"
                },
                "language": "fr",
                "formality": "formal",
                "instructions": "Example seed data, shipped to show the shape of an entry: replace or delete it. Address the reader formally with vous."
            }
        ]
    }
}
