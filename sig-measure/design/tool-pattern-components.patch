+def pattern_components(app):
+    """Sigrid `components:` from sigrid.yaml (or the file named in SIG_COMPONENTS_YAML):
+    [(name, [include regex], [exclude regex])]. Patterns are regular expressions matched
+    against the full path with a leading slash, as Sigrid matches them; exclude wins over
+    include; the first component whose patterns match a file owns it; a file no component
+    matches lands in "Remainder". Returns [] when the file has no `components:` key."""
+    path = os.environ.get("SIG_COMPONENTS_YAML") or os.path.join(app, "sigrid.yaml")
+    if not os.path.isfile(path):
+        return []
+    comps, cur, key = [], None, None
+    for line in open(path, encoding="utf-8", errors="replace"):
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        if not line.startswith(" ") and stripped.startswith("components:"):
+            cur, key = "section", None
+            continue
+        if cur is None:
+            continue
+        if not line.startswith(" "):
+            break
+        m = re.match(r"^\s*-\s*name:\s*(.+?)\s*$", line)
+        if m:
+            comps.append((m.group(1).strip('"\''), [], [])); key = None
+            continue
+        m = re.match(r"^\s*(include|exclude):\s*$", line)
+        if m:
+            key = m.group(1)
+            continue
+        m = re.match(r"^\s*-\s*(.+?)\s*$", line)
+        if m and comps and key:
+            comps[-1][1 if key == "include" else 2].append(re.compile(m.group(1).strip().strip('"\'')))
+    return comps
+
+
+def pattern_component_of_factory(comps):
+    """Component function for pattern-defined components, see pattern_components()."""
+    cache = {}
+
+    def component(rel):
+        if rel in cache:
+            return cache[rel]
+        probe = "/" + rel
+        name = "Remainder"
+        for cname, inc, exc in comps:
+            if any(p.fullmatch(probe) for p in inc) and not any(p.fullmatch(probe) for p in exc):
+                name = cname
+                break
+        cache[rel] = name
+        return name
+    return component
+
