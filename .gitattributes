* text=auto eol=lf

*.conf text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
bin/console text eol=lf

*.ico binary
*.png binary

# 🔴 THE VENDORED OMG BPMN SCHEMA SET IS BYTE-PINNED, SO GIT MUST NOT TOUCH IT.
# The five files ship with CRLF endings exactly as omg.org serves them, and
# `* text=auto eol=lf` above would rewrite every line on checkout: the files on
# disk would then no longer hash to the SHA-256 sums recorded in
# schema/PROVENANCE.md, which is both a failing provenance test and, more to
# the point, a modified copy of a specification we said we had not modified.
lib/Service/Flow/Bpmn/schema/*.xsd -text

.github export-ignore
.travis.yml export-ignore
LICENSE export-ignore
README.md export-ignore
update-deps.sh export-ignore

# Generated files. GitHub collapses them in diffs and leaves them out of the
# language statistics. l10n/*.js is built from l10n/*.json; openapi.json is
# written by `composer openapi`.
l10n/*.js linguist-generated=true
openapi.json linguist-generated=true

# Third-party code and specifications we ship unchanged.
lib/Service/Flow/Bpmn/schema/*.xsd linguist-vendored=true
lib/Resources/schemaorg/*.jsonld linguist-vendored=true
lib/Resources/mdto/*.xsd linguist-vendored=true
lib/Resources/Vocabulary/tooi-*.jsonld linguist-vendored=true
lib/Resources/ggm/ggm-snapshot.json linguist-vendored=true
docker/dolphin/models/** linguist-vendored=true
