diff --git a/lib/Service/Cms/PlainPublicRecords.php b/lib/Service/Cms/PlainPublicRecords.php
new file mode 100644
index 000000000..e19b76542
--- /dev/null
+++ b/lib/Service/Cms/PlainPublicRecords.php
@@ -0,0 +1,326 @@
+<?php
+
+/**
+ * The plain public records block: a contributed list and one of its records.
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @category Service
+ * @package  OCA\Portaliq\Service\Cms
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/site-member-voting-record-and-confidential-papers/tasks.md#t3
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Portaliq\Service\Cms;
+
+use OCA\Portaliq\Kernel\Contracts\PublicRecordReaderInterface;
+use OCP\IL10N;
+
+/**
+ * The view model of a `publicRecords` widget on the plain page.
+ *
+ * Without `?record=`: a GET search form and the list's entries as links, each
+ * title with its subtitle, narrowed by `_search` on title and subtitle the way
+ * the site block narrows them. With `?record=<id>`: the record's heading, its
+ * subtitle and note, its summary figures, its rows as a table with the link
+ * column pointing at the row's subject, the page's own links and the link back
+ * to the list. An unknown list or record says the overview no longer exists,
+ * the block's own stale-link text. The same reader as the anonymous API reads
+ * the list, so the plain page shows exactly what the site shows.
+ *
+ * @spec openspec/changes/site-member-voting-record-and-confidential-papers/specs/site-council-records/spec.md
+ */
+class PlainPublicRecords {
+
+	/**
+	 * Constructor.
+	 *
+	 * @param PublicRecordReaderInterface $records The contributed lists, read as the anonymous API reads them.
+	 * @param IL10N                       $l10n    The words.
+	 */
+	public function __construct(
+		private readonly PublicRecordReaderInterface $records,
+		private readonly IL10N $l10n,
+	) {
+	}//end __construct()
+
+	/**
+	 * The block, or null when the placement names no list.
+	 *
+	 * @param array<string, mixed> $props   The widget's props (`app`, `list`, `title`, `linkKey`, `backText`, `searchLabel`, `recordHeading`, `links`).
+	 * @param PlainContext         $context The request.
+	 *
+	 * @return array<string, mixed>|null `kind` records, `state` list|record|gone.
+	 *
+	 * @spec openspec/changes/site-member-voting-record-and-confidential-papers/tasks.md#t3
+	 */
+	public function build(array $props, PlainContext $context): ?array {
+		$app = $this->text(value: ($props['app'] ?? ''));
+		$list = $this->text(value: ($props['list'] ?? ''));
+		if ($app === '' || $list === '') {
+			return null;
+		}
+
+		$block = [
+			'kind' => 'records',
+			'title' => $this->text(value: ($props['title'] ?? '')),
+			'backUrl' => $context->address->plain(route: $context->route),
+			'backLabel' => $this->orDefault(value: ($props['backText'] ?? ''), default: $this->l10n->t('Back to the overview')),
+		];
+
+		if ($context->record !== '') {
+			return $block + $this->recordView(props: $props, app: $app, list: $list, context: $context);
+		}
+
+		$entries = $this->records->entries(app: $app, list: $list);
+		if ($entries === null) {
+			return $block + $this->gone();
+		}
+
+		return $block + $this->listView(entries: $entries, props: $props, context: $context);
+	}//end build()
+
+	/**
+	 * The list: the search form and the matching entries as links.
+	 *
+	 * @param array<int, array<string, string>> $entries The list's entries.
+	 * @param array<string, mixed>              $props   The props.
+	 * @param PlainContext                      $context The request.
+	 *
+	 * @return array<string, mixed>
+	 */
+	private function listView(array $entries, array $props, PlainContext $context): array {
+		$needle = mb_strtolower(trim($context->query));
+		$links = [];
+		foreach ($entries as $entry) {
+			$id = $this->text(value: ($entry['id'] ?? ''));
+			$title = $this->text(value: ($entry['title'] ?? ''));
+			$subtitle = $this->text(value: ($entry['subtitle'] ?? ''));
+			if ($id === '' || $title === '') {
+				continue;
+			}
+
+			if ($needle !== '' && str_contains(mb_strtolower($title . ' ' . $subtitle), $needle) === false) {
+				continue;
+			}
+
+			$links[] = [
+				'label' => $title,
+				'description' => $subtitle,
+				'href' => $context->address->plain(route: $context->route, extra: ['record' => $id]),
+			];
+		}
+
+		$empty = '';
+		if ($links === []) {
+			$empty = $this->l10n->t('No items.');
+		}
+
+		return [
+			'state' => 'list',
+			'action' => $context->address->plainBase(),
+			'route' => $context->route,
+			'portal' => $context->address->portalSlug(),
+			'searchLabel' => $this->orDefault(value: ($props['searchLabel'] ?? ''), default: $this->l10n->t('Search for a name')),
+			'submit' => $this->l10n->t('Search'),
+			'query' => $context->query,
+			'links' => $links,
+			'empty' => $empty,
+		];
+	}//end listView()
+
+	/**
+	 * One record: heading, figures, rows and links; gone when the list does not hold it.
+	 *
+	 * @param array<string, mixed> $props   The props.
+	 * @param string               $app     The contributing app.
+	 * @param string               $list    The list id.
+	 * @param PlainContext         $context The request.
+	 *
+	 * @return array<string, mixed>
+	 */
+	private function recordView(array $props, string $app, string $list, PlainContext $context): array {
+		$record = $this->records->record(app: $app, list: $list, id: $context->record);
+		if ($record === null) {
+			return $this->gone();
+		}
+
+		$title = $this->text(value: ($record['title'] ?? ''));
+		$heading = $this->text(value: ($props['recordHeading'] ?? ''));
+		if ($heading === '') {
+			$heading = $title;
+		}
+
+		$columns = [];
+		foreach ((array)($record['columns'] ?? []) as $column) {
+			if (is_array($column) === true && $this->text(value: ($column['key'] ?? '')) !== '') {
+				$columns[] = ['key' => $this->text(value: $column['key']), 'label' => $this->text(value: ($column['label'] ?? $column['key']))];
+			}
+		}
+
+		$empty = '';
+		if ($columns === [] || (array)($record['rows'] ?? []) === []) {
+			$empty = $this->l10n->t('No items.');
+		}
+
+		return [
+			'state' => 'record',
+			'heading' => str_replace('{title}', $title, $heading),
+			'subtitle' => $this->text(value: ($record['subtitle'] ?? '')),
+			'note' => $this->text(value: ($record['note'] ?? '')),
+			'figures' => $this->figures(summary: ($record['summary'] ?? [])),
+			'columns' => $columns,
+			'rows' => $this->rows(
+				rows: ($record['rows'] ?? []),
+				columns: $columns,
+				linkKey: $this->orDefault(value: ($props['linkKey'] ?? ''), default: 'subject'),
+				address: $context->address
+			),
+			'empty' => $empty,
+			'links' => $this->pageLinks(links: ($props['links'] ?? []), address: $context->address),
+		];
+	}//end recordView()
+
+	/**
+	 * The summary cards as label, value and detail.
+	 *
+	 * @param mixed $summary The record's summary.
+	 *
+	 * @return list<array{label: string, value: string, detail: string}>
+	 */
+	private function figures(mixed $summary): array {
+		$figures = [];
+		foreach ((array)$summary as $card) {
+			if (is_array($card) === false || $this->text(value: ($card['label'] ?? '')) === '') {
+				continue;
+			}
+
+			$figures[] = [
+				'label' => $this->text(value: $card['label']),
+				'value' => $this->text(value: ($card['value'] ?? '')),
+				'detail' => $this->text(value: ($card['detail'] ?? '')),
+			];
+		}
+
+		return $figures;
+	}//end figures()
+
+	/**
+	 * The rows as cells in column order; the link column links the row's subject.
+	 *
+	 * @param mixed                                     $rows    The record's rows.
+	 * @param list<array{key: string, label: string}> $columns The columns.
+	 * @param string                                    $linkKey The column that links its subject.
+	 * @param PlainAddress                              $address The addresses.
+	 *
+	 * @return list<list<array{text: string, href: string}>>
+	 */
+	private function rows(mixed $rows, array $columns, string $linkKey, PlainAddress $address): array {
+		$table = [];
+		foreach ((array)$rows as $row) {
+			if (is_array($row) === false) {
+				continue;
+			}
+
+			$subject = '';
+			if (is_string($row['subjectUrl'] ?? null) === true) {
+				$subject = $address->authored(link: $row['subjectUrl']);
+			}
+
+			$cells = [];
+			foreach ($columns as $column) {
+				$href = '';
+				if ($column['key'] === $linkKey) {
+					$href = $subject;
+				}
+
+				$cells[] = ['text' => $this->text(value: ($row[$column['key']] ?? '')), 'href' => $href];
+			}
+
+			$table[] = $cells;
+		}
+
+		return $table;
+	}//end rows()
+
+	/**
+	 * The page's own links under the record: a site route or an http(s) address only.
+	 *
+	 * @param mixed        $links   The `links` prop.
+	 * @param PlainAddress $address The addresses.
+	 *
+	 * @return list<array{label: string, href: string}>
+	 */
+	private function pageLinks(mixed $links, PlainAddress $address): array {
+		$kept = [];
+		foreach ((array)$links as $link) {
+			if (is_array($link) === false) {
+				continue;
+			}
+
+			$label = $this->text(value: ($link['label'] ?? ''));
+			$href = $this->text(value: ($link['href'] ?? ''));
+			if ($label === '' || preg_match('#^(https?://|/(?!/))#i', $href) !== 1) {
+				continue;
+			}
+
+			$kept[] = ['label' => $label, 'href' => $address->authored(link: $href)];
+		}
+
+		return $kept;
+	}//end pageLinks()
+
+	/**
+	 * The stale-link answer: the list or record no longer exists.
+	 *
+	 * @return array{state: string, sentence: string}
+	 */
+	private function gone(): array {
+		return ['state' => 'gone', 'sentence' => $this->l10n->t('This overview no longer exists.')];
+	}//end gone()
+
+	/**
+	 * A prop as text, else the default.
+	 *
+	 * @param mixed  $value   The prop.
+	 * @param string $default The block's own words.
+	 *
+	 * @return string
+	 */
+	private function orDefault(mixed $value, string $default): string {
+		$text = $this->text(value: $value);
+		if ($text === '') {
+			return $default;
+		}
+
+		return $text;
+	}//end orDefault()
+
+	/**
+	 * A scalar as trimmed plain text; anything else ''.
+	 *
+	 * @param mixed $value The value.
+	 *
+	 * @return string
+	 */
+	private function text(mixed $value): string {
+		if (is_int($value) === true || is_float($value) === true) {
+			return (string)$value;
+		}
+
+		if (is_string($value) === false) {
+			return '';
+		}
+
+		return trim(strip_tags($value));
+	}//end text()
+}//end class
