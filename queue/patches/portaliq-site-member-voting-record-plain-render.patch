+<?php
+
+/**
+ * PlainPublicRecords: a contributed list and one of its records on the plain
+ * page, for a reader without JavaScript (site-member-voting-record-and-confidential-papers T3).
+ *
+ * @category Test
+ * @package  OCA\Portaliq\Tests\Unit\Service\Cms
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/site-member-voting-record-and-confidential-papers/tasks.md#t3
+ *
+ * phpcs:disable CustomSniffs.Functions.NamedParameters
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Portaliq\Tests\Unit\Service\Cms;
+
+use OCA\Portaliq\Kernel\Contracts\PublicRecordReaderInterface;
+use OCA\Portaliq\Service\Cms\PlainAddress;
+use OCA\Portaliq\Service\Cms\PlainContext;
+use OCA\Portaliq\Service\Cms\PlainPublicRecords;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\UsesClass;
+use PHPUnit\Framework\MockObject\MockObject;
+use PHPUnit\Framework\TestCase;
+
+#[CoversClass(PlainPublicRecords::class)]
+#[UsesClass(PlainAddress::class)]
+#[UsesClass(PlainContext::class)]
+class PlainPublicRecordsTest extends TestCase {
+
+	/**
+	 * The reader double.
+	 *
+	 * @var PublicRecordReaderInterface&MockObject
+	 */
+	private PublicRecordReaderInterface $reader;
+
+	/**
+	 * The props of the council's voting record page.
+	 *
+	 * @var array<string, mixed>
+	 */
+	private const PROPS = [
+		'app' => 'decidiq',
+		'list' => 'memberVotes',
+		'searchLabel' => 'Zoek een raadslid',
+		'backText' => 'Alle raadsleden',
+		'recordHeading' => 'Stemgedrag van {title}',
+		'links' => [
+			['label' => 'Over de raad', 'href' => '/raad'],
+			['label' => 'Kwaad', 'href' => 'javascript:alert(1)'],
+			['label' => 'Elders', 'href' => 'https://elders.example/raad'],
+		],
+	];
+
+	/**
+	 * Build the reader double.
+	 *
+	 * @return void
+	 */
+	protected function setUp(): void {
+		$this->reader = $this->createMock(PublicRecordReaderInterface::class);
+	}//end setUp()
+
+	/**
+	 * Without a record: the search form and every entry as a link that opens it.
+	 *
+	 * @return void
+	 */
+	public function testTheListIsASearchFormAndLinksToEachRecord(): void {
+		$this->reader->expects($this->once())->method('entries')->with('decidiq', 'memberVotes')->willReturn([
+			['id' => 'm1', 'title' => 'Anna de Vries', 'subtitle' => 'Partij A'],
+			['id' => 'm2', 'title' => 'Bram Jansen', 'subtitle' => 'Partij B'],
+			['id' => '', 'title' => 'Zonder id'],
+		]);
+		$this->reader->expects($this->never())->method('record');
+
+		$block = $this->records()->build(self::PROPS, $this->context());
+
+		$this->assertSame('records', $block['kind']);
+		$this->assertSame('list', $block['state']);
+		$this->assertSame('/index.php/apps/portaliq/site/plain', $block['action']);
+		$this->assertSame('/raadsleden', $block['route']);
+		$this->assertSame('demo', $block['portal']);
+		$this->assertSame('Zoek een raadslid', $block['searchLabel']);
+		$this->assertSame('Search', $block['submit']);
+		$this->assertSame('', $block['empty']);
+		$this->assertSame([
+			['label' => 'Anna de Vries', 'description' => 'Partij A', 'href' => '/index.php/apps/portaliq/site/plain?route=/raadsleden&portal=demo&record=m1'],
+			['label' => 'Bram Jansen', 'description' => 'Partij B', 'href' => '/index.php/apps/portaliq/site/plain?route=/raadsleden&portal=demo&record=m2'],
+		], $block['links']);
+	}//end testTheListIsASearchFormAndLinksToEachRecord()
+
+	/**
+	 * `_search` narrows the list on title and subtitle, ignoring case; no match says so.
+	 *
+	 * @return void
+	 */
+	public function testTheSearchNarrowsOnTitleAndSubtitle(): void {
+		$this->reader->method('entries')->willReturn([
+			['id' => 'm1', 'title' => 'Anna de Vries', 'subtitle' => 'Partij A'],
+			['id' => 'm2', 'title' => 'Bram Jansen', 'subtitle' => 'Partij B'],
+		]);
+
+		$bySubtitle = $this->records()->build(self::PROPS, $this->context(query: 'partij b'));
+		$this->assertSame(['Bram Jansen'], array_column($bySubtitle['links'], 'label'));
+		$this->assertSame('partij b', $bySubtitle['query']);
+
+		$none = $this->records()->build(self::PROPS, $this->context(query: 'niemand'));
+		$this->assertSame([], $none['links']);
+		$this->assertSame('No items.', $none['empty']);
+	}//end testTheSearchNarrowsOnTitleAndSubtitle()
+
+	/**
+	 * With a record: the heading from the page, the figures, the rows in column
+	 * order with the subject linked to its plain page, the safe page links and
+	 * the link back to the list.
+	 *
+	 * @return void
+	 */
+	public function testARecordShowsItsFiguresRowsAndTheWayBack(): void {
+		$this->reader->expects($this->never())->method('entries');
+		$this->reader->expects($this->once())->method('record')->with('decidiq', 'memberVotes', 'm1')->willReturn([
+			'title' => 'Anna de Vries',
+			'subtitle' => 'Partij A',
+			'summary' => [
+				['label' => 'Aanwezig', 'value' => '92%', 'detail' => 'aan 86 stemmingen'],
+				['label' => '', 'value' => 'zonder label'],
+			],
+			'columns' => [['key' => 'date', 'label' => 'Datum'], ['key' => 'subject', 'label' => 'Onderwerp'], ['key' => 'vote', 'label' => 'Stem']],
+			'rows' => [
+				['date' => '2026-03-01', 'subject' => 'Afvalbeleid', 'vote' => 'Voor', 'subjectUrl' => '/onderwerp/afval'],
+				['date' => '2026-03-08', 'subject' => 'Begroting', 'vote' => 'Tegen'],
+			],
+		]);
+
+		$block = $this->records()->build(self::PROPS, $this->context(record: 'm1'));
+
+		$this->assertSame('record', $block['state']);
+		$this->assertSame('Stemgedrag van Anna de Vries', $block['heading']);
+		$this->assertSame('Partij A', $block['subtitle']);
+		$this->assertSame([['label' => 'Aanwezig', 'value' => '92%', 'detail' => 'aan 86 stemmingen']], $block['figures']);
+		$this->assertSame(['Datum', 'Onderwerp', 'Stem'], array_column($block['columns'], 'label'));
+		$this->assertSame([
+			[
+				['text' => '2026-03-01', 'href' => ''],
+				['text' => 'Afvalbeleid', 'href' => '/index.php/apps/portaliq/site/plain?route=/onderwerp/afval&portal=demo'],
+				['text' => 'Voor', 'href' => ''],
+			],
+			[
+				['text' => '2026-03-08', 'href' => ''],
+				['text' => 'Begroting', 'href' => ''],
+				['text' => 'Tegen', 'href' => ''],
+			],
+		], $block['rows']);
+		$this->assertSame('', $block['empty']);
+		$this->assertSame([
+			['label' => 'Over de raad', 'href' => '/index.php/apps/portaliq/site/plain?route=/raad&portal=demo'],
+			['label' => 'Elders', 'href' => 'https://elders.example/raad'],
+		], $block['links']);
+		$this->assertSame('Alle raadsleden', $block['backLabel']);
+		$this->assertSame('/index.php/apps/portaliq/site/plain?route=/raadsleden&portal=demo', $block['backUrl']);
+	}//end testARecordShowsItsFiguresRowsAndTheWayBack()
+
+	/**
+	 * A record the list does not hold, and a list that is gone, give the
+	 * stale-link sentence and the way back, in the block's own words.
+	 *
+	 * @return void
+	 */
+	public function testAStaleLinkSaysTheOverviewIsGone(): void {
+		$this->reader->method('record')->willReturn(null);
+		$this->reader->method('entries')->willReturn(null);
+		$props = ['app' => 'decidiq', 'list' => 'memberVotes'];
+
+		$record = $this->records()->build($props, $this->context(record: 'weg'));
+		$this->assertSame('gone', $record['state']);
+		$this->assertSame('This overview no longer exists.', $record['sentence']);
+		$this->assertSame('Back to the overview', $record['backLabel']);
+
+		$list = $this->records()->build($props, $this->context());
+		$this->assertSame('gone', $list['state']);
+		$this->assertSame('This overview no longer exists.', $list['sentence']);
+	}//end testAStaleLinkSaysTheOverviewIsGone()
+
+	/**
+	 * A placement that names no app or no list is not a block; the page says it needs JavaScript.
+	 *
+	 * @return void
+	 */
+	public function testAPlacementWithoutAListIsNoBlock(): void {
+		$this->reader->expects($this->never())->method('entries');
+
+		$this->assertNull($this->records()->build(['app' => 'decidiq'], $this->context()));
+		$this->assertNull($this->records()->build(['list' => 'memberVotes', 'app' => ['x']], $this->context()));
+	}//end testAPlacementWithoutAListIsNoBlock()
+
+	/**
+	 * The builder over the reader double.
+	 *
+	 * @return PlainPublicRecords
+	 */
+	private function records(): PlainPublicRecords {
+		return new PlainPublicRecords($this->reader, PlainTestWords::for($this));
+	}//end records()
+
+	/**
+	 * A plain request for the council page of portal `demo`.
+	 *
+	 * @param string $query  The `_search`.
+	 * @param string $record The `record`.
+	 *
+	 * @return PlainContext
+	 */
+	private function context(string $query = '', string $record = ''): PlainContext {
+		return new PlainContext(
+			route: '/raadsleden',
+			routeParam: '',
+			query: $query,
+			page: 1,
+			address: new PlainAddress('/index.php/apps/portaliq/site', 'demo'),
+			locale: 'nl',
+			record: $record
+		);
+	}//end context()
+}//end class
-- 
