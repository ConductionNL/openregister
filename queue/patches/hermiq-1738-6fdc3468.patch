+<?php
+
+/**
+ * Unit tests for the project key rule.
+ *
+ * @category Test
+ * @package  OCA\Hermiq\Tests\Unit\Kernel
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-License-Identifier: EUPL-1.2
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/memory-project-scopes/specs/agent-memory/spec.md#requirement-an-agent-has-one-shared-memory-and-a-memory-per-project-req-pmem-001
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Hermiq\Tests\Unit\Kernel;
+
+use OCA\Hermiq\Kernel\ProjectKey;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * A project key is a lower-case slug of at most 64 characters.
+ */
+#[CoversClass(ProjectKey::class)]
+class ProjectKeyTest extends TestCase {
+
+	/**
+	 * Slugs of one to 64 lower-case letters, digits and inner hyphens pass.
+	 *
+	 * @return void
+	 */
+	public function testASlugIsAProjectKey(): void {
+		$this->assertTrue(condition: ProjectKey::isValid(key: 'omgevingsvisie-2040'));
+		$this->assertTrue(condition: ProjectKey::isValid(key: 'a'));
+		$this->assertTrue(condition: ProjectKey::isValid(key: str_repeat(string: 'a', times: 64)));
+	}//end testASlugIsAProjectKey()
+
+	/**
+	 * Empty, leading-hyphen, upper-case, slashed and over-long keys are refused.
+	 *
+	 * @return void
+	 */
+	public function testAnythingElseIsRefused(): void {
+		$this->assertFalse(condition: ProjectKey::isValid(key: ''));
+		$this->assertFalse(condition: ProjectKey::isValid(key: '-start'));
+		$this->assertFalse(condition: ProjectKey::isValid(key: 'Hoofd'));
+		$this->assertFalse(condition: ProjectKey::isValid(key: 'a/b'));
+		$this->assertFalse(condition: ProjectKey::isValid(key: str_repeat(string: 'a', times: 65)));
+	}//end testAnythingElseIsRefused()
+}//end class
