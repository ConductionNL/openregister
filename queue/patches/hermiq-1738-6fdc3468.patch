+<?php
+
+/**
+ * Hermiq ProjectKey
+ *
+ * The well-formedness rule of a memory project key, in the Kernel so a
+ * controller can check a requested key without depending on MemoryService.
+ *
+ * @category Kernel
+ * @package  OCA\Hermiq\Kernel
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @version GIT: <git-id>
+ *
+ * @link https://conduction.nl
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Hermiq\Kernel;
+
+/**
+ * The project key rule shared by MemoryService and SessionController.
+ *
+ * @spec exclude Structural helper; the requirement is tagged on isValid().
+ */
+final class ProjectKey {
+
+	/**
+	 * Whether a value is a well-formed project key: a short lower-case slug, as
+	 * the Memory schema's `projectKey` pattern declares.
+	 *
+	 * @param string $key The candidate key.
+	 *
+	 * @return bool True when it is one.
+	 *
+	 * @spec openspec/changes/memory-project-scopes/specs/agent-memory/spec.md#requirement-an-agent-has-one-shared-memory-and-a-memory-per-project-req-pmem-001
+	 */
+	public static function isValid(string $key): bool {
+		return preg_match('/^[a-z0-9][a-z0-9-]{0,63}$/', $key) === 1;
+	}//end isValid()
+}//end class
