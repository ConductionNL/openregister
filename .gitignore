# Quality reports
/quality-reports/
quality-baseline.json
/phpmetrics/
/phpmetrics-deps/
# PHPMD's incremental result cache. Generated output, and a correctness hazard if
# committed: `composer quality:phpmd-score` passes --cache, so a stale cache checked
# into the tree makes PHPMD replay a verdict for code that has since changed. That is
# a gate reporting a result it never computed.
.phpmd.result-cache.php

# PHPCS/Psalm output files (not config files)
phpcs-*.json
phpcs-*.txt
psalm-errors.json
psalm-output.json
psalm-full-output.json
phpqa_output.log

# Data files
*.csv
*.xls
*.xlsx
# Exception: committed Newman fixture consumed by
# tests/integration/magic-mapper-import.postman_collection.json — the CI
# Newman job checks out the app fresh (no dev-container state), so the
# fixture must be tracked, not generated.
!tests/integration/magic-mapper-data/*.csv
# Exception: committed CSV fixture consumed by the file-upload requests in
# tests/integration/openregister-crud.postman_collection.json (referenced by a
# path relative to the collection, so it resolves on the CI host runner too).
!tests/integration/test-import.csv

# Files with unusual names (trailing space, no extension) that are likely mistakes.
# Patterns listed here must NOT match legitimate PHP source filenames.
**/PR *
**/adds *
**/implements *
**/ALL *
**/endpoints *
**/*Analysis*
!**/*Analysis*.php
**/*references*
!**/*references*.php
!**/*references*/
**/*encoding*
!**/*encoding*.php
**/ter
**/clearCache*
**/update*Settings*
**/rebase*
**/setup*

# Temporary test files that shouldn't be committed
simple-solr-test.php
test-solr-connection.php

# Editor / scratch backups should never be committed (issue #1956 part d)
*.bak
*.bak2
*.bak3
*.orig
*.backup_*

phpqa/

# Docker AI models (too large for git)
docker/dolphin/models/

# Issues folder should be tracked
!issues/
!issues/**

