# Twenty-one findings surfaced by bumping nextcloud/ocp from v31.0.9 to v34.0.2.
#
# NONE OF THIS IS NEW CODE. Every line listed here is untouched by the commit
# that added this file. What changed is the API the analyser compares them
# against: appinfo/info.xml has declared support for Nextcloud 34 for some time,
# while nextcloud/ocp was pinned at 31, so a symbol REMOVED in 32/33/34 was
# simply invisible to PHPStan. `development` is green today, and that green is a
# statement about NC 31 — not about the version this app says it runs on.
#
# THEY ARE NOT ALL TYPE NOISE. Four are real removals that will fatal at runtime
# on NC 34:
#
#   ContentSecurityPolicy::allowEvalScript()      GraphQLController.php:198
#   IControllerMethodReflector::reflect()         PublicApiCorsMiddleware.php:88
#   IControllerMethodReflector::reflect()         RateLimitMiddleware.php:254
#   IQueryBuilder::execute()                      UserService.php:582
#
# and three pass a `renderAs` value ('admin', '500') that the narrowed
# TemplateResponse signature no longer accepts.
#
# WHY BASELINED RATHER THAN FIXED HERE: the commit that added this file is a
# whitespace and coding-standard migration. Porting the app to the NC 34 API is
# application work with runtime consequences — and several of the remaining
# entries are constant-false comparisons, where the always-false predicate may
# be the only thing currently suppressing a wrong code path. Repairing one of
# those without reading it can change behaviour rather than tidy it. Mixing that
# into a reformat would make both halves unreviewable.
#
# Tracked in openregister#2450, which lists every entry with its diagnosis.
# This file should shrink to nothing; it is debt, not a decision.

parameters:
	ignoreErrors:
		-
			message: "#^Parameter \\$container of class OCA\\\\OpenRegister\\\\Service\\\\Object\\\\CacheHandler constructor expects OCP\\\\AppFramework\\\\IAppContainer\\|null, OCP\\\\IContainer given\\.$#"
			count: 1
			path: lib/AppInfo/Application.php

		-
			message: "#^Parameter \\$container of class OCA\\\\OpenRegister\\\\Service\\\\SettingsService constructor expects OCP\\\\AppFramework\\\\IAppContainer\\|null, OCP\\\\IContainer given\\.$#"
			count: 1
			path: lib/AppInfo/Application.php

		-
			message: "#^Parameter \\$container of class OCA\\\\OpenRegister\\\\Service\\\\Settings\\\\ValidationOperationsHandler constructor expects OCP\\\\AppFramework\\\\IAppContainer, OCP\\\\IContainer given\\.$#"
			count: 1
			path: lib/AppInfo/Application.php

		-
			message: "#^Parameter \\$renderAs of class OCP\\\\AppFramework\\\\Http\\\\TemplateResponse constructor expects ''\\|'base'\\|'error'\\|'guest'\\|'public'\\|'user', '500' given\\.$#"
			count: 1
			path: lib/Controller/DashboardController.php

		-
			message: "#^Call to an undefined method OCP\\\\AppFramework\\\\Http\\\\ContentSecurityPolicy\\:\\:allowEvalScript\\(\\)\\.$#"
			count: 1
			path: lib/Controller/GraphQLController.php

		-
			message: "#^Strict comparison using \\=\\=\\= between true and false will always evaluate to false\\.$#"
			count: 1
			path: lib/Controller/RelationsController.php

		-
			message: "#^Strict comparison using \\=\\=\\= between array\\<string, mixed\\> and null will always evaluate to false\\.$#"
			count: 1
			path: lib/Db/FileMapper.php

		-
			message: "#^Strict comparison using \\=\\=\\= between array\\<string, mixed\\> and null will always evaluate to false\\.$#"
			count: 2
			path: lib/Db/MagicMapper.php

		-
			message: "#^Cannot call method getId\\(\\) on int\\.$#"
			count: 1
			path: lib/Listener/NativeFlowTriggerListener.php

		-
			message: "#^Cannot call method getName\\(\\) on int\\.$#"
			count: 1
			path: lib/Listener/NativeFlowTriggerListener.php

		-
			message: "#^Call to an undefined method OCP\\\\AppFramework\\\\Utility\\\\IControllerMethodReflector\\:\\:reflect\\(\\)\\.$#"
			count: 1
			path: lib/Middleware/PublicApiCorsMiddleware.php

		-
			message: "#^Call to an undefined method OCP\\\\AppFramework\\\\Utility\\\\IControllerMethodReflector\\:\\:reflect\\(\\)\\.$#"
			count: 1
			path: lib/Middleware/RateLimitMiddleware.php

		-
			message: "#^Parameter \\$shareType of method OCP\\\\Share\\\\IManager\\:\\:getSharesBy\\(\\) expects 0\\|1\\|2\\|3\\|4\\|6\\|7\\|8\\|9\\|10\\|12\\|13\\|15, int given\\.$#"
			count: 1
			path: lib/Service/File/FileSharingHandler.php

		-
			message: "#^Elseif branch is unreachable because previous condition is always true\\.$#"
			count: 1
			path: lib/Service/Object/RenderObject.php

		-
			message: "#^Parameter \\#2 \\$shareType of method OCP\\\\Share\\\\IManager\\:\\:getSharedWith\\(\\) expects 0\\|1\\|2\\|3\\|4\\|6\\|7\\|8\\|9\\|10\\|12\\|13\\|15, int given\\.$#"
			count: 1
			path: lib/Service/Rbac/ObjectGrantResolver.php

		-
			message: "#^Strict comparison using \\=\\=\\= between array\\<string, mixed\\> and null will always evaluate to false\\.$#"
			count: 1
			path: lib/Service/Schemas/SchemaCacheHandler.php

		-
			message: "#^Strict comparison using \\=\\=\\= between OCP\\\\Files\\\\Node and null will always evaluate to false\\.$#"
			count: 1
			path: lib/Service/ShareLinkService.php

		-
			message: "#^Call to an undefined method OCP\\\\DB\\\\QueryBuilder\\\\IQueryBuilder\\:\\:execute\\(\\)\\.$#"
			count: 1
			path: lib/Service/UserService.php

		-
			message: "#^Parameter \\$renderAs of class OCP\\\\AppFramework\\\\Http\\\\TemplateResponse constructor expects ''\\|'base'\\|'error'\\|'guest'\\|'public'\\|'user', 'admin' given\\.$#"
			count: 1
			path: lib/Settings/IntegrationsAdminSettings.php

		-
			message: "#^Parameter \\$renderAs of class OCP\\\\AppFramework\\\\Http\\\\TemplateResponse constructor expects ''\\|'base'\\|'error'\\|'guest'\\|'public'\\|'user', 'admin' given\\.$#"
			count: 1
			path: lib/Settings/OpenRegisterAdmin.php
