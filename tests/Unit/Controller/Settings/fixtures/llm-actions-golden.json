    "patch with model objects": {
        "calls": [
            {
                "settings.updateLLMSettingsOnly": [
                    {
                        "fireworksConfig": {
                            "embeddingModel": "fw-e",
                            "chatModel": "fw-c"
                        },
                        "openaiConfig": {
                            "model": "oa-e",
                            "chatModel": null,
                            "apiKey": "k"
                        },
                        "ollamaConfig": {
                            "model": "ol-e",
                            "chatModel": "ol-c",
                            "url": "u"
                        },
                        "chatProvider": "openai"
                    }
                ]
            },
            {
                "reporter.reportLlmProviders": [
                    "openai",
                    "ollama"
                ]
            }
        ],
        "status": 200,
        "data": {
            "success": true,
            "message": "LLM settings updated successfully",
            "data": {
                "chatProvider": "openai",
                "embeddingProvider": "ollama",
                "saved": true
            }
        }
    },
