    "organisation with conversations": {
        "calls": [
            {
                "organisationService.getActiveOrganisation": "alice"
            },
            {
                "qb1.select": [
                    "COUNT(id) AS total"
                ]
            },
            {
                "qb1.from": [
                    "openregister_agents",
                    null
                ]
            },
            {
                "param": [
                    ":p1",
                    "org-a",
                    2
                ]
            },
            {
                "qb1.where": [
                    "eq(organisation, :p1)"
                ]
            },
            {
                "qb1.executeQuery": true
            },
            {
                "qb2.select": [
                    "COUNT(id) AS total"
                ]
            },
            {
                "qb2.from": [
                    "openregister_conversations",
                    null
                ]
            },
            {
                "param": [
                    ":p2",
                    "org-a",
                    2
                ]
            },
            {
                "qb2.where": [
                    "eq(organisation, :p2)"
                ]
            },
            {
                "qb2.executeQuery": true
            },
            {
                "qb3.select": [
                    "id"
                ]
            },
            {
                "qb3.from": [
                    "openregister_conversations",
                    null
                ]
            },
            {
                "param": [
                    ":p3",
                    "org-a",
                    2
                ]
            },
            {
                "qb3.where": [
                    "eq(organisation, :p3)"
                ]
            },
            {
                "qb3.executeQuery": true
            },
            {
                "closeCursor": true
            },
            {
                "qb4.select": [
                    "COUNT(id) AS total"
                ]
            },
            {
                "qb4.from": [
                    "openregister_messages",
                    null
                ]
            },
            {
                "param": [
                    ":p4",
                    [
                        7,
                        9
                    ],
                    101
                ]
            },
            {
                "qb4.where": [
                    "in(conversation_id, :p4)"
                ]
            },
            {
                "qb4.executeQuery": true
            }
        ],
        "status": 200,
        "data": {
            "total_agents": 3,
            "total_conversations": 2,
            "total_messages": 11
