    "markDerivedOutdated": {
        "sql": [
            "-- new builder",
            "update(openregister_translations, null)",
            "param :p1 = \"outdated\"",
            "set(status, :p1)",
            "param :p2 = <timestamp>",
            "set(updated, :p2)",
            "param :p3 = \"obj-1\"",
            "where(eq(object_uuid, :p3))",
            "param :p4 = \"title\"",
            "andWhere(eq(property, :p4))",
            "param :p5 = \"nl\"",
            "andWhere(neq(language, :p5))",
