    "testDispatchMatchesTheRecording dead end": {
        "outcome": {
            "thrown": "OCA\\OpenRegister\\Service\\Flow\\FlowDeadEnd",
            "message": "This flow is not runnable: nodes \"b\", \"\" have no outgoing edge and does not end the flow, so a run would stop there and still be reported as completed. Connect them, give them a terminal step type, or mark them \"exit\": true if stopping there is deliberate."
        },
        "calls": [
            {
                "container.get": "OCA\\OpenRegister\\Db\\FlowVersionMapperInterface"
            },
            {
                "versions.findPublished": "flow-1"
            },
            {
                "container.get": "OCA\\OpenRegister\\Service\\Flow\\FlowDefinitionPin"
            },
            {
                "definitions.graphFor": "hash-3"
            },
            {
                "container.get": "OCA\\OpenRegister\\Db\\FlowMapper"
            },
            {
                "container.get": "OCA\\OpenRegister\\Service\\Flow\\FlowNodePreflight"
            },
            {
                "flows.findByUuid": "flow-1"
            },
            {
                "preflight.inspect": {
                    "nodes": [
                        {
                            "id": "a"
                        }
                    ],
                    "edges": [
                        {
                            "from": "a"
                        }
                    ]
                }
            },
            {
                "flows.update": {
                    "status": "error",
                    "message": "This flow is not runnable: nodes \"b\", \"\" have no outgoing edge and does not end the flow, so a run would stop there and still be reported as completed. Connect them, give them a terminal step type, or mark them \"exit\": true if stopping there is deliberate."
                }
            },
            {
                "log.warning": "[FlowRunVersionPin] Refused to queue a flow with a dead end",
                "context": {
                    "flow": "flow-1",
                    "nodes": [
                        "b",
                        ""
                    ]
                }
            }
        ]
    },
