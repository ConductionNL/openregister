{
    "lock": {
        "surface": {
            "class": "OCA\\OpenRegister\\Service\\Flow\\Nodes\\LockObjectNode",
            "interfaces": [
                "OCA\\OpenRegister\\Service\\Flow\\IFlowNode",
                "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeConfigForm",
                "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeConfigKeys",
                "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeTaxonomy"
            ],
            "id": "openregister.lock-object",
            "name": "Lock an object",
            "description": "Hold an object for this run so nobody else can change it. If another run holds it, this step waits and tries again.",
            "icon": "openregister:lock.svg",
            "scopes": [
                true,
                true,
                false,
                false
            ],
            "getKind": {
                "returned": "serviceTask"
            },
            "getCategory": {
                "returned": "objects"
            },
            "configKeys": {
                "returned": [
                    "uuid",
                    "duration",
                    "waitSeconds",
                    "process",
                    "subjectRole"
                ]
            },
            "configForm": {
                "returned": [
                    {
                        "key": "uuid",
                        "label": "Object",
                        "type": "text",
                        "help": "Which object to lock. Leave empty to lock the object the step receives."
                    },
                    {
                        "key": "duration",
                        "label": "Hold for (seconds)",
                        "type": "number",
                        "help": "How long the lock survives if this run never releases it. Defaults to one hour."
                    },
                    {
                        "key": "waitSeconds",
                        "label": "Wait at most (seconds)",
                        "type": "number",
                        "help": "How long to keep retrying while another run holds the object. Defaults to one hour."
                    },
                    {
                        "key": "process",
                        "label": "Reason",
                        "type": "text",
                        "help": "What the lock is for. Shown to anyone whose write is refused."
                    },
                    {
                        "key": "subjectRole",
                        "label": "Record the locked object as",
                        "type": "text",
                        "help": "Your own word for what this object is to this flow, such as \"case\" or \"besluit\". A later step can then attach its task to it by that name. Leave it empty and the step records nothing."
                    }
                ]
            },
            "validate": {
                "empty": {
                    "returned": null
                },
                "uuid": {
                    "returned": null
                },
                "bad-uuid": {
                    "threw": "UnexpectedValueException",
                    "message": "A lock step's object must be text."
                },
                "null-uuid": {
                    "returned": null
                },
                "bad-wait": {
                    "threw": "UnexpectedValueException",
                    "message": "A lock step's \"%s\" must be a whole number of seconds, at least 1. [\"waitSeconds\"]"
                }
            }
        },
        "execute": {
            "no-items": {
                "returned": [],
                "calls": []
            },
            "allowed": {
                "returned": [
                    {
                        "json": {
