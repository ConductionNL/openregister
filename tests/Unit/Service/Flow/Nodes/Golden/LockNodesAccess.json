                            "lock"
                        ]
                    ],
                    [
                        "runAs",
                        "alice"
                    ],
                    [
                        "lockObject",
                        [
                            "o-2",
                            "flow run run-legacy",
                            3600,
                            false,
                            "run-legacy",
                            "lock"
                        ]
                    ]
                ]
            },
            "refused-bad-uuid-config": {
                "threw": "UnexpectedValueException",
                "message": "A lock step's object must be text.",
                "calls": []
            },
            "refused-bad-duration": {
                "threw": "UnexpectedValueException",
                "message": "A lock step's \"%s\" must be a whole number of seconds, at least 1. [\"duration\"]",
                "calls": []
            },
            "refused-no-resume": {
                "threw": "RuntimeException",
                "message": "A lock step needs a resume slot; this run did not provide one.",
                "calls": []
            },
            "refused-no-run": {
                "threw": "RuntimeException",
                "message": "A lock step needs the run it belongs to; this run did not identify itself.",
                "calls": []
            },
            "refused-no-identity": {
                "threw": "RuntimeException",
                "message": "This flow run has no acting identity (runAs); a lock must be attributable.",
                "calls": []
            },
            "refused-unknown-identity": {
                "threw": "RuntimeException",
                "message": "This flow run acts as \"%s\", which is not a user account. [\"mallory\"]",
                "calls": []
            },
            "refused-disabled-identity": {
                "threw": "RuntimeException",
                "message": "This flow run acts as \"%s\", whose account is disabled. [\"dora\"]",
                "calls": []
            },
            "refused-no-target": {
                "threw": "RuntimeException",
                "message": "A lock step could not work out which object to lock from the item it received.",
                "calls": []
            },
            "refused-non-array-json": {
                "threw": "RuntimeException",
                "message": "A lock step could not work out which object to lock from the item it received.",
                "calls": []
            },
            "held-waits": {
                "suspended": "waiting for a lock on o-1",
                "calls": [
                    [
                        "runAs",
                        "alice"
                    ],
                    [
                        "lockObject",
                        [
                            "o-1",
                            "flow run run-1",
                            3600,
                            false,
                            "run-1",
                            "lock"
                        ]
                    ]
                ]
            },
            "held-gives-up": {
                "threw": "RuntimeException",
                "message": "Waited as long as allowed for object %s, and it is still locked: %s [\"o-1\",\"held by another run\"]",
                "calls": [
                    [
                        "runAs",
                        "alice"
                    ],
                    [
                        "lockObject",
                        [
                            "o-1",
                            "flow run run-1",
                            3600,
                            false,
                            "run-1",
                            "lock"
                        ]
                    ]
                ]
            }
        }
    },
