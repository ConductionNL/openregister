[
    {
        "class": "OCA\\OpenRegister\\Service\\Flow\\Nodes\\SendEmailNode",
        "interfaces": [
            "OCA\\OpenRegister\\Service\\Flow\\IFlowNode",
            "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeConfigForm",
            "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeConfigKeys",
            "OCA\\OpenRegister\\Service\\Flow\\IFlowNodePreview",
            "OCA\\OpenRegister\\Service\\Flow\\IFlowNodeTaxonomy",
            "OCA\\OpenRegister\\Service\\Flow\\Nodes\\SendEmailNodeInterface"
        ],
        "id": "openregister.send-email",
        "name": "Send an email",
        "description": "Send an email to people, at this point in the flow.",
        "icon": "core:actions/mail.svg",
        "scopes": [
            true,
            true,
            false,
            false
        ],
        "getKind": {
            "returned": "sendTask"
        },
        "getCategory": {
            "returned": "messaging"
        },
        "configKeys": {
            "returned": [
                "recipients",
                "subject",
                "body",
                "externalRecipients",
                "messageCategory"
            ]
        },
        "configForm": {
            "returned": [
                {
                    "key": "recipients",
                    "label": "Who to mail",
                    "type": "text",
                    "help": "User or group ids, email addresses, or a field such as {{ assignee }}. Groups are expanded; addresses need external recipients.",
                    "required": true
                },
                {
                    "key": "externalRecipients",
                    "label": "External recipients",
                    "type": "text",
                    "help": "Set to none to refuse email addresses, object to mail only addresses on the item, or any to mail every valid address."
                },
                {
                    "key": "messageCategory",
                    "label": "Message category",
                    "type": "select",
                    "options": [
                        {
                            "value": "service",
                            "label": "Service message (default)"
                        },
                        {
                            "value": "case-update",
                            "label": "Case update"
                        },
                        {
                            "value": "reminder",
                            "label": "Reminder"
                        },
                        {
                            "value": "marketing",
                            "label": "Marketing, such as a newsletter"
                        },
                        {
                            "value": "besluit",
                            "label": "Decision (besluit), always sent"
                        },
                        {
                            "value": "statutory",
                            "label": "Statutory notice, always sent"
                        },
                        {
                            "value": "account",
                            "label": "Account message, always sent"
                        },
                        {
                            "value": "security",
                            "label": "Security message, always sent"
                        }
                    ],
                    "help": "Decisions, statutory notices, account and security mail always arrive. Other mail stops after an opt-out. Empty means service."
                },
                {
                    "key": "subject",
                    "label": "Subject",
                    "type": "text",
                    "help": "Placeholders such as {{ name }} read fields from the item, the same syntax a schema notification uses."
                },
                {
                    "key": "body",
                    "label": "Body",
                    "type": "textarea",
                    "help": "What the email says. Placeholders read fields from the item.",
                    "required": true
                }
            ]
        },
        "validate": {
            "empty": {
                "threw": "UnexpectedValueException",
                "message": "An email needs a body."
            },
            "blank-body": {
                "threw": "UnexpectedValueException",
                "message": "An email needs a body."
            },
            "string-recipient": {
                "returned": null
            },
            "blank-recipients": {
                "threw": "UnexpectedValueException",
                "message": "An email needs at least one recipient."
            },
            "no-conversation": {
                "returned": null
            },
            "bad-external": {
                "threw": "UnexpectedValueException",
                "message": "External recipients must be none, object or any, not \"%s\". [\"Some\"]"
            },
            "good-external": {
                "returned": null
            },
            "bad-category": {
                "threw": "UnexpectedValueException",
                "message": "messageCategory must be one of %1$s, not \"%2$s\". [\"besluit, statutory, account, security, case-update, reminder, service, marketing\",\"spam\"]"
            },
            "array-category": {
                "threw": "UnexpectedValueException",
                "message": "messageCategory must be one of %1$s, not \"%2$s\". [\"besluit, statutory, account, security, case-update, reminder, service, marketing\",\"\"]"
            },
            "good-category": {
                "returned": null
            }
        },
        "preview": {
            "summary": "Send an email would send 2 message(s)",
            "messages": [
                {
                    "to": "bob"
                },
                {
                    "to": "eve"
                }
            ]
        },
        "execute": [
            {
                "json": {
                    "name": "a"
                }
            },
            {
                "json": {
                    "name": "b"
                }
            }
        ],
        "calls": [
            [
                "previewMessages",
                "email",
                {
                    "recipients": [
                        "bob"
                    ],
                    "message": "hi"
                },
                [
                    {
                        "json": {
                            "name": "a"
                        }
                    },
                    {
                        "json": {
                            "name": "b"
                        }
                    }
                ],
                {
                    "runId": 7
                }
            ],
            [
                "sendEmail",
                {
                    "recipients": [
                        "bob"
                    ],
                    "message": "hi"
                },
                [
                    {
                        "json": {
                            "name": "a"
                        }
                    },
                    {
                        "json": {
                            "name": "b"
                        }
                    }
                ],
                {
                    "runId": 7
                },
                "openregister.send-email"
            ]
        ]
    },
