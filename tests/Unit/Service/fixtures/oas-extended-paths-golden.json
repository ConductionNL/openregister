{
    "Zaak audit-trails": {
        "get": {
            "summary": "Get audit logs for a Zaak object",
            "operationId": "getLogsZaak",
            "tags": [
                "Zaak"
            ],
            "description": "Retrieve the audit trail for a specific Zaak object",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Unique identifier of the Zaak object",
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Audit logs retrieved successfully",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/AuditTrail"
                                }
                            }
                        }
                    }
                },
                "404": {
                    "description": "Zaak not found",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Error"
                            }
                        }
                    }
                }
            }
        }
    },
    "Zaak files": {
        "get": {
            "summary": "Get files for a Zaak object",
            "operationId": "getFilesZaak",
            "tags": [
                "Zaak"
            ],
            "description": "Retrieve all files associated with a specific Zaak object",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Unique identifier of the Zaak object",
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Files retrieved successfully",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/File"
                                }
                            }
                        }
                    }
                },
                "404": {
                    "description": "Zaak not found",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Error"
                            }
                        }
                    }
                }
            }
        },
        "post": {
            "summary": "Upload a file for a Zaak object",
            "operationId": "uploadFileZaak",
            "tags": [
                "Zaak"
            ],
            "description": "Upload a new file and associate it with a specific Zaak object",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Unique identifier of the Zaak object",
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "multipart/form-data": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "file": {
                                    "type": "string",
                                    "format": "binary",
                                    "description": "The file to upload"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "201": {
                    "description": "File uploaded successfully",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/File"
                            }
                        }
                    }
                },
                "404": {
                    "description": "Zaak not found",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Error"
                            }
                        }
                    }
                }
            }
        }
    },
    "Zaak lock": {
        "post": {
            "summary": "Lock a Zaak object",
            "operationId": "lockZaak",
            "tags": [
                "Zaak"
            ],
            "description": "Lock a specific Zaak object to prevent concurrent modifications",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Unique identifier of the Zaak object to lock",
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Object locked successfully",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Lock"
                            }
                        }
                    }
                },
                "404": {
                    "description": "Zaak not found",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Error"
                            }
                        }
                    }
                },
                "409": {
                    "description": "Object is already locked"
                }
            }
        }
    },
    "Zaak unlock": {
        "post": {
            "summary": "Unlock a Zaak object",
            "operationId": "unlockZaak",
            "tags": [
                "Zaak"
            ],
            "description": "Remove the lock from a specific Zaak object",
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Unique identifier of the Zaak object to unlock",
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Object unlocked successfully"
                },
                "404": {
                    "description": "Zaak not found",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Error"
                            }
                        }
                    }
                },
                "409": {
                    "description": "Object is not locked or locked by another user"
                }
            }
        }
    },
