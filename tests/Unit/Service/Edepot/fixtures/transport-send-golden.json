    "rest: accepted with a rejected object": {
        "calls": [
            {
                "log": "info",
                "message": "[RestApiTransport] Starting REST API transfer",
                "context": {
                    "endpoint": "https://edepot.example.com/api/ingest"
                }
            },
            {
                "http": "post",
                "args": [
                    "https://edepot.example.com/api/ingest",
                    {
                        "headers": {
                            "X-API-Key": "a-real-key"
                        },
                        "multipart": [
                            {
                                "name": "sip",
                                "contents": "resource",
                                "filename": "<sip-name>"
                            }
                        ],
                        "timeout": 300
                    }
                ]
            },
            {
                "log": "info",
                "message": "[RestApiTransport] REST API transfer completed",
                "context": {
                    "statusCode": 200,
                    "reference": "R-1",
                    "hasRejections": true
                }
            }
        ],
        "result": {
            "success": false,
            "objectResults": {
                "a": {
                    "accepted": true,
                    "reference": null,
                    "error": null
                },
                "b": {
                    "accepted": false,
                    "reference": null,
                    "error": "bad"
                },
                "c": {
                    "accepted": true,
                    "reference": "X",
                    "error": null
                }
            },
            "errorMessage": null,
            "transferReference": "R-1",
            "partial": true
        }
    },
