            "type": "string"
        }
    },
    "inversedBy without type": {
        "inversedBy": "owner"
    },
    "array items as array": {
        "type": "array",
        "items": {
            "format": "uuid",
            "type": "string",
            "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
            "description": "UUID reference to a related object"
        }
    },
    "array items inversedBy": {
        "type": "array",
        "items": {
            "type": "string",
            "inversedBy": "parent",
            "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
            "description": "UUID reference to a related object (inversedBy - should be empty)"
        }
    },
    "array items ref": {
        "type": "array",
        "items": {
            "type": "string",
            "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
            "description": "UUID reference to a related object"
        }
    },
