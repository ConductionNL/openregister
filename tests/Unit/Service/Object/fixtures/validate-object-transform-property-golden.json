            "n"
        ]
    },
    "string ref": {
        "type": "string",
        "format": "uuid"
    },
    "bare slug ref": [],
    "fragment ref kept": {
        "$ref": "#/definitions/x"
    },
    "uri ref kept": {
        "$ref": "https://example.org/schema"
    },
    "typed number ref kept": {
        "type": "number",
        "$ref": "measure"
    },
    "nested properties": {
        "type": "object",
        "properties": {
            "inner": {
                "type": "array",
                "items": {
                    "type": "string",
                    "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
                    "description": "UUID reference to a related object"
                }
            },
            "other": {
                "type": "string"
            }
        }
    },
    "inversedBy object, fragment ref": {
        "inversedBy": "owner",
        "oneOf": [
            {
                "type": "null",
                "description": "No related object (inversedBy - managed by other side)"
            },
            {
                "type": "string",
                "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
                "description": "UUID reference to a related object"
            },
            {
                "type": "object",
                "description": "Nested object that will be created separately"
            }
        ]
    },
    "fragment-only ref kept": {
        "$ref": "#anchor"
    },
    "object related-object": {
        "type": "string",
        "objectConfiguration": {
            "handling": "related-object"
        },
        "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
        "description": "UUID reference to a related object"
    },
    "object nested-object": {
        "type": "object",
        "objectConfiguration": {
            "handling": "nested-object"
        },
        "properties": {
            "a": {
                "type": "string"
            }
        }
    },
    "array items related-schema": {
        "type": "array",
        "items": {
            "type": "string",
            "objectConfiguration": {
                "handling": "related-schema"
            },
            "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
            "description": "UUID reference to a related object"
        }
    },
    "untyped with properties": {
