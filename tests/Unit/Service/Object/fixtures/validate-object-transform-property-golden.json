{
    "plain string": {
        "type": "string"
    },
    "unusable int ref": {
        "type": "array",
        "items": {
            "type": "string"
        }
    },
    "unusable empty ref": [],
    "inversedBy array": {
        "type": "array",
        "inversedBy": "owner",
        "items": {
            "oneOf": [
                {
                    "type": "string",
                    "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
                    "description": "UUID reference to a related object"
                },
                {
                    "type": "object",
                    "description": "Nested object that will be created separately"
                }
            ]
        }
    },
    "inversedBy object": {
        "inversedBy": "owner",
        "oneOf": [
            {
                "type": "null",
                "description": "No related object (inversedBy - managed by other side)"
            },
            {
                "type": "string",
                "pattern": "^([a-z]+-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|[0-9]+)$",
                "description": "UUID reference to a related object"
            },
            {
                "type": "object",
                "description": "Nested object that will be created separately"
            }
        ]
    },
    "inversedBy string": {
        "type": "string",
        "inversedBy": "owner"
    },
