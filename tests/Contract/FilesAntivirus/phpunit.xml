<?xml version="1.0" encoding="UTF-8"?>
<!--
    The files_antivirus contract suite. Not part of `test:all`: it needs a
    files_antivirus tree (FILES_ANTIVIRUS_PATH) and runs in its own CI workflow,
    .github/workflows/files-antivirus-contract.yml.

    Run: FILES_ANTIVIRUS_PATH=/path/to/files_antivirus composer test:files-antivirus-contract
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         cacheDirectory="../../../.phpunit.cache/files-antivirus-contract"
         failOnRisky="true"
         failOnWarning="true"
         failOnSkipped="true"
         failOnIncomplete="true">
    <testsuites>
        <testsuite name="Files Antivirus Contract">
            <directory>.</directory>
        </testsuite>
    </testsuites>
</phpunit>
