		{
			"name": "setUp: a privacy officer who reads Dutch",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "OCS-APIRequest",
						"value": "true"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ocs/v2.php/cloud/users?format=json",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"ocs",
						"v2.php",
						"cloud",
						"users"
					],
					"query": [
						{
							"key": "format",
							"value": "json"
						}
					]
				},
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{admin_user}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{admin_password}}",
							"type": "string"
						}
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\"userid\": \"{{officerId}}\", \"password\": \"{{officerPassword}}\", \"groups\": [\"admin\"], \"language\": \"nl\"}"
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Values unique to this run: extraction is keyed on the content, and entities are shared by value.",
							"const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
							"pm.collectionVariables.set('suffix', suffix);",
							"pm.collectionVariables.set('officerId', 'or-plates-officer-' + suffix);",
							"pm.collectionVariables.set('officerPassword', 'Kt!' + suffix + '-' + Math.random().toString(36).slice(2) + 'Zq9');",
							"const digit = () => String(Math.floor(Math.random() * 10));",
							"const consonants = 'BDFGHJKLMNPRSTVWXYZ';",
							"const letter = () => consonants[Math.floor(Math.random() * consonants.length)];",
							"// Sidecode 7, 99-XXX-9: letters without C, Q and the vowels.",
							"const plate = () => digit() + digit() + '-' + letter() + letter() + letter() + '-' + digit();",
							"// A BSN passes the eleven test: 9a + 8b + ... + 2h - i is a multiple of 11.",
							"const bsn = () => { for (;;) { const d = Array.from({ length: 8 }, () => Math.floor(Math.random() * 10)); d[0] = 1 + Math.floor(Math.random() * 9); const sum = d.reduce((s, v, i) => s + v * (9 - i), 0); const last = sum % 11; if (last < 10) { return d.join('') + last; } } };",
							"pm.collectionVariables.set('plate1', plate()); pm.collectionVariables.set('bsn1', bsn());",
							"let p2 = plate(); while (p2 === pm.collectionVariables.get('plate1')) { p2 = plate(); }",
							"pm.collectionVariables.set('plate2', p2); pm.collectionVariables.set('bsn2', bsn());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the officer is created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
