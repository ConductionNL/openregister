				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the settings are read', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));",
							"const o = pm.response.json();",
							"// A save REPLACES the file settings: a key it does not name goes back to its default. So every save",
							"// below sends the whole set as read here, with only the keys it is about changed.",
							"const before = Object.assign({}, o); delete before.documentStore; delete before.openAnonymiserPasswordSet;",
							"pm.collectionVariables.set('settingsBefore', JSON.stringify(before));",
							"pm.collectionVariables.set('settingsOn', JSON.stringify(Object.assign({}, before, { entityRecognitionEnabled: true, entityRecognitionMethod: 'regex', entityPatternSets: ['nl'] })));",
							"pm.collectionVariables.set('settingsUnknownSet', JSON.stringify(Object.assign({}, before, { entityRecognitionEnabled: true, entityRecognitionMethod: 'regex', entityPatternSets: ['xx'] })));",
							"pm.collectionVariables.set('settingsWithoutSets', JSON.stringify(Object.assign({}, before, { entityRecognitionEnabled: true, entityRecognitionMethod: 'regex', entityPatternSets: [] })));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
