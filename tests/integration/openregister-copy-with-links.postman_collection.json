							"pm.test('the copy is created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(201));",
							"const b = pm.response.json();",
							"const uuid = String((b.object['@self'] && b.object['@self'].id) || b.object.id);",
							"pm.collectionVariables.set('copyUuid', uuid);",
							"pm.test('the copy has its own uuid', () => pm.expect(uuid).to.not.eql(pm.collectionVariables.get('sourceUuid')));",
							"pm.test('the override is applied', () => pm.expect(b.object.naam).to.eql('Zaaksysteem B'));",
							"pm.test('both relation rows are reported copied', () => pm.expect(b.links.relationRows.map(l => [l.title, l.outcome]).sort()).to.eql([['Contract', 'copied'], ['Handleiding', 'copied']]));",
							"pm.test('the suite is reported copied', () => pm.expect(b.links.incoming.map(l => [l.id, l.outcome])).to.eql([[pm.collectionVariables.get('suiteUuid'), 'copied']]));",
							"pm.test('no file was asked for, so none is reported', () => pm.expect(b.links.files).to.eql([]));"
						]
					}
