				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
							"pm.collectionVariables.set('suffix', suffix);",
							"pm.collectionVariables.set('groupId', 'or-mandate-' + suffix);",
							"['holder', 'nonHolder', 'absent', 'absentToo'].forEach(w => pm.collectionVariables.set(w + 'Id', 'or-' + w.toLowerCase() + '-' + suffix));",
							"pm.collectionVariables.set('userPassword', 'Md!' + suffix + '-' + Math.random().toString(36).slice(2) + 'Zq9');",
							"const day = (offset) => new Date(Date.now() + offset * 24 * 3600 * 1000).toISOString().slice(0, 10);",
							"pm.collectionVariables.set('firstDay', day(-1));",
							"pm.collectionVariables.set('lastDay', day(3));"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the group is created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
