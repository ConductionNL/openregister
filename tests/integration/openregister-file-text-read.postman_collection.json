					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the PDF is stored', () => pm.expect(pm.response.code, pm.response.text()).to.be.within(200, 299));",
							"// The WebDAV answer names the new file's id, a number followed by the instance id.",
							"const header = pm.response.headers.get('OC-FileId') || '';",
							"pm.test('the answer names the file id', () => pm.expect(header).to.match(/^\\d+/));",
							"pm.collectionVariables.set('fileId', String(parseInt(header, 10)));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
