			"name": "00 setup",
			"item": [
				{
					"name": "Create non-admin user",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
									"const b = pm.response.json();",
									"pm.test('OCS accepted the user', () => pm.expect(b.ocs.meta.statuscode).to.be.oneOf([100,200]));",
									"pm.test('OCS answers the new user id', () => pm.expect(b.ocs.data.id).to.equal(pm.collectionVariables.get('userId')));"
								]
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (!pm.collectionVariables.get('run')) { pm.collectionVariables.set('run', Math.random().toString(36).slice(2, 10)); }",
									"pm.collectionVariables.set('userId', 't23u' + pm.collectionVariables.get('run'));",
									"pm.collectionVariables.set('userPassword', 'T23-pw-' + pm.collectionVariables.get('run') + '-Xq9!vL');"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/ocs/v2.php/cloud/users?format=json",
						"body": {
							"mode": "raw",
							"raw": "{\n \"userid\": \"{{userId}}\",\n \"password\": \"{{userPassword}}\",\n \"displayName\": \"T23 reader {{run}}\"\n}"
						}
					}
				},
