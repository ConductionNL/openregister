{
	"info": {
		"name": "OpenRegister merge checks the caller's rights (lane T23 fix)",
		"description": "objects#merge: a caller who cannot read the objects gets 404, a caller who can read but not update/delete them gets 403, and in both cases both objects are unchanged; an admin may merge. Seeds its own data: `00 setup` creates a non-admin user, a register, an admin-only schema and a publicly readable schema with two objects each; `99 teardown` deletes them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.collectionVariables.get('run')) { pm.collectionVariables.set('run', Math.random().toString(36).slice(2, 10)); }"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		},
		{
			"key": "admin_user",
			"value": "admin"
		},
		{
			"key": "admin_password",
			"value": "admin"
		},
		{
			"key": "run",
			"value": ""
		}
	],
	"item": [
