  {
   "name": "the inbox rows carry subject.identifier",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/flow-tasks?_limit=200",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "flow-tasks"
     ],
     "query": [
      {
       "key": "_limit",
       "value": "200"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('answered', () => pm.response.to.have.status(200));",
       "const rows = pm.response.json().results || [];",
       "const caseRow = rows.find(r => r.uuid === pm.collectionVariables.get('taskUuid'));",
       "const bareRow = rows.find(r => r.uuid === pm.collectionVariables.get('bareTaskUuid'));",
       "pm.test('the case task row carries the case identifier', () => { pm.expect(caseRow, 'task not listed').to.be.an('object'); pm.expect(caseRow.subject.identifier).to.eql('ZAAK-' + pm.collectionVariables.get('run')); });",
       "pm.test('a subject without one carries null, not a guess', () => { pm.expect(bareRow, 'task not listed').to.be.an('object'); pm.expect(bareRow.subject.identifier).to.eql(null); });"
      ]
     }
    }
   ]
  },
