{
	"info": {
		"name": "OpenRegister — who may manage an object's followers",
		"description": "record-star-follow-and-unread-on-screen task 1.3: `GET /api/objects/{register}/{schema}/{id}?_extend=@self.can` as the owner and as an editor who may update but does not own the object; `can.manage` is true and false, and `PUT .../watchers/{userId}` agrees for both (200 and 403). Creates its own users, group, register, schema and object and deletes them. Requests send no cookies, so each request runs as the user its header names.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('stamp')) {",
					"    pm.collectionVariables.set('stamp', 'rsfu' + Date.now().toString(36));",
					"}",
					"var token = function (user, password) { return Buffer.from(user + ':' + password).toString('base64'); };",
					"var stamp = pm.collectionVariables.get('stamp');",
					"var userPassword = pm.collectionVariables.get('userPassword');",
					"pm.collectionVariables.set('authToken', token(pm.collectionVariables.get('username'), pm.collectionVariables.get('password')));",
					"pm.collectionVariables.set('ownerToken', token(stamp + '-owner', userPassword));",
					"pm.collectionVariables.set('editorToken', token(stamp + '-editor', userPassword));"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "username",
			"value": "admin"
		},
		{
			"key": "password",
			"value": "admin"
		},
		{
			"key": "userPassword",
			"value": "Rsfu-User-Pass-2026"
		},
		{
			"key": "stamp",
			"value": ""
		},
		{
			"key": "authToken",
			"value": ""
		},
		{
			"key": "ownerToken",
			"value": ""
		},
		{
			"key": "editorToken",
			"value": ""
		},
		{
			"key": "register",
			"value": ""
		},
		{
			"key": "schema",
			"value": ""
		},
		{
			"key": "object",
			"value": ""
		}
	],
