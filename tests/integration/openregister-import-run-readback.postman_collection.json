					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the rows are read', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));",
							"const rows = pm.response.json().results; const byRow = Object.fromEntries(rows.map(r => [r.row, r]));",
							"pm.test('all three rows are there', () => pm.expect(rows.length).to.eql(3));",
							"pm.test('the good row was written and names the object it created', () => { pm.expect(byRow[2].outcome).to.eql('written'); pm.expect(byRow[2].targetUuid).to.be.a('string').and.not.empty; pm.collectionVariables.set('createdUuid', byRow[2].targetUuid); });",
							"pm.test('the row without a name is refused, saying the name is missing', () => { pm.expect(byRow[3].decision).to.eql('refuse'); pm.expect(byRow[3].reason).to.include('required property (name)'); pm.expect(byRow[3].outcome).to.eql(null); });",
							"pm.test('the row with a text count is refused, naming count', () => { pm.expect(byRow[4].decision).to.eql('refuse'); pm.expect(byRow[4].reason).to.include(\"'count'\"); });",
							"pm.test('a failing row keeps the row as it was submitted', () => pm.expect(byRow[4].source).to.eql({ name: 'gamma', count: 'three' }));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
