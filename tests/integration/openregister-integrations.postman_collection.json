  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Derive baseUrl from the standard `base_url` env-var so the collection",
          "// targets whatever server CI/newman points at (default http://localhost:8080).",
          "const injected = pm.variables.get('base_url');",
          "if (injected) {",
          "    pm.collectionVariables.set('baseUrl', injected.replace(/\\/$/, '') + '/index.php/apps/openregister');",
          "}",
          "// Honour the standard admin_user / admin_password env-vars used by CI.",
          "const injectedUser = pm.variables.get('admin_user');",
          "if (injectedUser) { pm.collectionVariables.set('username', injectedUser); }",
          "const injectedPass = pm.variables.get('admin_password');",
          "if (injectedPass) { pm.collectionVariables.set('password', injectedPass); }",
          "// Set auth headers for every request",
          "const user = pm.collectionVariables.get('username') || 'admin';",
          "const pass = pm.collectionVariables.get('password') || 'admin';",
          "pm.request.headers.add({",
          "    key: 'OCS-APIRequest',",
          "    value: 'true'",
          "});",
          "pm.request.headers.add({",
          "    key: 'Accept',",
          "    value: 'application/json'",
          "});",
          "pm.request.headers.add({",
          "    key: 'Content-Type',",
          "    value: 'application/json'",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/index.php/apps/openregister",
      "type": "string"
    },
