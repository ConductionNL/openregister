					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\"userid\": \"{{readerId}}\", \"password\": \"{{readerPassword}}\"}"
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
							"pm.collectionVariables.set('suffix', suffix);",
							"pm.collectionVariables.set('readerId', 'or-msg-reader-' + suffix);",
							"pm.collectionVariables.set('readerPassword', 'Ms!' + suffix + '-' + Math.random().toString(36).slice(2) + 'Zq9');",
							"// Two days ahead: the sweep never picks these up while the collection runs.",
							"pm.collectionVariables.set('sendAt', new Date(Date.now() + 2 * 24 * 3600 * 1000).toISOString().replace(/\\.\\d{3}Z$/, 'Z'));"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the reader is created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
