					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the message is scheduled', () => pm.expect(pm.response.code, pm.response.text()).to.eql(202));",
							"const o = pm.response.json();",
							"pm.test('pending, on the e-mail channel, at the asked moment', () => { pm.expect(o.state).to.eql('pending'); pm.expect(o.channel).to.eql('email'); pm.expect(Date.parse(o.sendAt)).to.eql(Date.parse(pm.collectionVariables.get('sendAt'))); });",
							"pm.test('with a minted Message-ID', () => pm.expect(o.messageId).to.match(/^<[^@>]+@[^>]+>$/));",
							"pm.collectionVariables.set('adminMessageId', String(o.id));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
