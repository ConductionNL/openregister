					"mode": "raw",
					"raw": "{\"to\": \"burger@example.test\", \"subject\": \"Herinnering\", \"text\": \"Uw afspraak is overmorgen.\", \"sendAt\": \"{{sendAt}}\", \"object\": {\"register\": \"{{registerId}}\", \"schema\": \"{{schemaId}}\", \"id\": \"{{objectId}}\"}}"
				}
