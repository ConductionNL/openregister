        {
          "name": "the open transition delivered a notification",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ocs/v2.php/apps/notifications/api/v2/notifications?format=json"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get('notificationTries') || 0) > 0) {",
                  "    setTimeout(() => {}, 2000);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Notifications are dispatched by a background job, so this polls for a while.",
                  "const tries = Number(pm.collectionVariables.get('notificationTries') || 0) + 1;",
                  "pm.collectionVariables.set('notificationTries', tries);",
                  "const title = 'first ' + pm.collectionVariables.get('stamp');",
                  "const found = pm.response.code === 200 && pm.response.json().ocs.data.some((n) => n.app === 'openregister' && n.subject.includes(title));",
                  "if (!found && tries < 30) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.test('the transition rule notified the named user', () => pm.expect(found, 'no openregister notification naming ' + title + ' after ' + tries + ' tries').to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "close (open to closed)",
