{
  "info": {
    "_postman_id": "openregister-platform-annotations",
    "name": "OpenRegister - Platform Annotations + Integration Providers",
    "description": "End-to-end tests for the four declarative schema annotations (lifecycle, aggregations, calculations, notifications) and the integration provider routes (contacts/match, flows, emails/by-sender, references).\n\nThe collection seeds its own register and one schema that declares all four annotations, so it runs on a fresh instance and needs no other app's schemas. Guards and listeners that an app adds to a lifecycle are that app's to test.\n\nThe notification check needs the notifications app and a background worker for `AnnotationNotificationDispatchJob`; tests/integration/ci/seed.sh provides both in CI.\n\nEverything it creates is removed in `99 teardown`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });",
          "// The quality workflow passes base_url, admin_user and admin_password; take",
          "// them for this collection's own names when those are not given.",
          "[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password'], ['adminUser', 'admin_user'], ['adminPassword', 'admin_password']].forEach(function (pair) {",
          "    var given = pm.environment.get(pair[1]);",
          "    if (given !== undefined && pm.environment.get(pair[0]) === undefined) {",
          "        pm.collectionVariables.set(pair[0], given);",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 setup",
      "item": [
        {
          "name": "create the register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              }
            ],
            "url": "{{baseUrl}}/index.php/apps/openregister/api/registers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"pa-register-{{stamp}}\",\n  \"title\": \"Platform annotations {{stamp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('stamp', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(201));",
                  "pm.collectionVariables.set('registerId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "create the annotated schema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              }
            ],
            "url": "{{baseUrl}}/index.php/apps/openregister/api/schemas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"pa-item-{{stamp}}\",\n  \"title\": \"Platform annotations item {{stamp}}\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"hours\": {\n      \"type\": \"integer\"\n    },\n    \"doubleHours\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"x-openregister-lifecycle\": {\n    \"field\": \"status\",\n    \"initial\": \"draft\",\n    \"states\": [\n      \"draft\",\n      \"scheduled\",\n      \"open\",\n      \"closed\"\n    ],\n    \"terminal\": [\n      \"closed\"\n    ],\n    \"transitions\": {\n      \"schedule\": {\n        \"from\": [\n          \"draft\"\n        ],\n        \"to\": \"scheduled\"\n      },\n      \"open\": {\n        \"from\": [\n          \"scheduled\"\n        ],\n        \"to\": \"open\"\n      },\n      \"close\": {\n        \"from\": [\n          \"open\"\n        ],\n        \"to\": \"closed\"\n      },\n      \"withdraw\": {\n        \"from\": [\n          \"draft\",\n          \"scheduled\"\n        ],\n        \"to\": \"closed\"\n      }\n    }\n  },\n  \"x-openregister-aggregations\": {\n    \"total\": {\n      \"metric\": \"count\"\n    },\n    \"byStatus\": {\n      \"metric\": \"count\",\n      \"groupBy\": {\n        \"field\": \"status\"\n      }\n    },\n    \"avgHours\": {\n      \"metric\": \"avg\",\n      \"field\": \"hours\"\n    },\n    \"openCount\": {\n      \"metric\": \"count\",\n      \"filter\": {\n        \"status\": \"open\"\n      }\n    }\n  },\n  \"x-openregister-calculations\": {\n    \"doubleHours\": {\n      \"type\": \"integer\",\n      \"materialise\": true,\n      \"expression\": {\n        \"*\": [\n          {\n            \"prop\": \"hours\"\n          },\n          2\n        ]\n      }\n    }\n  },\n  \"x-openregister-notifications\": {\n    \"opened\": {\n      \"trigger\": {\n        \"type\": \"transition\",\n        \"action\": \"open\"\n      },\n      \"enabled\": true,\n      \"channels\": [\n        \"nc-notification\"\n      ],\n      \"recipients\": [\n        {\n          \"kind\": \"users\",\n          \"users\": [\n            \"{{username}}\"\n          ]\n        }\n      ],\n      \"subject\": {\n        \"en\": \"Opened: {{title}}\",\n        \"nl\": \"Geopend: {{title}}\"\n      }\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('schema created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(201));",
                  "pm.collectionVariables.set('schemaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "attach the schema",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              }
            ],
            "url": "{{baseUrl}}/index.php/apps/openregister/api/registers/{{registerId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"schemas\": [{{schemaId}}]}"
            }
