                "type": "text/javascript",
                "exec": [
                  "pm.test('200 JSON-RPC initialize result with Mcp-Session-Id header', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.jsonrpc).to.eql('2.0');",
                  "    pm.expect(j.id).to.eql(1);",
                  "    pm.expect(j).to.not.have.property('error');",
                  "    pm.expect(j.result.protocolVersion).to.be.a('string').and.not.empty;",
                  "    pm.expect(j.result.serverInfo.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(j.result.capabilities).to.have.property('tools');",
                  "    var sid = pm.response.headers.get('Mcp-Session-Id');",
                  "    pm.expect(sid).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('t31_mcp_session', sid);",
                  "});"
                ]
              }
            }
