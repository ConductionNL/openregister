					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', function () { pm.response.to.have.status(200); });",
							"var j = pm.response.json();",
							"var aldoria = pm.collectionVariables.get('aldoria');",
							"pm.test('the first page holds 10 characters', function () { pm.expect(j.results.length).to.equal(10); });",
							"pm.test('none of them is from Norheim', function () { j.results.forEach(function (o) { pm.expect(o.setting).to.not.equal(pm.collectionVariables.get('norheim')); }); });",
							"pm.test('each is from Aldoria or has no setting', function () { j.results.forEach(function (o) { pm.expect([aldoria, null, undefined, '']).to.include(o.setting); }); });",
							"pm.test('the total is 15 (12 Aldoria + 3 without a setting)', function () { pm.expect(Number(j.total)).to.equal(15); });"
						]
					}
				}
			]
		},
