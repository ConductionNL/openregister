							"pm.collectionVariables.set('aldoria', '0b6f2c34-0000-4000-8000-00000000a1d0');",
							"pm.collectionVariables.set('norheim', '0b6f2c34-0000-4000-8000-0000000004e1');",
							"pm.collectionVariables.set('seed_i', '0');"
