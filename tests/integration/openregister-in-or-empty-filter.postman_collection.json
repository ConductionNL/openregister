		{
			"name": "Seed: one character",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/inorempty-{{run}}/character-{{run}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"index.php",
						"apps",
						"openregister",
						"api",
						"objects",
						"inorempty-{{run}}",
						"character-{{run}}"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{{seed_body}}"
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 20 characters: 12 in Aldoria, 5 in Norheim, 3 with no setting (missing, null, empty string).",
							"var i = Number(pm.collectionVariables.get('seed_i') || 0);",
							"var body = { name: 'Character ' + i };",
							"if (i < 12) { body.setting = pm.collectionVariables.get('aldoria'); }",
							"else if (i < 17) { body.setting = pm.collectionVariables.get('norheim'); }",
							"else if (i === 18) { body.setting = null; }",
							"else if (i === 19) { body.setting = ''; }",
							"pm.variables.set('seed_body', JSON.stringify(body));"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('201 or 200', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
							"var i = Number(pm.collectionVariables.get('seed_i') || 0) + 1;",
							"pm.collectionVariables.set('seed_i', String(i));",
							"if (i < 20) { postman.setNextRequest('Seed: one character'); }"
						]
					}
				}
			]
		},
