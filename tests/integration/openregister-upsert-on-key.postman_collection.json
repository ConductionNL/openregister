              "pm.test('the same uuid', () => pm.expect(uid).to.eql(pm.collectionVariables.get('upsertUuid')));",
              "pm.test('the new omschrijving', () => pm.expect(b.omschrijving).to.eql('Kapvergunning Dorpsstraat'));"
            ]
          }
        }
      ]
