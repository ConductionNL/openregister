          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201, a new record', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); const uid = String((b['@self'] && b['@self'].id) || b.id || b.uuid);",
              "pm.collectionVariables.set('upsertUuid', uid);",
              "pm.test('the control is not stored as data', () => pm.expect(b._upsertOn).to.eql(undefined));"
            ]
          }
        }
      ]
