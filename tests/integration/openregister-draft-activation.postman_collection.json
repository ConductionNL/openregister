{
  "info": {
    "_postman_id": "or-draft-activation-2026-10-12",
    "name": "OpenRegister Draft Activation API",
    "description": "POST /api/objects/{register}/{schema}/{id}/activate, asserted over HTTP (change draft-owner-activation-and-lifetime, decision 216). A caller's side view, so the DELIVERED status of a refusal is what is checked.\n\nWHAT IT ASSERTS, each paired with its control:\n  * somebody else, an administrator included, is refused with a delivered 403, and the draft is still a draft afterwards\n  * a plain save that sets @self.status to active stays refused\n  * an incomplete draft is refused with 422 and one finding per property\n  * the owner's activation answers 200 with the same id and status active\n  * a second activation answers 409, an unknown id 404\n  * a schema keeps its draftLifetimeDays on save and on read\n  * the owner sees their own draft in a list by default, and _drafts=none leaves it out while the rest stays\n\nThe cleanup job is not asserted here: it runs from cron, and its path from appinfo/info.xml to the delete is covered by DraftExpiryJobTest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
