					"raw": "{\n \"nodes\": [\n  {\n   \"id\": \"start\",\n   \"type\": \"openregister.trigger-manual\",\n   \"config\": {},\n   \"position\": {\n    \"x\": 0,\n    \"y\": 0\n   }\n  },\n  {\n   \"id\": \"review\",\n   \"type\": \"openregister.user-task\",\n   \"config\": {\n    \"title\": \"Review {{suffix}}\",\n    \"assignee\": \"{{admin_user}}\",\n    \"outcomes\": \"approved, rejected\",\n    \"advance\": \"all\"\n   },\n   \"position\": {\n    \"x\": 0,\n    \"y\": 0\n   }\n  },\n  {\n   \"id\": \"end\",\n   \"type\": \"openregister.end\",\n   \"config\": {\n    \"message\": \"done\"\n   },\n   \"position\": {\n    \"x\": 0,\n    \"y\": 0\n   }\n  }\n ],\n \"edges\": [\n  {\n   \"id\": \"e0\",\n   \"from\": \"start\",\n   \"to\": \"review\"\n  },\n  {\n   \"id\": \"e1\",\n   \"from\": \"review\",\n   \"to\": \"end\"\n  }\n ],\n \"name\": \"Run migration {{suffix}}\",\n \"trigger\": \"manual\",\n \"enabled\": true\n}"
