 "item": [
  {
   "name": "setUp: a dossier schema dated from its closing date",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/schemas",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "schemas"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"title\": \"retention filter dossier {{run}}\", \"slug\": \"retentionfilter{{run}}\", \"properties\": {\"title\": {\"type\": \"string\"}, \"sluitdatum\": {\"type\": \"string\", \"format\": \"date\"}}, \"archive\": {\"enabled\": true, \"defaultNominatie\": \"vernietigen\", \"defaultBewaartermijn\": \"P1Y\", \"afleidingswijze\": \"ander_datumkenmerk\", \"sourceDateProperty\": \"sluitdatum\"}}"
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const run = Math.random().toString(36).slice(2, 10);",
       "pm.collectionVariables.set('run', run);",
       "const day = (offsetYears) => { const d = new Date(); d.setUTCFullYear(d.getUTCFullYear() + offsetYears); return d.toISOString().slice(0, 10); };",
       "pm.collectionVariables.set('today', day(0));",
       "pm.collectionVariables.set('closedLongAgo', day(-5));",
       "pm.collectionVariables.set('closedTwoYearsAgo', day(-2));",
       "pm.collectionVariables.set('closesLater', day(3));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the schema is created', () => pm.expect(pm.response.code, pm.response.text()).to.be.below(300));",
       "pm.collectionVariables.set('schemaId', String(pm.response.json().id));"
      ]
     }
    }
   ]
  },
