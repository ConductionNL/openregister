       "key": "@self[retention.archiefactiedatum][lt]",
       "value": "{{today}}"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the list answers', () => pm.response.to.have.status(200));",
       "const titles = (pm.response.json().results || []).map(r => r.title).sort();",
       "pm.test('exactly long ago, two years ago', () => pm.expect(titles).to.eql([\"long ago\", \"two years ago\"]));"
      ]
     }
    }
   ]
