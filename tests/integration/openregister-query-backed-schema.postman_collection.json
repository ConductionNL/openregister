							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('deleted', () => pm.expect(pm.response.code).to.be.below(300))"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Basic {{authToken}}"
							}
						],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/sources/{{source}}"
					}
				},
				{
					"name": "delete the reader",
					"protocolProfileBehavior": {
						"disableCookies": true
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('reader deleted', () => pm.expect(pm.response.json().ocs.meta.statuscode).to.eql(100))"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
