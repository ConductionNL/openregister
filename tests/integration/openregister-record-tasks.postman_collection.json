{
	"info": {
		"name": "OpenRegister — a record's tasks and what each caller may do",
		"description": "record-tasks-tab task 1.3: `GET /api/flow-tasks?objectUuid=` as the assignee and as the requester of one task on a record; each row's `can` lists exactly the verbs that caller may run, a verb missing from the list is refused (403) for both, and a listed verb runs (200). Creates its own users, register, schema and record and deletes them; tasks have no delete route, so the completed task stays. Requests send no cookies, so each runs as the user its header names.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('stamp')) {",
					"    pm.collectionVariables.set('stamp', 'rtab' + Date.now().toString(36));",
					"}",
					"var token = function (user, password) { return Buffer.from(user + ':' + password).toString('base64'); };",
					"var stamp = pm.collectionVariables.get('stamp');",
					"var userPassword = pm.collectionVariables.get('userPassword');",
					"pm.collectionVariables.set('authToken', token(pm.collectionVariables.get('username'), pm.collectionVariables.get('password')));",
					"pm.collectionVariables.set('requesterToken', token(stamp + '-requester', userPassword));",
					"pm.collectionVariables.set('assigneeToken', token(stamp + '-assignee', userPassword));"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "username",
			"value": "admin"
		},
		{
			"key": "password",
			"value": "admin"
		},
		{
			"key": "userPassword",
