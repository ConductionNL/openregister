     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the save refuses with 422', () => pm.response.to.have.status(422));",
       "pm.test('the 422 names wijk with the message validate gave', () => {",
       "  const b = pm.response.json();",
       "  pm.expect(b.errors, JSON.stringify(b)).to.have.property('wijk');",
       "  pm.expect(b.errors.wijk).to.eql(pm.collectionVariables.get('validateMessage'));",
       "});"
      ]
     }
    }
   ]
