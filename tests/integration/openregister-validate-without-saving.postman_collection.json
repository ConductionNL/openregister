      "apps",
      "openregister",
      "api",
      "objects",
      "vocabulary",
      "conceptScheme"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"uri\": \"{{schemeUri}}\", \"title\": \"validate newman wijken {{run}}\", \"publisher\": \"newman\", \"version\": \"1.0.0\", \"source\": \"{{schemeUri}}\"}"
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const run = Math.random().toString(36).slice(2, 10);",
       "pm.collectionVariables.set('run', run);",
       "pm.collectionVariables.set('schemeUri', 'urn:newman:' + run + ':wijken');",
       "pm.collectionVariables.set('conceptUri', 'urn:newman:' + run + ':centrum');"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the scheme is created', () => pm.expect(pm.response.code, pm.response.text()).to.be.below(300));",
       "const b = pm.response.json(); pm.collectionVariables.set('schemeId', String(b.id || b['@self'].id));"
      ]
     }
    }
   ]
