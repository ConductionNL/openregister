  {
   "name": "validate a sample whose wijk is not a concept of the scheme",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{registerId}}/{{schemaId}}/validate",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "objects",
      "{{registerId}}",
      "{{schemaId}}",
      "validate"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"wijk\": \"urn:newman:atlantis\"}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('a verdict, not a refusal', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "const error = (b.errors || []).find(e => e.property === 'wijk');",
       "pm.test('invalid on wijk, by the coded-value rule', () => {",
       "  pm.expect(b.valid).to.eql(false);",
       "  pm.expect(error, JSON.stringify(b)).to.be.an('object');",
       "  pm.expect(error.rule).to.eql('coded-value');",
       "});",
       "pm.collectionVariables.set('validateMessage', error ? error.message : '');"
      ]
     }
    }
   ]
  },
