						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{residualFixtureFileId}}/manual-entities",
						"body": {
							"mode": "raw",
							"raw": "{\"value\": \"Jan Jansen\", \"type\": \"PERSON\"}"
