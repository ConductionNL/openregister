{
	"info": {
		"_postman_id": "openregister-anonymisation-tests",
		"name": "OpenRegister - PDF / Office Anonymisation Tests",
		"description": "Integration tests for the file-anonymise REST surface (`POST /api/files/{fileId}/anonymize`) of the `pdf-anonymisation` spec.\n\nThe collection brings its own fixtures, so it runs on a fresh instance: three synthetic one-page PDFs (no real person, no real document) are carried as collection variables in plain ASCII, uploaded over WebDAV, extracted, and given the operator-marked name `Jan Jansen` through `/manual-entities`. No external detector (Presidio, OpenAnonymiser, an LLM) is needed.\n\n1. Happy path: a Flate-compressed content stream is anonymised completely, and the re-extracted copy no longer holds the name.\n2. Encrypted PDF: a file whose text was extracted and that was then replaced by an encrypted version answers 422 with reason `encrypted_pdf`.\n3. Residual: an unfiltered content stream the byte replacer does not rewrite is answered 200 with `complete: false` and the residual listed, never as a complete anonymisation.\n\nEvery file is removed in `99 teardown`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{username}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{password}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });",
					"// The quality workflow passes base_url, admin_user and admin_password; take",
					"// them for this collection's own names when those are not given.",
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password'], ['adminUser', 'admin_user'], ['adminPassword', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && pm.environment.get(pair[0]) === undefined) {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('runId')) {",
					"    var runId = String(Date.now());",
					"    pm.collectionVariables.set('runId', runId);",
					"    pm.collectionVariables.set('plainName', 'anonymisation-' + runId + '-plain.pdf');",
					"    pm.collectionVariables.set('plainAnonymizedName', 'anonymisation-' + runId + '-plain_anonymized.pdf');",
					"    pm.collectionVariables.set('encryptedName', 'anonymisation-' + runId + '-encrypted.pdf');",
					"    pm.collectionVariables.set('residualName', 'anonymisation-' + runId + '-residual.pdf');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "00 setup",
			"item": [
				{
					"name": "upload the plain PDF",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/pdf"
							}
						],
						"url": "{{baseUrl}}/remote.php/dav/files/{{username}}/{{plainName}}",
						"body": {
							"mode": "raw",
							"raw": "{{pdfPlain}}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the upload is stored', () => pm.expect(pm.response.code, pm.response.text()).to.be.oneOf([201, 204]));"
								]
							}
						}
					]
				},
				{
					"name": "read the plain file id",
					"request": {
						"method": "PROPFIND",
						"header": [
							{
								"key": "Depth",
								"value": "0"
							},
							{
								"key": "Content-Type",
								"value": "application/xml"
							}
						],
						"url": "{{baseUrl}}/remote.php/dav/files/{{username}}/{{plainName}}",
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\"?><d:propfind xmlns:d=\"DAV:\" xmlns:oc=\"http://owncloud.org/ns\"><d:prop><oc:fileid/></d:prop></d:propfind>"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const m = pm.response.text().match(/<oc:fileid>(\\d+)<\\/oc:fileid>/);",
									"pm.test('the file id is readable', () => pm.expect(m, pm.response.text()).to.not.eql(null));",
									"if (m) { pm.collectionVariables.set('fixtureFileId', m[1]); }"
								]
							}
						}
					]
				},
				{
					"name": "extract the plain text",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{fixtureFileId}}/extract"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('extraction succeeds', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().success, pm.response.text()).to.eql(true);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "mark the name in the plain file",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{fixtureFileId}}/manual-entities",
						"body": {
							"mode": "raw",
							"raw": "{\"value\": \"Jan Jansen\", \"type\": \"PERSON\"}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the name is found once in the extracted text', () => {",
									"    pm.response.to.have.status(201);",
									"    pm.expect(pm.response.json().matchCount, pm.response.text()).to.eql(1);",
									"});"
								]
							}
						}
					]
				},
				{
