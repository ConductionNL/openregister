		{
			"name": "1 happy path",
			"item": [
				{
					"name": "anonymise the plain PDF",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{fixtureFileId}}/anonymize"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('anonymisation answers 200 and is complete', () => {",
									"    pm.response.to.have.status(200);",
									"    const j = pm.response.json();",
									"    pm.expect(j.complete, pm.response.text()).to.eql(true);",
									"    pm.expect(j.residual_count).to.eql(0);",
									"    pm.expect(j.entities_replaced).to.eql(1);",
									"});",
									"pm.test('the response carries the anonymised file id', () => {",
									"    const j = pm.response.json();",
									"    pm.expect(j.anonymized_file_id).to.be.a('number');",
									"    pm.expect(j.anonymized_file_id).to.not.eql(Number(pm.collectionVariables.get('fixtureFileId')));",
									"    pm.collectionVariables.set('anonymizedFileId', j.anonymized_file_id);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "extract the anonymised copy",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{anonymizedFileId}}/extract"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the anonymised copy is readable', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "the name is gone from the anonymised copy",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{anonymizedFileId}}/text"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the text no longer holds the name', () => {",
									"    pm.response.to.have.status(200);",
									"    const t = pm.response.json().text;",
									"    pm.expect(t).to.be.a('string');",
									"    pm.expect(t).to.not.include('Jan Jansen');",
									"    pm.expect(t).to.not.include('Jansen');",
									"    pm.expect(t).to.include('Zuiddrecht');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "a second anonymisation of the copy is refused",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{anonymizedFileId}}/anonymize"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('an anonymised file is not anonymised again', () => {",
									"    pm.response.to.have.status(400);",
									"    pm.expect(pm.response.json().message).to.include('already anonymized');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "2 encrypted PDF",
			"item": [
				{
					"name": "replace the file with an encrypted version",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/pdf"
							}
						],
						"url": "{{baseUrl}}/remote.php/dav/files/{{username}}/{{encryptedName}}",
						"body": {
							"mode": "raw",
							"raw": "{{pdfEncrypted}}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the encrypted version replaces the file', () => pm.expect(pm.response.code, pm.response.text()).to.be.oneOf([201, 204]));"
								]
							}
						}
					]
				},
				{
					"name": "anonymising an encrypted PDF answers 422",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{encryptedFixtureFileId}}/anonymize"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('encrypted PDF returns 422 (caller-correctable)', () => pm.response.to.have.status(422));",
									"pm.test('the body names reason encrypted_pdf', () => pm.expect(pm.response.json()).to.have.property('reason', 'encrypted_pdf'));",
									"pm.test('the body does not echo the entity text', () => pm.expect(pm.response.text()).to.not.include('Jan Jansen'));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "3 residual entity text",
			"item": [
				{
					"name": "a stream the replacer cannot rewrite is reported, not claimed",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{residualFixtureFileId}}/anonymize"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('the partial result answers 200 and says it is not complete', () => {",
									"    pm.response.to.have.status(200);",
									"    const j = pm.response.json();",
									"    pm.expect(j.complete, pm.response.text()).to.eql(false);",
									"    pm.expect(j.residual_count).to.eql(1);",
									"    pm.expect(j.residual_entities.map((e) => e.text)).to.include('Jan Jansen');",
									"    pm.collectionVariables.set('residualAnonymizedName', String(j.anonymized_path).split('/').pop());",
									"});"
								]
							}
						}
					]
				}
			]
		},
