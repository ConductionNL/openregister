								"exec": [
									"const m = pm.response.text().match(/<oc:fileid>(\\d+)<\\/oc:fileid>/);",
									"pm.test('the file id is readable', () => pm.expect(m, pm.response.text()).to.not.eql(null));",
									"if (m) { pm.collectionVariables.set('residualFixtureFileId', m[1]); }"
								]
							}
						}
					]
				},
				{
					"name": "extract the residual text",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/{{residualFixtureFileId}}/extract"
					},
					"event": [
