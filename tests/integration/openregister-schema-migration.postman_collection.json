{
    "info": {
        "name": "OpenRegister Schema Migration Integration Test",
        "description": "schema-versioning-and-object-migration: changelog read, breaking-change 409 gate + acknowledged update, migration preview/validation, revalidation run lifecycle.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "basic",
        "basic": [
            {
                "key": "username",
                "value": "{{admin_user}}",
                "type": "string"
            },
            {
                "key": "password",
                "value": "{{admin_password}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost",
            "type": "string"
        },
        {
            "key": "admin_user",
            "value": "admin",
            "type": "string"
        },
        {
            "key": "admin_password",
            "value": "admin",
            "type": "string"
        },
        {
            "key": "register_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "schema_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "run_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Setup: Create register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/registers",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "registers"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"title\": \"SV Test Register\", \"description\": \"schema-versioning newman\"}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('register created', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                            "var j = pm.response.json();",
                            "if (j && j.id) { pm.collectionVariables.set('register_id', j.id); }"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Setup: Create schema v1",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"title\": \"SV Person\", \"version\": \"1.0.0\", \"properties\": {\"fullname\": {\"type\": \"string\"}, \"age\": {\"type\": \"string\"}}, \"required\": []}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('schema created', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                            "var j = pm.response.json();",
                            "if (j && j.id) { pm.collectionVariables.set('schema_id', j.id); }"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Compatible update (add optional) succeeds without ack",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"properties\": {\"fullname\": {\"type\": \"string\"}, \"age\": {\"type\": \"string\"}, \"nickname\": {\"type\": \"string\"}}, \"required\": []}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('compatible change accepted', function(){ pm.expect(pm.response.code).to.be.oneOf([200]); });",
                            "var j = pm.response.json();",
                            "pm.test('minor version bump to 1.1.0', function(){ pm.expect(j.version).to.eql('1.1.0'); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Changelog lists the compatible change newest-first",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}/changelog",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}",
                        "changelog"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('changelog 200', function(){ pm.expect(pm.response.code).to.eql(200); });",
                            "var j = pm.response.json();",
                            "pm.test('has results', function(){ pm.expect(j.results.length).to.be.above(0); });",
                            "pm.test('newest entry is compatible', function(){ pm.expect(j.results[0].classification).to.eql('compatible'); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Breaking update (remove property) refused 409 without ack",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"properties\": {\"fullname\": {\"type\": \"string\"}, \"nickname\": {\"type\": \"string\"}}, \"required\": []}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('refused with 409', function(){ pm.expect(pm.response.code).to.eql(409); });",
                            "var j = pm.response.json();",
                            "pm.test('classification breaking', function(){ pm.expect(j.classification).to.eql('breaking'); });",
                            "pm.test('changes present', function(){ pm.expect(j.changes.length).to.be.above(0); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Breaking update accepted with acknowledgeBreaking",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"acknowledgeBreaking\": true, \"properties\": {\"fullname\": {\"type\": \"string\"}, \"nickname\": {\"type\": \"string\"}}, \"required\": []}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('accepted', function(){ pm.expect(pm.response.code).to.eql(200); });",
                            "var j = pm.response.json();",
                            "pm.test('major version bump to 2.0.0', function(){ pm.expect(j.version).to.eql('2.0.0'); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Migration preview returns before/after without persisting",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}/migrations/preview",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}",
                        "migrations",
                        "preview"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"registerId\": \"{{register_id}}\", \"plan\": [{\"op\": \"rename\", \"from\": \"fullname\", \"to\": \"name\"}]}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('preview 200 or 422-no-register', function(){ pm.expect(pm.response.code).to.be.oneOf([200,422]); });",
                            "if (pm.response.code === 200) {",
                            "  var j = pm.response.json();",
                            "  pm.test('results array', function(){ pm.expect(j.results).to.be.an('array'); });",
                            "}"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Invalid migration plan refused 422",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}/migrations/preview",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}",
                        "migrations",
                        "preview"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"registerId\": \"{{register_id}}\", \"plan\": [{\"op\": \"frobnicate\"}]}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('refused 422', function(){ pm.expect(pm.response.code).to.eql(422); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Revalidation run starts (or 422 when no register)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}/revalidate",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}",
                        "revalidate"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"registerId\": \"{{register_id}}\"}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('started 201 or 422', function(){ pm.expect(pm.response.code).to.be.oneOf([201,422]); });",
                            "if (pm.response.code === 201) {",
                            "  var j = pm.response.json();",
                            "  if (j && j.id) { pm.collectionVariables.set('run_id', j.id); }",
                            "  pm.test('run type revalidation', function(){ pm.expect(j.type).to.eql('revalidation'); });",
                            "}"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Runs list returns runs for the schema",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}/runs",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}",
                        "runs"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('runs 200', function(){ pm.expect(pm.response.code).to.eql(200); });",
                            "var j = pm.response.json();",
                            "pm.test('results array', function(){ pm.expect(j.results).to.be.an('array'); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Teardown: delete schema",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{schema_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "schemas",
                        "{{schema_id}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('deleted or gone', function(){ pm.expect(pm.response.code).to.be.oneOf([200,204,404]); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Teardown: delete register",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/index.php/apps/openregister/api/registers/{{register_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "index.php",
                        "apps",
                        "openregister",
                        "api",
                        "registers",
                        "{{register_id}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('deleted or gone', function(){ pm.expect(pm.response.code).to.be.oneOf([200,204,404]); });"
                        ]
                    }
                }
            ]
        }
    ]
}