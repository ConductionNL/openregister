      },
      {
       "key": "notification",
       "value": "commented"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('answered', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('not forced, decided by another layer', () => {",
       "  pm.expect(b.forced).to.eql(false);",
       "  pm.expect(b.layer).to.not.eql('administrator-forced');",
       "});"
      ]
     }
    }
   ]
  },
