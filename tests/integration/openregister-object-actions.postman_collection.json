							"mode": "raw",
							"raw": "{\n  \"slug\": \"{{stamp}}-besluit\",\n  \"title\": \"{{stamp}} besluit\",\n  \"properties\": {\n    \"titel\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"open\",\n        \"decided\",\n        \"closed\"\n      ]\n    },\n    \"publicatiedatum\": {\n      \"type\": \"string\"\n    },\n    \"reden\": {\n      \"type\": \"string\"\n    }\n  },\n  \"configuration\": {\n    \"x-openregister-action\": {\n      \"publish\": {\n        \"name\": \"Publish\",\n        \"description\": \"Make the decision public from a date.\",\n        \"label\": {\n          \"nl\": \"Publiceren\",\n          \"en\": \"Publish\"\n        },\n        \"surfaces\": [\n          \"header\",\n          \"row\",\n          \"bulk\"\n        ],\n        \"inputs\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"from\"\n          ],\n          \"properties\": {\n            \"from\": {\n              \"type\": \"string\",\n              \"format\": \"date\",\n              \"title\": \"Public from\"\n            }\n          }\n        },\n        \"when\": {\n          \"==\": [\n            {\n              \"var\": \"object.status\"\n            },\n            \"decided\"\n          ]\n        },\n        \"whenMessage\": {\n          \"en\": \"Only a decided decision can be published.\",\n          \"nl\": \"Alleen een vastgesteld besluit kan worden gepubliceerd.\"\n        },\n        \"steps\": [\n          {\n            \"id\": \"date\",\n            \"type\": \"openregister.object-write\",\n            \"config\": {\n              \"register\": {{register}},\n              \"schema\": \"{{stamp}}-besluit\",\n              \"operation\": \"update\",\n              \"match\": [\n                {\n                  \"property\": \"titel\",\n                  \"value\": \"{{ titel }}\"\n                }\n              ],\n              \"fields\": {\n                \"publicatiedatum\": \"{{inputs.from}}\"\n              }\n            }\n          }\n        ]\n      },\n      \"close\": {\n        \"name\": \"Close\",\n        \"description\": \"Close the decision.\",\n        \"label\": \"Close\",\n        \"transition\": \"sluiten\"\n      }\n    }\n  },\n  \"x-openregister-lifecycle\": {\n    \"field\": \"status\",\n    \"initial\": \"open\",\n    \"transitions\": {\n      \"besluiten\": {\n        \"from\": [\n          \"open\"\n        ],\n        \"to\": \"decided\"\n      },\n      \"sluiten\": {\n        \"from\": [\n          \"decided\"\n        ],\n        \"to\": \"closed\",\n        \"inputs\": [\n          {\n            \"field\": \"reden\",\n            \"required\": true\n          }\n        ]\n      }\n    }\n  },\n  \"authorization\": {\n    \"read\": [\n      \"authenticated\"\n    ],\n    \"create\": [\n      \"admin\"\n    ],\n    \"update\": [\n      \"admin\"\n    ],\n    \"delete\": [\n      \"admin\"\n    ],\n    \"publish\": [\n      \"admin\"\n    ],\n    \"close\": [\n      \"admin\"\n    ]\n  }\n}"
						}
