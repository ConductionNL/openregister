		{
			"name": "01 — search",
			"item": [
				{
					"name": "one search finds the objects of both registers",
					"protocolProfileBehavior": {
						"disableCookies": true
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const found = pm.response.json().ocs.data",
									"const urls = found.entries.map(e => e.resourceUrl)",
									"const hit = (n) => urls.find(u => u.includes('/' + pm.collectionVariables.get(n + 'Register') + '/' + pm.collectionVariables.get(n + 'Schema') + '/' + pm.collectionVariables.get(n + 'Object')))",
									"pm.test('answers 200', () => pm.response.to.have.status(200))",
									"pm.test('exactly the two seeded objects', () => pm.expect(found.entries).to.have.length(2))",
									"pm.test('the pet store object is found', () => pm.expect(hit('pets')).to.not.eql(undefined))",
									"pm.test('the pipeline object is found', () => pm.expect(hit('leads')).to.not.eql(undefined))",
									"pm.test('each hit names its own register', () => {",
									"    pm.expect(found.entries.find(e => e.title.startsWith('pets')).subline).to.include(pm.collectionVariables.get('stamp') + ' pet store')",
									"    pm.expect(found.entries.find(e => e.title.startsWith('leads')).subline).to.include(pm.collectionVariables.get('stamp') + ' pipeline')",
									"})"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
