{
	"info": {
		"name": "OpenRegister — unified search across registers",
		"description": "unified-search-magic-table-storage task 3.5: two registers (a pet store and a pipeline), each with its own schema and one object carrying the same unique term; the OCS unified-search endpoint `/ocs/v2.php/search/providers/openregister_objects/search` answers both objects to the administrator, each naming its own register. Creates its own registers, schemas and objects and deletes them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('stamp')) {",
					"    var stamp = 'usx' + Date.now().toString(36);",
					"    pm.collectionVariables.set('stamp', stamp);",
					"    pm.collectionVariables.set('term', 'zyq' + stamp);",
					"}",
					"pm.collectionVariables.set('authToken', Buffer.from(pm.collectionVariables.get('username') + ':' + pm.collectionVariables.get('password')).toString('base64'));"
				]
			}
		}
	],
