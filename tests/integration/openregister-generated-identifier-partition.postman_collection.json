	"info": {
		"_postman_id": "openregister-generated-identifier-partition-v1",
		"name": "OpenRegister generated identifier per partition",
		"description": "# Generated identifier per partition\n\nopenspec/changes/generated-identifier-partition task 2.2: `x-openregister-generated` with `partitionBy: unit` numbers each unit from one in each period (`{year}-{seq:5}`, `resetOn: year`); an object without a unit draws from the unpartitioned counter; a supplied number advances only its own unit's counter; a dotted `partitionBy` is refused at schema save.\n\nThe sequence name is per run, so its counters start fresh in the current year: the same state as the first object of a new year. Creates its own register and removes it at the end.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost"
		},
		{
			"key": "admin_user",
			"value": "admin"
		},
		{
			"key": "admin_password",
			"value": "admin"
		},
