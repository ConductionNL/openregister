		{
			"name": "read the status -> part 2 missing, not complete",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the status is read', () => pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
							"const b = pm.response.json();",
							"pm.test('the plan is repeated', () => { pm.expect(b.uploadId).to.equal(pm.collectionVariables.get('uploadId')); pm.expect(b.partCount).to.equal(3); });",
							"pm.test('the declared file', () => { pm.expect(b.size).to.equal(26214400); pm.expect(b.sha256).to.equal('ab41e1f85fb5e3bf25284009df7faa90261b4a82f3b4532c8f14b1d3d59201ea'); });",
							"pm.test('parts 1 and 3 received', () => pm.expect(b.received).to.eql([1, 3]));",
							"pm.test('part 2 missing', () => pm.expect(b.missing).to.eql([2]));",
							"pm.test('not complete', () => pm.expect(b.complete).to.equal(false));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "OCS-APIRequest",
						"value": "true"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": "{{base_url}}/index.php/apps/openregister/api/objects/{{registerId}}/{{schemaId}}/{{objectId}}/uploads/{{uploadId}}"
			}
		},
		{
			"name": "send part 2 -> 200, complete",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// The file is 25 MiB of ASCII, generated rather than stored: MiB m is a 64-byte block naming m, repeated.",
							"// Any range of it can be rebuilt from the plan's {start, end}, so the parts follow the server's own plan.",
							"const MIB = 1048576;",
							"const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
							"const block = (m) => ('lfh-mib-' + String(m).padStart(2, '0') + '-' + ALPHA).slice(0, 64);",
							"const slice = (start, end) => { let out = ''; let i = start; while (i <= end) { const m = Math.floor(i / MIB); const stop = Math.min(end, (m + 1) * MIB - 1); const chunk = block(m).repeat(MIB / 64); out += chunk.slice(i - m * MIB, stop - m * MIB + 1); i = stop + 1; } return out; };",
							"const parts = JSON.parse(pm.collectionVariables.get('parts') || '[]');",
							"const range = parts.find((p) => p.n === 2);",
							"if (!range) { throw new Error('the plan has no part 2'); }",
							"pm.request.body.update({ mode: 'raw', raw: slice(range.start, range.end) });"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('part 2 is stored', () => pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
							"const b = pm.response.json();",
							"pm.test('received is [1, 2, 3]', () => pm.expect(b.received).to.eql([1, 2, 3]));",
							"pm.test('missing is []', () => pm.expect(b.missing).to.eql([]));",
							"pm.test('complete is true', () => pm.expect(b.complete).to.equal(true));"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "OCS-APIRequest",
						"value": "true"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/octet-stream"
					}
				],
				"url": "{{base_url}}/index.php/apps/openregister/api/objects/{{registerId}}/{{schemaId}}/{{objectId}}/uploads/{{uploadId}}/parts/2",
				"body": {
					"mode": "raw",
					"raw": ""
				}
			}
		},
