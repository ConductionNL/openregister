						"type": "text/javascript",
						"exec": [
							"pm.test('the file is created', () => pm.expect(pm.response.code, pm.response.text()).to.equal(201));",
							"const b = pm.response.json();",
							"pm.test('it has an id', () => pm.expect(b.id).to.not.equal(undefined));",
