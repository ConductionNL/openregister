		{
			"name": "open a session for a 25 MiB file -> 201 with three 10 MiB parts",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (!pm.collectionVariables.get('run')) { pm.collectionVariables.set('run', Math.random().toString(36).slice(2, 10)); }"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the session is opened', () => pm.expect(pm.response.code, pm.response.text()).to.equal(201));",
							"const b = pm.response.json();",
							"pm.test('an upload id', () => pm.expect(b.uploadId).to.match(/^[0-9a-f-]{36}$/));",
							"pm.test('10 MiB parts (the default part size)', () => pm.expect(b.partSize).to.equal(10485760));",
							"pm.test('three parts', () => pm.expect(b.partCount).to.equal(3));",
							"pm.test('the ranges cover the file end-inclusive', () => pm.expect(b.parts).to.eql([{n: 1, start: 0, end: 10485759}, {n: 2, start: 10485760, end: 20971519}, {n: 3, start: 20971520, end: 26214399}]));",
							"pm.test('an expiry', () => pm.expect(b.expiresAt).to.be.a('string'));",
							"pm.collectionVariables.set('uploadId', b.uploadId);",
							"pm.collectionVariables.set('parts', JSON.stringify(b.parts || []));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "OCS-APIRequest",
						"value": "true"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": "{{base_url}}/index.php/apps/openregister/api/objects/{{registerId}}/{{schemaId}}/{{objectId}}/uploads",
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"lfh-{{run}}.txt\", \"size\": 26214400, \"sha256\": \"ab41e1f85fb5e3bf25284009df7faa90261b4a82f3b4532c8f14b1d3d59201ea\"}"
				}
			}
		},
		{
			"name": "send part 1 -> 200, parts 2 and 3 missing",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// The file is 25 MiB of ASCII, generated rather than stored: MiB m is a 64-byte block naming m, repeated.",
							"// Any range of it can be rebuilt from the plan's {start, end}, so the parts follow the server's own plan.",
							"const MIB = 1048576;",
							"const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
							"const block = (m) => ('lfh-mib-' + String(m).padStart(2, '0') + '-' + ALPHA).slice(0, 64);",
							"const slice = (start, end) => { let out = ''; let i = start; while (i <= end) { const m = Math.floor(i / MIB); const stop = Math.min(end, (m + 1) * MIB - 1); const chunk = block(m).repeat(MIB / 64); out += chunk.slice(i - m * MIB, stop - m * MIB + 1); i = stop + 1; } return out; };",
							"const parts = JSON.parse(pm.collectionVariables.get('parts') || '[]');",
							"const range = parts.find((p) => p.n === 1);",
							"if (!range) { throw new Error('the plan has no part 1'); }",
							"pm.request.body.update({ mode: 'raw', raw: slice(range.start, range.end) });"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('part 1 is stored', () => pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
							"const b = pm.response.json();",
							"pm.test('received is [1]', () => pm.expect(b.received).to.eql([1]));",
							"pm.test('missing is [2, 3]', () => pm.expect(b.missing).to.eql([2, 3]));",
							"pm.test('complete is false', () => pm.expect(b.complete).to.equal(false));"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "OCS-APIRequest",
						"value": "true"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/octet-stream"
					}
				],
				"url": "{{base_url}}/index.php/apps/openregister/api/objects/{{registerId}}/{{schemaId}}/{{objectId}}/uploads/{{uploadId}}/parts/1",
				"body": {
					"mode": "raw",
					"raw": ""
				}
			}
		},
		{
			"name": "send part 3 -> 200, part 2 missing",
			"event": [
