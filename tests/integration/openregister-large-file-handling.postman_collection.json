						"type": "text/javascript",
						"exec": [
							"pm.test('part 3 is stored', () => pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
							"const b = pm.response.json();",
							"pm.test('received is [1, 3]', () => pm.expect(b.received).to.eql([1, 3]));",
							"pm.test('missing is [2]', () => pm.expect(b.missing).to.eql([2]));",
							"pm.test('complete is false', () => pm.expect(b.complete).to.equal(false));"
