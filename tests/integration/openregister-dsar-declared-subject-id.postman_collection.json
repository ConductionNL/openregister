 "item": [
  {
   "name": "setUp: a schema declaring learnerId as its subject id",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/schemas",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "schemas"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"title\": \"dsar declared id {{run}}\", \"slug\": \"dsardeclared{{run}}\", \"properties\": {\"cursus\": {\"type\": \"string\"}, \"learnerId\": {\"type\": \"string\"}}, \"configuration\": {\"x-openregister-processing\": {\"subjectIdFields\": {\"learnerId\": \"learnerId\"}}}}"
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.collectionVariables.set('run', Math.random().toString(36).slice(2, 10));",
       "pm.collectionVariables.set('learner', pm.variables.replaceIn('{{$guid}}'));",
       "pm.collectionVariables.set('otherLearner', pm.variables.replaceIn('{{$guid}}'));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the schema is created', () => pm.expect(pm.response.code, pm.response.text()).to.be.below(300));",
       "pm.collectionVariables.set('schemaId', String(pm.response.json().id));"
      ]
     }
    }
   ]
  },
