  {
   "name": "the access export for the learner",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/gdpr/access-export?subject={{learner}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "gdpr",
      "access-export"
     ],
     "query": [
      {
       "key": "subject",
       "value": "{{learner}}"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('answered', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "const ours = (b.objects || []).filter(o => o.object && o.object['@self'] && [pm.collectionVariables.get('uuid0'), pm.collectionVariables.get('uuid1'), pm.collectionVariables.get('uuid2')].includes(o.object['@self'].id));",
       "pm.test('exactly the two enrolments of this learner', () => pm.expect(ours.map(o => o.object.cursus).sort()).to.eql(['Biologie', 'Wiskunde']));",
       "pm.test('found only through the declared field', () => ours.forEach(o => {",
       "  pm.expect(o.subjectFields).to.deep.include({ type: 'learnerId', field: 'learnerId' });",
       "  pm.expect(o.gdprEntities || []).to.eql([]);",
       "}));"
      ]
     }
    }
   ]
  },
