						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{stamp}} watches value\",\n  \"description\": \"Starts only when value changes, and writes note back onto the lead.\",\n  \"enabled\": true,\n  \"executionMode\": \"sync\",\n  \"nodes\": [\n    {\n      \"id\": \"changed\",\n      \"type\": \"openregister.trigger-object\",\n      \"config\": {\n        \"event\": \"object.updated\",\n        \"register\": \"{{register}}\",\n        \"schema\": \"{{schema}}\",\n        \"changedFields\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"id\": \"categorise\",\n      \"type\": \"openregister.object-write\",\n      \"config\": {\n        \"register\": \"{{register}}\",\n        \"schema\": \"{{schema}}\",\n        \"operation\": \"update\",\n        \"match\": [\n          {\n            \"property\": \"title\",\n            \"value\": \"{{ title }}\"\n          }\n        ],\n        \"fields\": {\n          \"note\": \"categorised\"\n        }\n      }\n    },\n    {\n      \"id\": \"end\",\n      \"type\": \"openregister.end\",\n      \"config\": {}\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"a\",\n      \"from\": \"changed\",\n      \"to\": \"categorise\"\n    },\n    {\n      \"id\": \"b\",\n      \"from\": \"categorise\",\n      \"to\": \"end\"\n    }\n  ]\n}"
						}
