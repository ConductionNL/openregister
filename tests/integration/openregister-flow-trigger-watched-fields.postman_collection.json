{
	"info": {
		"name": "OpenRegister — flow trigger watched fields",
		"description": "flow-trigger-transitions-and-changed-fields task 3.2. An object.updated trigger with changedFields starts a run only when a watched field changes: an update of an unwatched field queues no run, an update of a watched field queues one. The run's context lists the changed field, and the flow's own write-back of an unwatched field starts no second run. Publishing a trigger that watches a field its schema lacks is refused. The flow runs sync, so no background worker is needed. Creates its own register, schema and flows and deletes them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });",
					"// The quality workflow passes base_url, admin_user and admin_password; take",
					"// them for this collection's own names when those are given.",
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"pm.collectionVariables.set('authToken', Buffer.from(pm.collectionVariables.get('username') + ':' + pm.collectionVariables.get('password')).toString('base64'));"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "username",
			"value": "admin"
