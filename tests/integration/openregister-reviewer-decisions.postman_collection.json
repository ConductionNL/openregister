				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Values unique to this run: extraction is keyed on the content, and entities are shared by value.",
							"const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
							"pm.collectionVariables.set('suffix', suffix);",
							"pm.collectionVariables.set('groupId', 'or-reviewers-' + suffix);",
							"pm.collectionVariables.set('firstId', 'or-reviewer-a-' + suffix);",
							"pm.collectionVariables.set('secondId', 'or-reviewer-b-' + suffix);",
							"pm.collectionVariables.set('reviewerPassword', 'Rv!' + suffix + '-' + Math.random().toString(36).slice(2) + 'Zq9');",
							"// A BSN passes the eleven test: 9a + 8b + ... + 2h - i is a multiple of 11.",
							"const bsn = () => { for (;;) { const d = Array.from({ length: 8 }, () => Math.floor(Math.random() * 10)); d[0] = 1 + Math.floor(Math.random() * 9); const sum = d.reduce((s, v, i) => s + v * (9 - i), 0); const last = sum % 11; if (last < 10) { return d.join('') + last; } } };",
							"pm.collectionVariables.set('bsn', bsn());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the group is created', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
