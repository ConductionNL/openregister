     "raw": "{\"title\": \"record type audit register\", \"description\": \"capability-rows-verified-c task 2.3 fixture\"}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the register is created', () => pm.expect(pm.response.code, pm.response.text()).to.be.below(300));",
       "pm.collectionVariables.set('registerId', String(pm.response.json().id));",
       "pm.collectionVariables.set('registerUuid', String(pm.response.json().uuid));"
      ]
     }
    }
   ]
  },
  {
   "name": "the audit trail holds register.created for it",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "OCS-APIRequest",
      "value": "true"
     },
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/index.php/apps/openregister/api/audit-trails?action=register.created&_limit=100",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "index.php",
      "apps",
      "openregister",
      "api",
      "audit-trails"
     ],
     "query": [
      {
       "key": "action",
       "value": "register.created"
      },
      {
       "key": "_limit",
       "value": "100"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('the audit trail answers', () => pm.response.to.have.status(200));",
       "const row = (pm.response.json().results || []).find(r => r.registerUuid === pm.collectionVariables.get('registerUuid'));",
       "pm.test('one register.created row names the register and the acting administrator', () => {",
       "  pm.expect(row, 'no register.created row for this register').to.be.an('object');",
       "  pm.expect(row.action).to.eql('register.created');",
       "  pm.expect(row.user).to.eql(pm.collectionVariables.get('admin_user'));",
       "});"
      ]
     }
    }
   ]
