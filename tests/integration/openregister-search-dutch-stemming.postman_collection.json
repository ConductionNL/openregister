							"pm.test('the capabilities answer', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));",
							"const search = pm.response.json().ocs.data.capabilities.openregister.search;",
							"pm.test('the capability says whether search stems, and in which language', () => pm.expect(search).to.have.property('stemming'));",
