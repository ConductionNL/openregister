					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('the search answers', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));",
							"const titles = pm.response.json().results.map(o => o.titel);",
							"const stems = pm.collectionVariables.get('stemming') !== 'false';",
							"// Not a substring match: \"omgevingsvergunningen\" does not occur in \"Omgevingsvergunning bouwen\", so only stemming finds it.",
							"if (stems) {",
							"  pm.test('with stemming the singular title is found, and only it', () => pm.expect(titles).to.eql(['Omgevingsvergunning bouwen']));",
							"} else {",
							"  pm.test('without stemming (MySQL, MariaDB, SQLite) the plural finds nothing', () => pm.expect(titles).to.eql([]));",
							"}"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
