{
  "info": {
    "_postman_id": "openregister-i18n-api-language-negotiation",
    "name": "OpenRegister i18n — API Language Negotiation",
    "description": "Integration tests for the i18n-api-language-negotiation change.\n\nCovers the ?_lang= / ?language= query parameters, the precedence over Accept-Language, the write-side X-Translation-Target-Language header, and the conflict (language-keyed body + header) -> 400 contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{admin_user}}", "type": "string" },
      { "key": "password", "value": "{{admin_password}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isInitialized = pm.collectionVariables.get('_aln_initialized');",
          "if (!isInitialized || isInitialized === '') {",
          "    const ts = Date.now();",
          "    pm.collectionVariables.set('test_timestamp', ts);",
          "    pm.collectionVariables.set('_aln_initialized', 'true');",
          "    console.log('API language negotiation test run initialized: ' + ts);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "admin_user", "value": "admin", "type": "string" },
    { "key": "admin_password", "value": "admin", "type": "string" },
    { "key": "aln_register_id", "value": "", "type": "string" },
    { "key": "aln_schema_id", "value": "", "type": "string" },
    { "key": "aln_object_uuid", "value": "", "type": "string" },
    { "key": "test_timestamp", "value": "", "type": "string" },
    { "key": "_aln_initialized", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register created (201)', function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('aln_register_id', String(d.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/index.php/apps/openregister/api/registers",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"i18n ALN Register {{test_timestamp}}\", \"languages\": [\"nl\", \"en\", \"de\", \"fr\"]}"
            }
          }
        },
        {
          "name": "Create Schema (title translatable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Schema created (201)', function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('aln_schema_id', String(d.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/index.php/apps/openregister/api/schemas",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"i18n ALN Schema {{test_timestamp}}\", \"properties\": {\"title\": {\"type\": \"string\", \"translatable\": true}}}"
            }
          }
        },
        {
          "name": "Create object with title.nl + title.en",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Object created (201)', function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('aln_object_uuid', d['@self'] && d['@self'].id ? d['@self'].id : d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": {\"nl\": \"Welkom\", \"en\": \"Welcome\"}}"
            }
          }
        }
      ]
    },
    {
      "name": "Read-side query parameters",
      "item": [
        {
          "name": "?_lang=en — Content-Language: en",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Language is en', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Language')).to.eql('en');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}?_lang=en",
            "header": []
          }
        },
        {
          "name": "?language=en alias works",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Language is en', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Language')).to.eql('en');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}?language=en",
            "header": []
          }
        },
        {
          "name": "?_lang=en wins over Accept-Language: nl",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Language is en (query > header)', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Language')).to.eql('en');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}?_lang=en",
            "header": [
              { "key": "Accept-Language", "value": "nl" }
            ]
          }
        },
        {
          "name": "?_lang=zz-NEVER falls through, no 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Not 400', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(400);",
                  "});",
                  "pm.test('Response is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}?_lang=GARBAGE_TAG",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Write-side target-language header",
      "item": [
        {
          "name": "PATCH scalar body + X-Translation-Target-Language: de → wraps under de",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Translation-Target-Language", "value": "de" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Willkommen\"}"
            }
          }
        },
        {
          "name": "GET ?_lang=de returns Willkommen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('title.de === Willkommen', function () {",
                  "    pm.expect(body.title).to.eql('Willkommen');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}?_lang=de",
            "header": []
          }
        },
        {
          "name": "Conflict — language-keyed body + header → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "const body = pm.response.json();",
                  "pm.test('error.code is TRANSLATION_TARGET_CONFLICT', function () {",
                  "    pm.expect(body.error && body.error.code).to.eql('TRANSLATION_TARGET_CONFLICT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/{{aln_register_id}}/{{aln_schema_id}}/{{aln_object_uuid}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Translation-Target-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": {\"nl\": \"Hallo\", \"en\": \"Welcome\"}}"
            }
          }
        }
      ]
    }
  ]
}
