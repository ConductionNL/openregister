{
  "info": {
    "name": "OpenRegister Schema Import from Standards",
    "description": "Standards-based schema import (schema-import-standards): Schema.org + GGM discovery, Schema.org import with JSON-LD round-trip, GGM import with Dutch metadata, upload dialect 422 rejection, and guarded update-from-source preview.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{admin_user}}", "type": "string" },
      { "key": "password", "value": "{{admin_password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "admin_user", "value": "admin" },
    { "key": "admin_password", "value": "admin" },
    { "key": "test_timestamp", "value": "" },
    { "key": "register_id", "value": "" },
    { "key": "person_schema_id", "value": "" },
    { "key": "person_schema_slug", "value": "" },
    { "key": "register_slug", "value": "" },
    { "key": "object_uuid", "value": "" }
  ],
  "item": [
    {
      "name": "0. Init timestamp",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": ["pm.collectionVariables.set('test_timestamp', Date.now().toString());"] }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/registers", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","registers"] }
      }
    },
    {
      "name": "1. Create target register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Register created', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "var d = pm.response.json();",
              "pm.collectionVariables.set('register_id', d.id);",
              "pm.collectionVariables.set('register_slug', d.slug);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\": \"Import Test Register {{test_timestamp}}\", \"description\": \"schema-import e2e\"}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/registers", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","registers"] }
      }
    },
    {
      "name": "2. Discover Schema.org types (q=person)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json();",
              "pm.test('Reports snapshot version', function () { pm.expect(d.snapshotVersion).to.be.a('string').and.not.empty; });",
              "pm.test('Includes Person with Thing parent', function () {",
              "  var person = d.results.find(function (r) { return r.label === 'Person'; });",
              "  pm.expect(person).to.exist;",
              "  pm.expect(person.id).to.eql('https://schema.org/Person');",
              "  pm.expect(person.parent).to.eql('Thing');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schema-import/schema.org/types?q=person", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schema-import","schema.org","types"], "query": [{ "key": "q", "value": "person" }] }
      }
    },
    {
      "name": "3. Discover GGM objecttypes (q=zaak)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json();",
              "pm.test('Returns GGM objecttypes with release version', function () {",
              "  pm.expect(d.results.length).to.be.above(0);",
              "  pm.expect(d.snapshotVersion).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schema-import/ggm/types?q=zaak", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schema-import","ggm","types"], "query": [{ "key": "q", "value": "zaak" }] }
      }
    },
    {
      "name": "4. Import schema:Person subset into register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var d = pm.response.json();",
              "var schema = d.schema;",
              "pm.collectionVariables.set('person_schema_id', schema.id);",
              "pm.collectionVariables.set('person_schema_slug', schema.slug);",
              "pm.test('Exactly the four requested properties', function () {",
              "  pm.expect(Object.keys(schema.properties).sort()).to.eql(['birthDate','email','familyName','givenName']);",
              "});",
              "pm.test('birthDate is string/date', function () {",
              "  pm.expect(schema.properties.birthDate.type).to.eql('string');",
              "  pm.expect(schema.properties.birthDate.format).to.eql('date');",
              "});",
              "pm.test('jsonld block pre-filled to schema.org/Person', function () {",
              "  pm.expect(schema.configuration.jsonld.type).to.eql('https://schema.org/Person');",
              "  pm.expect(schema.configuration.jsonld.properties.email).to.eql('https://schema.org/email');",
              "});",
              "pm.test('importSource provenance recorded', function () {",
              "  pm.expect(schema.configuration.importSource.dialect).to.eql('schema.org');",
              "  pm.expect(schema.configuration.importSource.reference).to.eql('https://schema.org/Person');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"reference\": \"Person\", \"propertySubset\": [\"givenName\", \"familyName\", \"email\", \"birthDate\"], \"targetRegister\": {{register_id}}}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schema-import/schema.org", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schema-import","schema.org"] }
      }
    },
    {
      "name": "5. Create object of imported Person schema",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Object created', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "var d = pm.response.json();",
              "var uuid = d.id || d.uuid || (d['@self'] && d['@self'].id);",
              "pm.collectionVariables.set('object_uuid', uuid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"givenName\": \"Ada\", \"familyName\": \"Lovelace\", \"email\": \"ada@example.org\"}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/{{person_schema_slug}}", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","objects","{{register_slug}}","{{person_schema_slug}}"] }
      }
    },
    {
      "name": "6. JSON-LD output is Schema.org-conformant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json();",
              "pm.test('@type resolves to schema.org/Person via mapping', function () {",
              "  var ctx = JSON.stringify(d['@context'] || {});",
              "  var type = d['@type'] || '';",
              "  pm.expect(ctx + ' ' + type).to.include('Person');",
              "});",
              "pm.test('Imported terms present in document', function () {",
              "  pm.expect(JSON.stringify(d)).to.include('email');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/ld+json" }],
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/{{person_schema_slug}}/{{object_uuid}}", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","objects","{{register_slug}}","{{person_schema_slug}}","{{object_uuid}}"] }
      }
    },
    {
      "name": "7. Import GGM objecttype (Dutch metadata)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var schema = pm.response.json().schema;",
              "pm.test('Title is Dutch objecttype name', function () { pm.expect(schema.title).to.eql('Zaak'); });",
              "pm.test('GGM type mapping (datumtijd -> date-time)', function () {",
              "  pm.expect(schema.properties.registratiedatum.format).to.eql('date-time');",
              "});",
              "pm.test('Referentielijst became enum', function () {",
              "  pm.expect(schema.properties.vertrouwelijkheidaanduiding.enum).to.include('openbaar');",
              "});",
              "pm.test('Provenance records GGM release', function () {",
              "  pm.expect(schema.configuration.importSource.dialect).to.eql('ggm');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"reference\": \"ZAAK\"}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schema-import/ggm", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schema-import","ggm"] }
      }
    },
    {
      "name": "8. Upload undetectable dialect -> 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Lists supported dialects', function () {",
              "  pm.expect(pm.response.json().error).to.include('dialect');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"json\": {\"foo\": \"bar\", \"baz\": 42}}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/upload", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schemas","upload"] }
      }
    },
    {
      "name": "9. Plain JSON Schema upload still works (regression)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('JSON Schema upload accepted', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"json\": {\"title\": \"Plain JSON Schema {{test_timestamp}}\", \"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}}}}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/upload", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schemas","upload"] }
      }
    },
    {
      "name": "10. Update-from-source preview (no apply)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json();",
              "pm.test('Preview lists the source-added properties', function () {",
              "  pm.expect(d.added).to.be.an('array');",
              "  pm.expect(d.added.length).to.be.above(0);",
              "});",
              "pm.test('Nothing applied in preview mode', function () { pm.expect(d).to.not.have.property('schema'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"apply\": false}" },
        "url": { "raw": "{{base_url}}/index.php/apps/openregister/api/schemas/{{person_schema_id}}/reimport", "host": ["{{base_url}}"], "path": ["index.php","apps","openregister","api","schemas","{{person_schema_id}}","reimport"] }
      }
    }
  ]
}
