{
	"info": {
		"name": "OpenRegister — query filter through a reference",
		"description": "query-filter-through-a-reference task 3.1. Lists requests through a field of the person each one references: `_ref[aanvrager][woonplaats]=…`, with an operator, with `in`, through a list of references, a misspelt field refused with HTTP 400, and a caller who may read the requests but not the persons, for whom no request matches. Creates its own user, register, schemas and objects and deletes them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });",
					"// The quality workflow passes base_url, admin_user and admin_password; take",
					"// them for this collection's own names when those are given.",
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('stamp')) {",
					"    pm.collectionVariables.set('stamp', 'qref' + Date.now().toString(36));",
					"}",
					"pm.collectionVariables.set('authToken', Buffer.from(pm.collectionVariables.get('username') + ':' + pm.collectionVariables.get('password')).toString('base64'));",
					"pm.collectionVariables.set('readerToken', Buffer.from(pm.collectionVariables.get('stamp') + '-reader:' + pm.collectionVariables.get('readerPassword')).toString('base64'));"
				]
			}
		}
	],
