{
  "info": {
    "_postman_id": "6f1d2a9e-t22-0000-0000-000000000022",
    "name": "OpenRegister API: credentials, integrations, object access state, settings",
    "description": "T22 coverage collection. Covers credentialOauth2, integrations, objectIntegrations, objectSharing, objectOwnership, objectPermissions, objectGrants, objectFavourite, objectReadState, objectShareLink, icon, flowTimerDiagnostic, settings, preferences, migration, tables, Settings\\ConfigurationSettings and Settings\\LlmSettings routes: success path, unknown id, invalid input and the non-admin access answer. It seeds its own data in `00 setup` (two non-admin users via OCS, a register, an admin-only schema, two objects) and removes it in `99 teardown`; it depends on no other collection. Settings writes put back the values they read.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
