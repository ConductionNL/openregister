          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the register lists the schema', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().schemas.map(String)).to.include(pm.collectionVariables.get('schemaId')); });"
                ]
              }
            }
          ]
        },
