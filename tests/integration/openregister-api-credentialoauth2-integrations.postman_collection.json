              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the object is created', () => { pm.expect(pm.response.code).to.be.oneOf([200, 201]); pm.expect(pm.response.json().name).to.eql('t22 object one'); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('objectUuid', String((b['@self'] && b['@self'].id) || b.id || b.uuid));"
                ]
              }
            }
          ]
        },
