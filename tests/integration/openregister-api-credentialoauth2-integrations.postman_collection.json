                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/registers",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"t22 register {{runId}}\", \"slug\": \"t22-reg-{{runId}}\", \"description\": \"T22 newman fixture\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the register is created', () => { pm.expect(pm.response.code).to.be.oneOf([200, 201]); pm.expect(pm.response.json().title).to.eql('t22 register ' + pm.collectionVariables.get('runId')); });",
                  "pm.collectionVariables.set('registerId', String(pm.response.json().id));",
                  "pm.collectionVariables.set('registerSlug', String(pm.response.json().slug));"
                ]
              }
            }
          ]
        },
        {
          "name": "create schema (admin-only authorization)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
