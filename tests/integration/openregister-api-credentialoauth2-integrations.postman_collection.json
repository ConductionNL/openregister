  "item": [
    {
      "name": "00 setup",
      "item": [
        {
          "name": "run id and user names",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/status.php"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36) + Math.floor(Math.random() * 1e4).toString(36);",
                  "pm.collectionVariables.set('runId', run);",
                  "pm.collectionVariables.set('userA', 't22a' + run);",
                  "pm.collectionVariables.set('userB', 't22b' + run);",
                  "pm.collectionVariables.set('userPassword', 'T22-Newman-' + run + '-pw!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Nextcloud is installed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().installed).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "create non-admin user {{userA}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/ocs/v2.php/cloud/users?format=json",
            "body": {
              "mode": "raw",
              "raw": "{\"userid\": \"{{userA}}\", \"password\": \"{{userPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the user is created (OCS 200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().ocs.data.id).to.eql(pm.collectionVariables.get('userA'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "create non-admin user {{userB}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
