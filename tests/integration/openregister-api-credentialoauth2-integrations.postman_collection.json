                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/schemas",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"t22 schema {{runId}}\", \"slug\": \"t22-sch-{{runId}}\", \"description\": \"T22 newman fixture\", \"properties\": {\"name\": {\"type\": \"string\", \"title\": \"Name\", \"maxLength\": 255}}, \"authorization\": {\"read\": [\"admin\"], \"create\": [\"admin\"], \"update\": [\"admin\"], \"delete\": [\"admin\"]}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the schema is created', () => { pm.expect(pm.response.code).to.be.oneOf([200, 201]); pm.expect(pm.response.json().title).to.eql('t22 schema ' + pm.collectionVariables.get('runId')); });",
                  "pm.collectionVariables.set('schemaId', String(pm.response.json().id));",
                  "pm.collectionVariables.set('schemaSlug', String(pm.response.json().slug));"
                ]
              }
            }
          ]
        },
        {
          "name": "attach schema to register",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
