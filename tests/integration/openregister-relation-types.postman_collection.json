          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"relations newman case\", \"description\": \"relation-types collection fixture\", \"properties\": {\"onderwerp\": {\"type\": \"string\", \"title\": \"Onderwerp\", \"maxLength\": 255}, \"classificatie\": {\"type\": \"string\", \"title\": \"Classificatie\", \"maxLength\": 64}, \"blokkeert\": {\"type\": \"array\", \"items\": {\"$ref\": \"relations-newman-case\", \"x-openregister-relation\": {\"type\": \"blocks\"}}}, \"eigenaar\": {\"$ref\": \"relations-newman-case\", \"title\": \"Eigenaar\"}}, \"configuration\": {\"x-openregister-relation-types\": [{\"key\": \"blocks\", \"label\": \"blocks\", \"inverseLabel\": \"blocked by\"}]}, \"authorization\": {\"read\": [\"authenticated\"], \"create\": [\"authenticated\"], \"update\": [\"authenticated\"], \"delete\": [\"authenticated\"]}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the schema is created', () => pm.expect(pm.response.code).to.be.below(300));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('schemaId', String(body.id));",
              "pm.test('the relation vocabulary survived the save', () => {",
              "    const declared = (body.configuration || {})['x-openregister-relation-types'];",
              "    pm.expect(declared, 'the vocabulary was dropped by setConfiguration()').to.be.an('array');",
              "    pm.expect(declared[0].key).to.eql('blocks');",
              "});"
            ]
          }
        }
      ]
    },
