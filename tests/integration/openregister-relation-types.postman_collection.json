            "type": "text/javascript",
            "exec": [
              "pm.test('the graph answers', () => pm.expect(pm.response.code).to.eql(200));",
              "const g = pm.response.json();",
              "pm.test('the root is the object asked about', () => pm.expect(g.root).to.eql(pm.collectionVariables.get('blockerUuid')));",
              "const uuids = (g.nodes || []).map(n => String(n.uuid));",
              "pm.test('the blocked case is a node', () => pm.expect(uuids).to.include(pm.collectionVariables.get('blockedUuid')));",
              "const edge = (g.edges || []).find(e => e.to === pm.collectionVariables.get('blockedUuid'));",
              "pm.test('the edge is typed', () => pm.expect(edge.label).to.eql('blocks'));",
              "pm.test('and directed', () => pm.expect(edge.direction).to.eql('outgoing'));",
              "pm.test('the answer says whether it was bounded', () => pm.expect(g).to.have.property('truncated'));",
              "pm.test('and names the depth it used', () => pm.expect(g.depth).to.eql(1));"
            ]
          }
        }
