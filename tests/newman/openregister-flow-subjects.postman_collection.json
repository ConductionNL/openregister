      "name": "3 — attaching to a role the run never recorded",
      "item": [
        {
          "name": "create flow — unheld role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the flow was authored', () => pm.response.to.have.status(201))",
                  "const flow = pm.response.json()",
                  "pm.collectionVariables.set('unheldFlow', String(flow.uuid || ''))",
                  "pm.test('the flow has a uuid', () => pm.expect(pm.collectionVariables.get('unheldFlow')).to.not.eql(''))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
