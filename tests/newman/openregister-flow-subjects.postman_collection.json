              "raw": "{\n  \"title\": \"flow-subjects register {{stamp}}\",\n  \"slug\": \"{{registerSlug}}\",\n  \"description\": \"Fixture register for the flow-run-subjects collection.\",\n  \"schemas\": [\n    \"{{schema}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/registers",
