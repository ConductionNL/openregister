                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"flow-subjects {{stamp}} unheld role\",\n  \"description\": \"Created by the flow-run-subjects Newman collection.\",\n  \"trigger\": \"manual\",\n  \"enabled\": true,\n  \"nodes\": [\n    {\n      \"id\": \"create\",\n      \"type\": \"openregister.object-write\",\n      \"config\": {\n        \"register\": \"{{registerSlug}}\",\n        \"schema\": \"{{schemaSlug}}\",\n        \"operation\": \"create\",\n        \"fields\": {\n          \"name\": \"{{ name }}\"\n        },\n        \"subjectRole\": \"case\"\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"ask\",\n      \"type\": \"openregister.user-task\",\n      \"config\": {\n        \"title\": \"flow-subjects {{stamp}} approve {{ name }}\",\n        \"assignee\": \"{{username}}\",\n        \"outcomes\": \"approved, rejected\",\n        \"attachTo\": \"besluit\"\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"e1\",\n      \"from\": \"create\",\n      \"to\": \"ask\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flows"
              ]
            }
          }
