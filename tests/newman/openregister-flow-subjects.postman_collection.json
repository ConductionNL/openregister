    {
      "name": "1 — a case is recorded, locked, and the task hangs on it",
      "item": [
        {
          "name": "create flow — the whole scene",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the flow was authored', () => pm.response.to.have.status(201))",
                  "const flow = pm.response.json()",
                  "pm.collectionVariables.set('sceneFlow', String(flow.uuid || ''))",
                  "pm.test('the flow has a uuid', () => pm.expect(pm.collectionVariables.get('sceneFlow')).to.not.eql(''))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"flow-subjects {{stamp}} the whole scene\",\n  \"description\": \"Created by the flow-run-subjects Newman collection.\",\n  \"trigger\": \"manual\",\n  \"enabled\": true,\n  \"nodes\": [\n    {\n      \"id\": \"create\",\n      \"type\": \"openregister.object-write\",\n      \"config\": {\n        \"register\": \"{{registerSlug}}\",\n        \"schema\": \"{{schemaSlug}}\",\n        \"operation\": \"create\",\n        \"fields\": {\n          \"name\": \"{{ name }}\"\n        },\n        \"subjectRole\": \"case\"\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"lock\",\n      \"type\": \"openregister.lock-object\",\n      \"config\": {\n        \"process\": \"flow-subjects {{stamp}}\"\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"ask\",\n      \"type\": \"openregister.user-task\",\n      \"config\": {\n        \"title\": \"flow-subjects {{stamp}} approve {{ name }}\",\n        \"assignee\": \"{{username}}\",\n        \"outcomes\": \"approved, rejected\",\n        \"formKind\": \"fields\",\n        \"formSchema\": \"{{schemaSlug}}\",\n        \"formFields\": \"advice\",\n        \"attachTo\": \"case\"\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"approved\",\n      \"type\": \"openregister.set-fields\",\n      \"config\": {\n        \"set\": {\n          \"branch\": \"approved\"\n        }\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"rejected\",\n      \"type\": \"openregister.set-fields\",\n      \"config\": {\n        \"set\": {\n          \"branch\": \"rejected\"\n        }\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"e1\",\n      \"from\": \"create\",\n      \"to\": \"lock\"\n    },\n    {\n      \"id\": \"e2\",\n      \"from\": \"lock\",\n      \"to\": \"ask\"\n    },\n    {\n      \"id\": \"e3\",\n      \"from\": \"ask\",\n      \"to\": [\n        \"approved\",\n        \"rejected\"\n      ],\n      \"type\": \"openregister.route\",\n      \"config\": {\n        \"rules\": [\n          {\n            \"condition\": {\n              \"==\": [\n                {\n                  \"var\": \"json.answers.advice\"\n                },\n                \"grant it\"\n              ]\n            },\n            \"output\": \"approved\"\n          }\n        ],\n        \"default\": \"rejected\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flows"
              ]
            }
          }
        },
        {
          "name": "run — the whole scene",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the run started', () => pm.response.to.have.status(200))",
                  "const run = pm.response.json()",
                  "pm.collectionVariables.set('sceneRun', String(run.uuid || ''))",
                  "pm.test('the step suspended waiting for its answer', () => {",
                  "    pm.expect(String(run.status), 'a step that raised a task must suspend').to.eql('suspended')",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flowId\": \"{{sceneFlow}}\",\n  \"seedItems\": [\n    {\n      \"json\": {\n        \"name\": \"flow-subjects {{stamp}} Case 7\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flow-runs/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flow-runs",
                "test"
              ]
            }
          }
        },
        {
          "name": "the run declared the case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the run reads back', () => pm.response.to.have.status(200))",
                  "const body = pm.response.json()",
                  "pm.test('the run carries its declared subjects', () => {",
                  "    pm.expect(body.subjects, 'subjects is an object, never a missing key').to.be.an('object')",
                  "})",
                  "pm.test('it holds the case its author named', () => {",
                  "    const held = Object.keys(body.subjects || {}).join(', ') || 'nothing'",
                  "    pm.expect(body.subjects.case, 'the run should hold a case; it holds ' + held).to.be.an('object')",
                  "})",
                  "pm.collectionVariables.set('caseUuid', String((body.subjects.case || {}).uuid || ''))",
                  "pm.test('the recorded case has a uuid', () => {",
                  "    pm.expect(pm.collectionVariables.get('caseUuid')).to.not.eql('')",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flow-runs/{{sceneRun}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flow-runs",
                "{{sceneRun}}"
              ]
            }
          }
        },
        {
          "name": "the task hangs on the case, the run and the person",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the inbox reads', () => pm.response.to.have.status(200))",
                  "const rows = pm.response.json().results || []",
                  "const run = pm.collectionVariables.get('sceneRun')",
                  "const task = rows.find((r) => String(r.runUuid) === run && String(r.nodeId) === 'ask')",
                  "pm.test('the step raised a task', () => pm.expect(task, 'no task for run ' + run).to.be.an('object'))",
                  "pm.collectionVariables.set('sceneTask', String((task || {}).uuid || ''))",
                  "// 🔴 THE ANCHOR IS THE POINT. It rides the task row's EXISTING object",
                  "// fields, so the subject-anchored inbox read, the case sidebar and the",
                  "// portal visibility rule all keep working with no change.",
                  "pm.test('the task is anchored to the declared case', () => {",
                  "    pm.expect(String((task || {}).objectUuid)).to.eql(pm.collectionVariables.get('caseUuid'))",
                  "})",
                  "pm.test('and to the case register and schema', () => {",
                  "    pm.expect(String((task || {}).registerId)).to.eql(pm.collectionVariables.get('register'))",
                  "    pm.expect(String((task || {}).schemaId)).to.eql(pm.collectionVariables.get('schema'))",
                  "})",
                  "pm.test('and it names the person who was asked', () => {",
                  "    pm.expect(String((task || {}).assignee)).to.eql(pm.collectionVariables.get('username'))",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flow-tasks?scope=assigned&isTerminal=false&limit=100&sort=created&direction=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flow-tasks?scope=assigned&isTerminal=false&limit=100&sort=created&direction=desc"
              ]
            }
          }
        },
        {
          "name": "the person answers with a form value",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the answer was accepted', () => pm.response.to.have.status(200))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"approved\",\n  \"data\": {\n    \"advice\": \"grant it\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flow-tasks/{{sceneTask}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flow-tasks",
                "{{sceneTask}}",
                "complete"
              ]
            }
          }
        },
        {
          "name": "the declared set survives the answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the run still reads', () => pm.response.to.have.status(200))",
                  "const body = pm.response.json()",
                  "pm.test('the run still holds the case it declared', () => {",
                  "    // The declared set is the run's own record: answering a task does",
                  "    // not un-declare what the run is working on.",
                  "    pm.expect(String((body.subjects.case || {}).uuid)).to.eql(pm.collectionVariables.get('caseUuid'))",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Authorization",
                "value": "Basic {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/apps/openregister/api/flow-runs/{{sceneRun}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "openregister",
                "api",
                "flow-runs",
                "{{sceneRun}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 — a write naming no role declares nothing",
      "item": [
        {
          "name": "create flow — no role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the flow was authored', () => pm.response.to.have.status(201))",
                  "const flow = pm.response.json()",
                  "pm.collectionVariables.set('noRoleFlow', String(flow.uuid || ''))",
                  "pm.test('the flow has a uuid', () => pm.expect(pm.collectionVariables.get('noRoleFlow')).to.not.eql(''))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
