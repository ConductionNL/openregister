              "raw": "{\n  \"name\": \"flow-subjects {{stamp}} no role\",\n  \"description\": \"Created by the flow-run-subjects Newman collection.\",\n  \"trigger\": \"manual\",\n  \"enabled\": true,\n  \"nodes\": [\n    {\n      \"id\": \"create\",\n      \"type\": \"openregister.object-write\",\n      \"config\": {\n        \"register\": \"{{registerSlug}}\",\n        \"schema\": \"{{schemaSlug}}\",\n        \"operation\": \"create\",\n        \"fields\": {\n          \"name\": \"{{ name }}\"\n        }\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    },\n    {\n      \"id\": \"done\",\n      \"type\": \"openregister.set-fields\",\n      \"config\": {\n        \"set\": {\n          \"step\": 2\n        }\n      },\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"e1\",\n      \"from\": \"create\",\n      \"to\": \"done\"\n    }\n  ]\n}"
            },
            "url": {
