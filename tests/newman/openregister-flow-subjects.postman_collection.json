              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the run started', () => pm.response.to.have.status(200))",
                  "const run = pm.response.json()",
                  "pm.collectionVariables.set('noRoleRun', String(run.uuid || ''))"
                ]
              }
