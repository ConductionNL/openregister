{
	"info": {
		"name": "OpenRegister — near-duplicate documents by text",
		"description": "near-duplicate-documents-by-text task 2.3: three files with near-identical text (one sentence differs) and one unrelated file are uploaded to one object and extracted through `POST /api/files/{id}/extract`, which extracts synchronously; `GET /api/files/near-duplicates?objectIds[]=` then answers one group of three, represented by the earliest file, with the unrelated file in no group. A request without a scope is refused. Creates its own register, schema and object and deletes them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"[['baseUrl', 'base_url'], ['username', 'admin_user'], ['password', 'admin_password']].forEach(function (pair) {",
					"    var given = pm.environment.get(pair[1]);",
					"    if (given !== undefined && given !== '') {",
					"        pm.collectionVariables.set(pair[0], given);",
					"    }",
					"});",
					"if (!pm.collectionVariables.get('stamp')) {",
					"    pm.collectionVariables.set('stamp', 'ndup' + Date.now().toString(36));",
					"}",
					"pm.collectionVariables.set('authToken', Buffer.from(pm.collectionVariables.get('username') + ':' + pm.collectionVariables.get('password')).toString('base64'));"
				]
			}
		}
	],
