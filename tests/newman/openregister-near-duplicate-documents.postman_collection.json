		{
			"name": "02 — near duplicates",
			"item": [
				{
					"name": "the object's files form one group of three",
					"protocolProfileBehavior": {
						"disableCookies": true
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json()",
									"const ids = ['file1', 'file2', 'file3'].map(k => Number(pm.collectionVariables.get(k)))",
									"pm.test('answers 200', () => pm.response.to.have.status(200))",
									"pm.test('exactly one group', () => pm.expect(body.groups).to.have.length(1))",
									"pm.test('the group holds the three near-identical files', () => pm.expect(body.groups[0].members.map(m => m.fileId).sort((a, b) => a - b)).to.eql(ids.sort((a, b) => a - b)))",
									"pm.test('the earliest file represents the group', () => pm.expect(body.groups[0].representative).to.eql(Math.min(...ids)))",
									"pm.test('every member is above the default threshold', () => body.groups[0].members.forEach(m => pm.expect(m.similarity).to.be.at.least(0.9)))",
									"pm.test('the unrelated file is in no group', () => pm.expect(body.groups.flatMap(g => g.members.map(m => m.fileId))).to.not.include(Number(pm.collectionVariables.get('fileOther'))))"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Basic {{authToken}}"
							}
						],
						"url": "{{baseUrl}}/index.php/apps/openregister/api/files/near-duplicates?objectIds[]={{object}}"
					}
				},
				{
					"name": "a request without a scope is refused",
