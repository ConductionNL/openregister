		{
			"name": "Ascending by title ignores letter case",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.expect(pm.response.code).to.equal(200));",
							"const titles = pm.response.json().results.map((o) => o.title);",
							"// Byte order would give Appel, Cherry, aardbei, appel, banaan.",
							"const lower = titles.map((t) => t.toLowerCase());",
							"pm.test('the lower-cased titles are in ascending order', () => pm.expect(lower).to.eql(['aardbei', 'appel', 'appel', 'banaan', 'cherry']));",
							"pm.test('both spellings of appel sit together, between aardbei and banaan', () => pm.expect(titles.slice(1, 3).sort()).to.eql(['Appel', 'appel']));"
						]
					}
				}
			],
