              "  pm.expect(b.reason).to.eql('two brothers at one address');",
              "  pm.expect(b.dismissedAt).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('and a fingerprint of what was compared', () => pm.expect(b.fingerprint).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
