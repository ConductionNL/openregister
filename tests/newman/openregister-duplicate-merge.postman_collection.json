              "const ids = (pm.response.json().items || []).map(p => [p.objectA, p.objectB].sort().join('|'));",
              "const want = [pm.collectionVariables.get('firstUuid'), pm.collectionVariables.get('secondUuid')].sort().join('|');",
              "pm.test('our pair is offered before anyone dismisses it', () => pm.expect(ids).to.include(want));"
            ]
          }
