          "raw": "{\"title\": \"dismissal newman schema\", \"description\": \"dismissed-pair collection fixture\", \"properties\": {\"name\": {\"type\": \"string\", \"title\": \"Name\", \"maxLength\": 255}, \"email\": {\"type\": \"string\", \"title\": \"Email\", \"maxLength\": 255}, \"kvkNumber\": {\"type\": \"string\", \"title\": \"KvK Number\", \"maxLength\": 255}}, \"authorization\": {\"read\": [\"authenticated\"], \"create\": [\"authenticated\"], \"update\": [\"authenticated\"], \"delete\": [\"authenticated\"]}, \"configuration\": {\"x-openregister-dedup\": {\"matchRules\": [{\"field\": \"name\", \"method\": \"normalized\", \"weight\": 0.5}, {\"field\": \"email\", \"method\": \"exact\", \"weight\": 0.5}], \"threshold\": 0.85, \"dismissGroups\": [\"admin\"]}, \"x-openregister-unique-hint\": [\"kvkNumber\"]}}"
        }
