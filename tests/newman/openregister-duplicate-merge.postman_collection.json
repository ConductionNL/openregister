              "pm.collectionVariables.set('schemaSlug', String(pm.response.json().slug));",
              "pm.test('both declarations persisted', () => {",
              "  const cfg = pm.response.json().configuration || {};",
              "  pm.expect(cfg['x-openregister-dedup']).to.be.an('object');",
              "  pm.expect(cfg['x-openregister-unique-hint']).to.eql(['kvkNumber']);",
              "});"
            ]
          }
        }
      ]
