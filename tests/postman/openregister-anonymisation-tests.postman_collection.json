{
	"info": {
		"_postman_id": "openregister-anonymisation-tests",
		"name": "OpenRegister - PDF / Office Anonymisation Tests",
		"description": "Newman / Postman integration tests for the file-anonymise REST surface.\n\nCovers tasks.md §9.4 of the `pdf-anonymisation` OpenSpec change. Exercises:\n\n1. POST /index.php/apps/openregister/api/files/{fileId}/anonymize against a checked-in PDF fixture.\n2. Encrypted-PDF rejection path (HTTP 422 / reason: encrypted_pdf).\n3. Validation-gate residual case (HTTP 500 / reason: validation_failed) — requires a known-bad fixture.\n\nThe collection ships with a fixture-checkin guard: each test uses a `pm.test.skip()` if its referenced fixture id is absent from the collection variables. Once a tenant pins a fixture file id (via `pm.collectionVariables.set('fixtureFileId', ...)`) the suite promotes itself.\n\nSee tests/fixtures/pdf-anonymisation/README.md for the fixture-checkin contract.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{username}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{password}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. PDF anonymisation — happy path (fixture-gated)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const fixtureFileId = pm.collectionVariables.get('fixtureFileId');",
							"if (!fixtureFileId) {",
							"    console.log('[skip] fixtureFileId not set — fixture-checkin guard skipped this run');",
							"    postman.setNextRequest(null);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Anonymise endpoint returns 200 for a checked-in PDF fixture', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response carries the anonymised file id', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json).to.have.property('fileId');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"entities\": [{\"text\": \"Jan Jansen\", \"entityType\": \"PERSON\", \"key\": \"7\"}]\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/index.php/apps/openregister/api/files/{{fixtureFileId}}/anonymize",
					"host": ["{{baseUrl}}"],
					"path": ["index.php", "apps", "openregister", "api", "files", "{{fixtureFileId}}", "anonymize"]
				}
			}
		},
		{
			"name": "2. Encrypted PDF — 422",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const fid = pm.collectionVariables.get('encryptedFixtureFileId');",
							"if (!fid) {",
							"    console.log('[skip] encryptedFixtureFileId not set — fixture-checkin guard skipped this run');",
							"    postman.setNextRequest(null);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Encrypted PDF returns 422 (caller-correctable)', function () {",
							"    pm.response.to.have.status(422);",
							"});",
							"",
							"pm.test('Response body carries reason=encrypted_pdf', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json).to.have.property('reason', 'encrypted_pdf');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"entities\": [{\"text\": \"Jan Jansen\", \"entityType\": \"PERSON\", \"key\": \"7\"}]\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/index.php/apps/openregister/api/files/{{encryptedFixtureFileId}}/anonymize",
					"host": ["{{baseUrl}}"],
					"path": ["index.php", "apps", "openregister", "api", "files", "{{encryptedFixtureFileId}}", "anonymize"]
				}
			}
		},
		{
			"name": "3. Validation-gate residual — 500",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const fid = pm.collectionVariables.get('residualFixtureFileId');",
							"if (!fid) {",
							"    console.log('[skip] residualFixtureFileId not set — fixture-checkin guard skipped this run');",
							"    postman.setNextRequest(null);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Validation-gate failure surfaces 500', function () {",
							"    pm.response.to.have.status(500);",
							"});",
							"",
							"pm.test('Response body carries reason=validation_failed', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json).to.have.property('reason', 'validation_failed');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"entities\": [{\"text\": \"Jan Jansen\", \"entityType\": \"PERSON\", \"key\": \"7\"}]\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/index.php/apps/openregister/api/files/{{residualFixtureFileId}}/anonymize",
					"host": ["{{baseUrl}}"],
					"path": ["index.php", "apps", "openregister", "api", "files", "{{residualFixtureFileId}}", "anonymize"]
				}
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "username", "value": "admin" },
		{ "key": "password", "value": "admin" },
		{ "key": "fixtureFileId", "value": "" },
		{ "key": "encryptedFixtureFileId", "value": "" },
		{ "key": "residualFixtureFileId", "value": "" }
	]
}
