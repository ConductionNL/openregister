    },
    "valid annotation is allowed": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P7Y",
                    "rules": [
                        {
                            "condition": "status == \"closed\"",
                            "retention": "P10Y",
                            "reason": "Closed cases"
                        }
                    ]
                }
            }
        },
        "findings": [],
        "refused": false
    },
    "mutated default is refused": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P7",
                    "rules": [
                        {
                            "condition": "status == \"closed\"",
                            "retention": "P10Y",
                            "reason": "Closed cases"
                        }
                    ]
                }
            }
        },
        "findings": [
            {
                "code": "archival-retention-default-malformed",
                "message": "x-openregister-archival.retention.default \"P7\" is not a valid ISO-8601 duration (e.g. \"P30D\", \"PT1H\", \"P1Y6M\")."
            }
        ],
        "refused": true
    },
    "annotation not an object": {
        "schema": {
            "x-openregister-archival": "P7Y"
        },
        "findings": [
            {
                "code": "archival-not-object",
                "message": "x-openregister-archival must be an object."
            }
        ],
        "refused": true
    },
    "retention missing": {
        "schema": {
            "x-openregister-archival": {
                "category": "a"
            }
        },
        "findings": [
            {
                "code": "archival-retention-missing",
                "message": "x-openregister-archival.retention is required and must be an object."
            }
        ],
        "refused": true
    },
    "retention unknown key and default missing": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "rulez": []
