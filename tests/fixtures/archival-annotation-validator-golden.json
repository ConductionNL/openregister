                            "reason": 7
                        }
                    ]
                }
            }
        },
        "findings": [
            {
                "code": "archival-rule-unknown-key",
                "message": "x-openregister-archival.retention.rules[0] contains unknown key \"when\". Allowed: condition, retention, reason."
            },
            {
                "code": "archival-rule-condition-not-string",
                "message": "x-openregister-archival.retention.rules[0].condition must be a non-empty string."
            },
            {
                "code": "archival-rule-retention-missing",
                "message": "x-openregister-archival.retention.rules[0].retention is required (ISO-8601 duration)."
            },
            {
                "code": "archival-rule-reason-not-string",
                "message": "x-openregister-archival.retention.rules[0].reason must be a string when present."
            }
        ],
        "refused": true
    },
    "rule with empty condition and malformed retention": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P1Y",
                    "rules": [
                        {
                            "condition": "  ",
                            "retention": "ten years"
                        }
                    ]
                }
            }
        },
        "findings": [
            {
                "code": "archival-rule-condition-empty",
                "message": "x-openregister-archival.retention.rules[0].condition must not be empty."
            },
            {
                "code": "archival-rule-retention-malformed",
                "message": "x-openregister-archival.retention.rules[0].retention \"ten years\" is not a valid ISO-8601 duration."
            }
        ],
        "refused": true
    },
    "unknown top-level key only warns": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P1Y"
                },
                "_note": "x"
            }
        },
        "findings": [
            {
                "code": "archival-unknown-key",
                "severity": "warning",
                "message": "x-openregister-archival contains unknown key \"_note\". Allowed: retention, aggregationLevel, useRestriction, temporalCoverage, category, categoryProperty, action, parties."
            }
        ],
        "refused": false
    }
}
