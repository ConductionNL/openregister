            }
        },
        "findings": [
            {
                "code": "archival-retention-unknown-key",
                "message": "x-openregister-archival.retention contains unknown key \"rulez\". Allowed: default, rules."
            },
            {
                "code": "archival-retention-default-missing",
                "message": "x-openregister-archival.retention.default is required (ISO-8601 duration, e.g. \"P30D\")."
            }
        ],
        "refused": true
    },
    "default not a string": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": 30
                }
            }
        },
        "findings": [
            {
                "code": "archival-retention-default-malformed",
                "message": "x-openregister-archival.retention.default \"30\" is not a valid ISO-8601 duration (e.g. \"P30D\", \"PT1H\", \"P1Y6M\")."
            }
        ],
        "refused": true
    },
    "rules not an array": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
