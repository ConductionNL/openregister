        },
        "findings": [
            {
                "code": "archival-rules-not-array",
                "message": "x-openregister-archival.retention.rules must be an array of rule objects."
            }
        ],
        "refused": true
    },
    "rule not an object": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P1Y",
                    "rules": [
                        "x",
                        {
                            "condition": "a",
                            "retention": "P1D"
                        }
                    ]
                }
            }
        },
        "findings": [
            {
                "code": "archival-rule-not-object",
                "message": "x-openregister-archival.retention.rules[0] must be an object."
            }
        ],
        "refused": true
    },
    "rule with every key wrong": {
        "schema": {
            "x-openregister-archival": {
                "retention": {
                    "default": "P1Y",
                    "rules": [
                        {
                            "when": "a",
