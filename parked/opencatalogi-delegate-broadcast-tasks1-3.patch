+<?php
+
+/**
+ * Unit tests for BroadcastWebhook.
+ *
+ * @category Test
+ * @package  OCA\OpenCatalogi\Tests\Unit\Service\Broadcast
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @link https://www.OpenCatalogi.nl
+ */
+
+declare(strict_types=1);
+
+namespace OCA\OpenCatalogi\Tests\Unit\Service\Broadcast;
+
+require_once __DIR__ . '/BroadcastWebhookFakes.php';
+
+use OCA\OpenCatalogi\Service\Broadcast\BroadcastWebhook;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * @covers \OCA\OpenCatalogi\Service\Broadcast\BroadcastWebhook
+ *
+ * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+ */
+class BroadcastWebhookTest extends TestCase {
+
+	public function testEnqueueCallsTriggerWebhookForEventOnceWithTodaysBody(): void {
+		$service = new FakeWebhookService();
+		$webhook = new BroadcastWebhook(webhookService: $service, webhookMapper: new FakeWebhookMapper());
+
+		$queued = $webhook->enqueue(url: 'https://peer.example/api/directory', directoryUrl: 'https://self.example/api/directory', source: 'opencatalogi', version: '1.2.3');
+
+		$this->assertSame(1, $queued);
+		$this->assertCount(1, $service->calls);
+		$call = $service->calls[0];
+		$this->assertSame('opencatalogi.federation.broadcast', $call['eventName']);
+		$this->assertSame('https://peer.example/api/directory', $call['url']);
+		$this->assertSame(['directory', 'timestamp', 'source'], array_keys($call['payload']));
+		$this->assertSame('https://self.example/api/directory', $call['payload']['directory']);
+		$this->assertSame('opencatalogi', $call['payload']['source']);
+		$this->assertNotFalse(\DateTime::createFromFormat(\DateTimeInterface::ATOM, $call['payload']['timestamp']));
+	}
+
+	public function testTheFirstCallCreatesOnePerTargetRowWithTheUserAgentAndRetryPolicy(): void {
+		$mapper = new FakeWebhookMapper();
+		$webhook = new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: $mapper);
+
+		$webhook->enqueue(url: 'https://a.example/', directoryUrl: 'https://self.example/', source: 'opencatalogi', version: '1.2.3');
+		$webhook->enqueue(url: 'https://b.example/', directoryUrl: 'https://self.example/', source: 'opencatalogi', version: '1.2.3');
+
+		$this->assertCount(1, $mapper->created);
+		$row = $mapper->created[0];
+		$this->assertSame(['opencatalogi.federation.broadcast'], $row['events']);
+		$this->assertSame(['deliverPerTarget' => true], $row['configuration']);
+		$this->assertSame(['User-Agent' => 'OpenCatalogi-Broadcast/1.2.3'], $row['headers']);
+		$this->assertSame('POST', $row['method']);
+		$this->assertSame('exponential', $row['retryPolicy']);
+		$this->assertSame(3, $row['maxRetries']);
+		$this->assertTrue($row['enabled']);
+	}
+
+	public function testAnExistingRowIsNotDuplicated(): void {
+		$mapper = new FakeWebhookMapper();
+		$mapper->rows[] = new FakeWebhookRow(events: ['opencatalogi.federation.broadcast'], configuration: ['deliverPerTarget' => true]);
+
+		(new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: $mapper))->ensureRow(version: '1');
+
+		$this->assertSame([], $mapper->created);
+	}
+
+	public function testAnOrdinaryWebhookOnTheEventIsNotMistakenForTheRow(): void {
+		$mapper = new FakeWebhookMapper();
+		$mapper->rows[] = new FakeWebhookRow(events: ['opencatalogi.federation.broadcast']);
+
+		(new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: $mapper))->ensureRow(version: '1');
+
+		$this->assertCount(1, $mapper->created);
+	}
+
+	public function testALostCreateRaceReReadsInsteadOfFailing(): void {
+		$mapper = new FakeWebhookMapper(refuseCreate: true, rowAppearsOnRefusal: true);
+
+		(new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: $mapper))->ensureRow(version: '1');
+
+		$this->assertCount(1, $mapper->rows);
+	}
+
+	public function testACreateRefusalWithNoRowIsRaised(): void {
+		$webhook = new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: new FakeWebhookMapper(refuseCreate: true));
+
+		$this->expectException(\RuntimeException::class);
+		$this->expectExceptionMessage('duplicate key');
+
+		$webhook->ensureRow(version: '1');
+	}
+
+	public function testSupportNeedsPerTargetDeliveryOnOpenRegister(): void {
+		$this->assertTrue((new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: new FakeWebhookMapper()))->isSupported());
+		$this->assertFalse((new BroadcastWebhook(webhookService: new \stdClass(), webhookMapper: new FakeWebhookMapper()))->isSupported());
+		$this->assertFalse((new BroadcastWebhook(webhookService: new FakeWebhookService(), webhookMapper: new \stdClass()))->isSupported());
+	}
+}
