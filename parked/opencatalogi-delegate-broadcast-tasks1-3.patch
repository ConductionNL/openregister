+<?php
+
+/**
+ * Hands one federation broadcast to OpenRegister's webhook delivery.
+ *
+ * @category Service
+ * @package  OCA\OpenCatalogi\Service\Broadcast
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-License-Identifier: EUPL-1.2
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ *
+ * @version GIT: <git_id>
+ *
+ * @link https://www.OpenCatalogi.nl
+ *
+ * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+ */
+
+declare(strict_types=1);
+
+namespace OCA\OpenCatalogi\Service\Broadcast;
+
+use Throwable;
+
+/**
+ * BroadcastWebhook Class.
+ *
+ * Owns the one shared per-target Webhook row for the broadcast event and
+ * enqueues each broadcast through OpenRegister's
+ * `WebhookService::triggerWebhookForEvent()`, so delivery, retries and the dead
+ * letter are OpenRegister's. The row is created on first use, once.
+ *
+ * @spec openspec/specs/federation/spec.md
+ */
+final class BroadcastWebhook {
+	/**
+	 * The event every broadcast is sent as.
+	 */
+	public const EVENT = 'opencatalogi.federation.broadcast';
+
+	/**
+	 * The OpenRegister webhook configuration key that names the URL per delivery.
+	 */
+	private const PER_TARGET_KEY = 'deliverPerTarget';
+
+	/**
+	 * Build the adapter.
+	 *
+	 * @param object $webhookService OpenRegister's WebhookService.
+	 * @param object $webhookMapper  OpenRegister's WebhookMapper.
+	 */
+	public function __construct(
+		private readonly object $webhookService,
+		private readonly object $webhookMapper,
+	) {
+	}//end __construct()
+
+	/**
+	 * Whether this OpenRegister can deliver a broadcast per target.
+	 *
+	 * @return bool True when its WebhookService has triggerWebhookForEvent().
+	 *
+	 * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+	 */
+	public function isSupported(): bool {
+		return method_exists($this->webhookService, 'triggerWebhookForEvent') === true
+			&& method_exists($this->webhookMapper, 'findForEvent') === true
+			&& method_exists($this->webhookMapper, 'createFromArray') === true;
+	}//end isSupported()
+
+	/**
+	 * Enqueue one broadcast to one peer.
+	 *
+	 * @param string $url          The peer to tell.
+	 * @param string $directoryUrl This directory's URL.
+	 * @param string $source       The app sending it.
+	 * @param string $version      The app version, sent in the User-Agent.
+	 *
+	 * @return int The deliveries enqueued: 1, or 0 when OpenRegister took none.
+	 *
+	 * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+	 */
+	public function enqueue(string $url, string $directoryUrl, string $source, string $version): int {
+		$this->ensureRow(version: $version);
+
+		return (int) $this->webhookService->triggerWebhookForEvent(
+			eventName: self::EVENT,
+			payload: [
+				'directory' => $directoryUrl,
+				'timestamp' => (new \DateTime())->format('c'),
+				'source' => $source,
+			],
+			url: $url
+		);
+	}//end enqueue()
+
+	/**
+	 * Create the shared per-target broadcast webhook when none exists.
+	 *
+	 * A second caller that lost a race with the first re-reads the rows instead
+	 * of creating a duplicate.
+	 *
+	 * @param string $version The app version, sent in the User-Agent.
+	 *
+	 * @return void
+	 *
+	 * @throws Throwable When the row cannot be created and still does not exist.
+	 *
+	 * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+	 */
+	public function ensureRow(string $version): void {
+		if ($this->hasRow() === true) {
+			return;
+		}
+
+		try {
+			$this->webhookMapper->createFromArray(
+				[
+					'name' => 'OpenCatalogi federation broadcast',
+					// Never posted to: a per-target webhook names its URL per delivery.
+					'url' => 'https://localhost/opencatalogi-federation-broadcast',
+					'method' => 'POST',
+					'events' => [self::EVENT],
+					'headers' => ['User-Agent' => 'OpenCatalogi-Broadcast/' . $version],
+					'enabled' => true,
+					'retryPolicy' => 'exponential',
+					'maxRetries' => 3,
+					'timeout' => 30,
+					'configuration' => [self::PER_TARGET_KEY => true],
+				]
+			);
+		} catch (Throwable $e) {
+			if ($this->hasRow() === false) {
+				throw $e;
+			}
+		}
+	}//end ensureRow()
+
+	/**
+	 * Whether a per-target webhook for the broadcast event exists.
+	 *
+	 * Reads the rows each time: another request may have created one meanwhile.
+	 *
+	 * @return bool True when one does.
+	 *
+	 * @phpstan-impure
+	 */
+	private function hasRow(): bool {
+		foreach ($this->webhookMapper->findForEvent(self::EVENT) as $webhook) {
+			$configuration = $webhook->getConfigurationArray();
+			if (($configuration[self::PER_TARGET_KEY] ?? false) === true) {
+				return true;
+			}
+		}
+
+		return false;
+	}//end hasRow()
+}//end class
