@@ -661,6 +670,10 @@ class BroadcastService implements BroadcastServiceInterface {
 		// "pre-flight SSRF guard short-circuits before delegation".
 		$this->assertSafeOutboundUrl(url: $url);
 
+		if ($this->enqueueThroughOpenRegister(url: $url, directoryUrl: $directoryUrl) === true) {
+			return new BroadcastResult(url: $url, status: BroadcastResult::STATUS_ENQUEUED);
+		}
+
 		$delivered = $this->sendBroadcastRequest(url: $url, directoryUrl: $directoryUrl);
 
 		$status = BroadcastResult::STATUS_FAILED;
@@ -674,6 +687,67 @@ class BroadcastService implements BroadcastServiceInterface {
 		);
 	}//end enqueueBroadcast()
 
+	/**
+	 * Hand a broadcast to OpenRegister's webhook delivery.
+	 *
+	 * @param string $url          The peer to tell.
+	 * @param string $directoryUrl This directory's URL.
+	 *
+	 * @return bool True when OpenRegister enqueued it; false (deprecation logged) to use the legacy path.
+	 *
+	 * @spec openspec/changes/opencatalogi-delegate-broadcast-to-or-webhooks/specs/federation/spec.md#requirement-broadcast-delegates-to-or-webhooks-fed-or-001
+	 */
+	private function enqueueThroughOpenRegister(string $url, string $directoryUrl): bool {
+		$webhook = $this->broadcastWebhook();
+		try {
+			if ($webhook !== null
+				&& $webhook->enqueue(url: $url, directoryUrl: $directoryUrl, source: $this->appName, version: $this->getAppVersion()) > 0
+			) {
+				return true;
+			}
+		} catch (\Throwable $e) {
+			$this->logger->warning('OpenRegister did not take the broadcast to ' . $url . ': ' . $e->getMessage());
+		}
+
+		$this->logger->warning(
+			'Deprecated: broadcasting to ' . $url . ' through the built-in retry loop because OpenRegister '
+			. 'per-target webhook delivery is not available. Update OpenRegister; this path will be removed.'
+		);
+		return false;
+	}//end enqueueThroughOpenRegister()
+
+	/**
+	 * The OpenRegister broadcast webhook adapter, or null when OpenRegister cannot deliver per target.
+	 *
+	 * @return BroadcastWebhook|null The adapter.
+	 */
+	private function broadcastWebhook(): ?BroadcastWebhook {
+		if ($this->broadcastWebhook !== null) {
+			return $this->broadcastWebhook;
+		}
+
+		$installed = $this->appManager->getInstalledApps();
+		if (is_array($installed) === false || in_array(needle: 'openregister', haystack: $installed) === false) {
+			return null;
+		}
+
+		try {
+			$webhook = new BroadcastWebhook(
+				webhookService: $this->container->get('OCA\OpenRegister\Service\WebhookService'),
+				webhookMapper: $this->container->get('OCA\OpenRegister\Db\WebhookMapper')
+			);
+		} catch (ContainerExceptionInterface|NotFoundExceptionInterface $e) {
+			return null;
+		}
+
+		if ($webhook->isSupported() === false) {
+			return null;
+		}
+
+		$this->broadcastWebhook = $webhook;
+		return $webhook;
+	}//end broadcastWebhook()
+
 	/**
 	 * Check whether a host is on the dev-only local-federation allowlist.
 	 *
