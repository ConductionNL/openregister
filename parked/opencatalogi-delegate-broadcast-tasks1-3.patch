+<?php
+
+/**
+ * Stand-ins for OpenRegister's WebhookService and WebhookMapper in broadcast tests.
+ *
+ * @category Test
+ * @package  OCA\OpenCatalogi\Tests\Unit\Service\Broadcast
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @link https://www.OpenCatalogi.nl
+ */
+
+declare(strict_types=1);
+
+namespace OCA\OpenCatalogi\Tests\Unit\Service\Broadcast;
+
+/**
+ * Records every triggerWebhookForEvent() call and answers a fixed count.
+ */
+final class FakeWebhookService {
+	/** @var list<array{eventName: string, payload: array, url: string}> */
+	public array $calls = [];
+
+	public function __construct(public int $answer = 1) {
+	}
+
+	public function triggerWebhookForEvent(string $eventName, array $payload, string $url): int {
+		$this->calls[] = ['eventName' => $eventName, 'payload' => $payload, 'url' => $url];
+		return $this->answer;
+	}
+}
+
+/**
+ * Holds webhook rows in memory; can refuse the first create the way a lost race does.
+ */
+final class FakeWebhookMapper {
+	/** @var list<FakeWebhookRow> */
+	public array $rows = [];
+
+	/** @var list<array> */
+	public array $created = [];
+
+	public function __construct(public bool $refuseCreate = false, public bool $rowAppearsOnRefusal = false) {
+	}
+
+	public function findForEvent(string $eventClass): array {
+		return array_values(array_filter($this->rows, fn (FakeWebhookRow $row): bool => in_array($eventClass, $row->events, true)));
+	}
+
+	public function createFromArray(array $data): FakeWebhookRow {
+		if ($this->refuseCreate === true) {
+			if ($this->rowAppearsOnRefusal === true) {
+				$this->rows[] = new FakeWebhookRow(events: $data['events'], configuration: $data['configuration']);
+			}
+
+			throw new \RuntimeException('duplicate key');
+		}
+
+		$this->created[] = $data;
+		$row = new FakeWebhookRow(events: $data['events'], configuration: $data['configuration']);
+		$this->rows[] = $row;
+		return $row;
+	}
+}
+
+/**
+ * One webhook row: its events and configuration.
+ */
+final class FakeWebhookRow {
+	public function __construct(public array $events, public array $configuration = []) {
+	}
+
+	public function getConfigurationArray(): array {
+		return $this->configuration;
+	}
+}
