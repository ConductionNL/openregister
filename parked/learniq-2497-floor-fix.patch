+<?php
+
+/**
+ * Learniq Credential Documents
+ *
+ * The documents a signed credential carries besides its Open Badges payload:
+ * the signed Europass form and the certificate PDF printed on the course's
+ * template. Issuing and reissuing both attach the two in the same order, so
+ * they share this one collaborator.
+ *
+ * @category Service
+ * @package  OCA\Learniq\Service
+ *
+ * @author    Conduction Development Team <dev@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @version GIT: <git-id>
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/credentials-certificate-pdf/specs/certification/spec.md#requirement-issuing-a-certificate-renders-its-pdf-fail-soft
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Learniq\Service;
+
+use OCA\Learniq\Kernel\Contracts\CertificatePdfDelegationServiceInterface;
+use OCA\Learniq\Kernel\Contracts\EuropassIssuerInterface;
+
+/**
+ * Attaches the Europass form and the rendered PDF to a signed credential.
+ *
+ * @spec openspec/changes/credentials-certificate-pdf/specs/certification/spec.md#requirement-issuing-a-certificate-renders-its-pdf-fail-soft
+ */
+class CredentialDocuments {
+
+	/**
+	 * Constructor.
+	 *
+	 * @param EuropassIssuerInterface                  $europass       Adds the signed Europass form.
+	 * @param CertificatePdfDelegationServiceInterface $certificatePdf Prints the certificate on the course's template, fail soft.
+	 *
+	 * @return void
+	 */
+	public function __construct(
+		private readonly EuropassIssuerInterface $europass,
+		private readonly CertificatePdfDelegationServiceInterface $certificatePdf,
+	) {
+	}//end __construct()
+
+	/**
+	 * The credential with its signed Europass form, when its type has one.
+	 *
+	 * @param array<string, mixed> $credential The signed credential.
+	 *
+	 * @return array<string, mixed>
+	 *
+	 * @spec openspec/changes/credentials-certificate-pdf/specs/certification/spec.md#requirement-issuing-a-certificate-renders-its-pdf-fail-soft
+	 */
+	public function withEuropass(array $credential): array {
+		return $this->europass->withEuropass(credential: $credential);
+	}//end withEuropass()
+
+	/**
+	 * The credential with the outcome of printing it on the course's template.
+	 *
+	 * @param array<string, mixed> $credential The signed credential.
+	 * @param array<string, mixed> $course     The course it certifies.
+	 *
+	 * @return array<string, mixed>
+	 *
+	 * @spec openspec/changes/credentials-certificate-pdf/specs/certification/spec.md#requirement-issuing-a-certificate-renders-its-pdf-fail-soft
+	 */
+	public function withPdf(array $credential, array $course): array {
+		return $this->certificatePdf->render(credential: $credential, course: $course);
+	}//end withPdf()
+}//end class
