+<?php
+
+/**
+ * Unit tests for CredentialDocuments.
+ *
+ * @category  Tests
+ * @package   OCA\Learniq\Tests\Unit\Service
+ * @author    Conduction b.v. <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ * @link      https://github.com/ConductionNL/learniq
+ *
+ * @spec openspec/changes/credentials-certificate-pdf/specs/certification/spec.md#requirement-issuing-a-certificate-renders-its-pdf-fail-soft
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Learniq\Tests\Unit\Service;
+
+use OCA\Learniq\Kernel\Contracts\CertificatePdfDelegationServiceInterface;
+use OCA\Learniq\Kernel\Contracts\EuropassIssuerInterface;
+use OCA\Learniq\Service\CredentialDocuments;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * The Europass form and the PDF are each asked of their own service, with the
+ * credential and course unchanged, and the service's answer is returned as is.
+ */
+#[CoversClass(CredentialDocuments::class)]
+class CredentialDocumentsTest extends TestCase {
+
+	/**
+	 * The Europass form comes from the Europass issuer, never from the PDF renderer.
+	 *
+	 * @return void
+	 */
+	public function testTheEuropassFormComesFromTheEuropassIssuer(): void {
+		$credential = ['id' => 'c-1', 'type' => 'certificate'];
+		$europass = $this->createMock(originalClassName: EuropassIssuerInterface::class);
+		$europass->expects($this->once())->method('withEuropass')
+			->with($credential)
+			->willReturn($credential + ['edciPayload' => ['id' => 'urn:uuid:c-1']]);
+		$pdf = $this->createMock(originalClassName: CertificatePdfDelegationServiceInterface::class);
+		$pdf->expects($this->never())->method('render');
+
+		$documents = new CredentialDocuments(europass: $europass, certificatePdf: $pdf);
+
+		self::assertSame(
+			expected: ['id' => 'c-1', 'type' => 'certificate', 'edciPayload' => ['id' => 'urn:uuid:c-1']],
+			actual: $documents->withEuropass(credential: $credential)
+		);
+	}//end testTheEuropassFormComesFromTheEuropassIssuer()
+
+	/**
+	 * The PDF outcome comes from the renderer, with the course it was given.
+	 *
+	 * @return void
+	 */
+	public function testThePdfIsRenderedOnTheGivenCourse(): void {
+		$credential = ['id' => 'c-2'];
+		$course = ['id' => 'k-1', 'certificateTemplateSlug' => 'certificate-a4'];
+		$europass = $this->createMock(originalClassName: EuropassIssuerInterface::class);
+		$europass->expects($this->never())->method('withEuropass');
+		$pdf = $this->createMock(originalClassName: CertificatePdfDelegationServiceInterface::class);
+		$pdf->expects($this->once())->method('render')
+			->with($credential, $course)
+			->willReturn($credential + ['pdfRenderStatus' => 'failed', 'pdfRenderError' => 'unavailable']);
+
+		$documents = new CredentialDocuments(europass: $europass, certificatePdf: $pdf);
+
+		self::assertSame(
+			expected: ['id' => 'c-2', 'pdfRenderStatus' => 'failed', 'pdfRenderError' => 'unavailable'],
+			actual: $documents->withPdf(credential: $credential, course: $course)
+		);
+	}//end testThePdfIsRenderedOnTheGivenCourse()
+}//end class
