+<?php
+
+/**
+ * Unit tests for ConfidentialityRestrictionController.
+ *
+ * @category Tests
+ * @package  OCA\Decidiq\Tests\Unit\Controller
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Tests\Unit\Controller;
+
+use OCA\Decidiq\Controller\ConfidentialityRestrictionController;
+use OCA\Decidiq\Exception\ConfidentialityRestrictionRefusedException;
+use OCA\Decidiq\Service\ConfidentialityRestrictionService;
+use OCP\IRequest;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * The controller passes the body through and answers the service's refusals.
+ */
+class ConfidentialityRestrictionControllerTest extends TestCase {
+
+	/**
+	 * A request answering these parameters.
+	 *
+	 * @param array<string, mixed> $params The parameters.
+	 *
+	 * @return IRequest
+	 */
+	private function request(array $params): IRequest {
+		$request = $this->createMock(IRequest::class);
+		$request->method('getParam')->willReturnCallback(fn (string $key, mixed $default=null): mixed => ($params[$key] ?? $default));
+		return $request;
+	}//end request()
+
+	/**
+	 * Impose takes scope and target from the path, the rest from the body, and answers 201 with the restriction.
+	 *
+	 * @return void
+	 */
+	public function testImposeAnswers201WithTheRestriction(): void {
+		$service = $this->createMock(ConfidentialityRestrictionService::class);
+		$service->expects(self::once())->method('impose')
+			->with(['scope' => 'item', 'target' => 'item-1', 'ground' => 'g-1', 'imposedBy' => 'body', 'imposedByBody' => 'body-1', 'ratificationDeadline' => ''])
+			->willReturn(['id' => 'r-1', 'lifecycle' => 'imposed']);
+
+		$controller = new ConfidentialityRestrictionController(
+			request: $this->request(['scope' => 'decision', 'target' => 'dec-9', 'ground' => 'g-1', 'imposedBy' => 'body', 'imposedByBody' => 'body-1', 'other' => 'x']),
+			restrictions: $service
+		);
+		$response = $controller->impose(scope: 'item', target: 'item-1');
+
+		self::assertSame(201, $response->getStatus());
+		self::assertSame(['id' => 'r-1', 'lifecycle' => 'imposed'], $response->getData());
+	}//end testImposeAnswers201WithTheRestriction()
+
+	/**
+	 * A refusal answers its status and message.
+	 *
+	 * @return void
+	 */
+	public function testARefusalAnswersItsStatus(): void {
+		$service = $this->createMock(ConfidentialityRestrictionService::class);
+		$service->method('ratify')->willThrowException(new ConfidentialityRestrictionRefusedException(message: 'No ratification needed.', status: 409));
+
+		$response = (new ConfidentialityRestrictionController(request: $this->request(['decision' => 'd-1']), restrictions: $service))->ratify(id: 'r-1');
+
+		self::assertSame(409, $response->getStatus());
+		self::assertSame(['message' => 'No ratification needed.'], $response->getData());
+	}//end testARefusalAnswersItsStatus()
+
+	/**
+	 * Dissolve passes the decision and the conditions; non-string conditions are dropped.
+	 *
+	 * @return void
+	 */
+	public function testDissolvePassesDecisionAndConditions(): void {
+		$service = $this->createMock(ConfidentialityRestrictionService::class);
+		$service->expects(self::exactly(2))->method('dissolve')
+			->willReturnCallback(fn (string $restrictionId, string $decisionId, ?string $conditions=null): array => [$restrictionId, $decisionId, $conditions]);
+
+		$withText = (new ConfidentialityRestrictionController(request: $this->request(['decision' => 'd-1', 'conditions' => 'after signing']), restrictions: $service))->dissolve(id: 'r-1');
+		$withList = (new ConfidentialityRestrictionController(request: $this->request(['decision' => 'd-1', 'conditions' => ['x']]), restrictions: $service))->dissolve(id: 'r-1');
+
+		self::assertSame(['r-1', 'd-1', 'after signing'], $withText->getData());
+		self::assertSame(['r-1', 'd-1', null], $withList->getData());
+	}//end testDissolvePassesDecisionAndConditions()
+}//end class
