+	private function input(array $overrides=[]): array {
+		return $overrides + ['scope' => 'decision', 'target' => 'dec-1', 'ground' => 'g-plain', 'imposedBy' => 'executive-board', 'imposedByBody' => 'body-1'];
+	}//end input()
+
+	/**
+	 * The status a refused call answers.
