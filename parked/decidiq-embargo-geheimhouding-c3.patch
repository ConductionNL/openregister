+
+		self::assertSame('item-1', $this->saved[0][1]['targetAgendaItem']);
+		self::assertSame([['agenda-item', 'item-1', ['confidentiality' => 'confidential', 'public' => false]]], $this->patches);
+	}//end testImposeOnAnItemSetsItsConfidentialityToConfidential()
+
+	/**
+	 * A ground that must be ratified puts the restriction on the next agenda, with that meeting's date as deadline.
+	 *
+	 * @return void
+	 */
+	public function testARatifiableGroundIsPlacedOnTheNextAgenda(): void {
+		$this->placement->expects(self::once())->method('place')
+			->with('r-1', 'body-1', 'Ratification of confidentiality: Municipal act 87')
+			->willReturn(['agendaItem' => 'ai-9', 'meeting' => 'm-3', 'meetingDate' => '2026-12-01T19:30:00+00:00']);
+
+		$restriction = $this->service()->impose(input: $this->input(['ground' => 'g-ratify', 'scope' => 'document', 'target' => 'doc-1']));
+
+		self::assertSame('ai-9', $restriction['ratificationAgendaItem']);
+		self::assertSame('2026-12-01T19:30:00+00:00', $restriction['ratificationDeadline']);
+		self::assertSame('imposed', $restriction['lifecycle']);
+		self::assertSame(['digital-document', 'doc-1', ['public' => false]], $this->patches[0]);
+	}//end testARatifiableGroundIsPlacedOnTheNextAgenda()
+
+	/**
+	 * A deadline the clerk gives overrides the meeting date.
+	 *
+	 * @return void
+	 */
+	public function testAGivenDeadlineOverridesTheMeetingDate(): void {
+		$this->placement->method('place')->willReturn(['agendaItem' => 'ai-9', 'meeting' => 'm-3', 'meetingDate' => '2026-12-01T19:30:00+00:00']);
+
+		$restriction = $this->service()->impose(input: $this->input(['ground' => 'g-ratify', 'ratificationDeadline' => '2026-12-15']));
+
+		self::assertSame('2026-12-15', $restriction['ratificationDeadline']);
+	}//end testAGivenDeadlineOverridesTheMeetingDate()
+
+	/**
+	 * Without the chair scope of the body, or anonymous, nothing is written.
+	 *
+	 * @return void
+	 */
+	public function testACallerWithoutAuthorityIsRefusedAndNothingIsWritten(): void {
+		$this->chair = false;
+		self::assertSame(403, $this->refusal(fn () => $this->service()->impose(input: $this->input())));
+
+		$this->uid = null;
+		self::assertSame(401, $this->refusal(fn () => $this->service()->impose(input: $this->input())));
+
+		self::assertSame([], $this->saved);
+		self::assertSame([], $this->patches);
+	}//end testACallerWithoutAuthorityIsRefusedAndNothingIsWritten()
+
+	/**
+	 * An administrator may act for any body.
+	 *
+	 * @return void
+	 */
+	public function testAnAdministratorMayImposeForAnyBody(): void {
+		$this->chair = false;
+		$this->admin = true;
+
+		$restriction = $this->service()->impose(input: $this->input(['imposedByBody' => 'body-2']));
+
+		self::assertSame('body-2', $restriction['imposedByBody']);
+	}//end testAnAdministratorMayImposeForAnyBody()
+
+	/**
+	 * No restriction without an active structured ground, or with an unknown target.
+	 *
+	 * @return void
+	 */
+	public function testAMissingOrInactiveGroundOrTargetIsRefused(): void {
+		self::assertSame(422, $this->refusal(fn () => $this->service()->impose(input: $this->input(['ground' => '']))));
+		self::assertSame(422, $this->refusal(fn () => $this->service()->impose(input: $this->input(['ground' => 'g-off']))));
+		self::assertSame(422, $this->refusal(fn () => $this->service()->impose(input: $this->input(['scope' => 'meeting']))));
+		self::assertSame(404, $this->refusal(fn () => $this->service()->impose(input: $this->input(['target' => 'dec-unknown']))));
+		self::assertSame([], $this->saved);
+	}//end testAMissingOrInactiveGroundOrTargetIsRefused()
+
+	/**
+	 * Ratifying links the decision and moves the lifecycle on.
+	 *
+	 * @return void
+	 */
+	public function testRatifyLinksTheDecisionAndMovesToRatified(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-ratify', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+
+		$restriction = $this->service()->ratify(restrictionId: 'r-7', decisionId: 'dec-1');
+
+		self::assertSame('ratified', $restriction['lifecycle']);
+		self::assertSame('dec-1', $restriction['ratificationDecision']);
+		self::assertSame('2026-11-17T10:00:00+00:00', $restriction['ratificationDate']);
+	}//end testRatifyLinksTheDecisionAndMovesToRatified()
+
+	/**
+	 * A ground without ratification answers 409; an unknown decision 422; an unknown restriction 404.
+	 *
+	 * @return void
+	 */
+	public function testRatifyRefusals(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-plain', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+		$this->objects['r-8'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-ratify', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+
+		self::assertSame(409, $this->refusal(fn () => $this->service()->ratify(restrictionId: 'r-7', decisionId: 'dec-1')));
+		self::assertSame(422, $this->refusal(fn () => $this->service()->ratify(restrictionId: 'r-8', decisionId: 'dec-unknown')));
+		self::assertSame(404, $this->refusal(fn () => $this->service()->ratify(restrictionId: 'r-unknown', decisionId: 'dec-1')));
+		self::assertSame([], $this->patches);
+	}//end testRatifyRefusals()
+
+	/**
+	 * Dissolving records the decision and conditions and returns the decision to internal, never public.
+	 *
+	 * @return void
+	 */
+	public function testDissolveRecordsTheDecisionAndReturnsTheTargetToInternal(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-ratify', 'imposedByBody' => 'body-1', 'lifecycle' => 'ratified']];
+		$this->objects['dec-1'][1]['isPublished'] = 'confidential';
+
+		$restriction = $this->service()->dissolve(restrictionId: 'r-7', decisionId: 'dec-1', conditions: ' after the contract is signed ');
+
+		self::assertSame('dissolved', $restriction['lifecycle']);
+		self::assertSame('dec-1', $restriction['dissolutionDecision']);
+		self::assertSame('after the contract is signed', $restriction['liftingConditions']);
+		self::assertSame('2026-11-17T10:00:00+00:00', $restriction['liftingDate']);
+		self::assertSame('internal', $this->objects['dec-1'][1]['isPublished']);
+	}//end testDissolveRecordsTheDecisionAndReturnsTheTargetToInternal()
+
+	/**
+	 * Dissolving a document leaves it closed: the publish flow opens it.
+	 *
+	 * @return void
+	 */
+	public function testDissolvingADocumentDoesNotPublishIt(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'document', 'targetDocument' => 'doc-1', 'ground' => 'g-plain', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+		$this->objects['doc-1'][1]['public'] = false;
+
+		$this->service()->dissolve(restrictionId: 'r-7', decisionId: 'dec-1');
+
+		self::assertFalse($this->objects['doc-1'][1]['public']);
+		self::assertSame([['confidentiality-restriction', 'r-7', ['lifecycle' => 'dissolved', 'dissolutionDecision' => 'dec-1', 'liftingDate' => '2026-11-17T10:00:00+00:00']]], $this->patches);
+	}//end testDissolvingADocumentDoesNotPublishIt()
+
+	/**
+	 * A ground that needs ratification cannot be dissolved straight from imposed, nor a dissolved one again.
+	 *
+	 * @return void
+	 */
+	public function testDissolveRefusesADirectLiftAndATerminalState(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-ratify', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+		$this->objects['r-8'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-plain', 'imposedByBody' => 'body-1', 'lifecycle' => 'dissolved']];
+		$this->objects['r-9'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-gone', 'imposedByBody' => 'body-1', 'lifecycle' => 'imposed']];
+
+		self::assertSame(409, $this->refusal(fn () => $this->service()->dissolve(restrictionId: 'r-7', decisionId: 'dec-1')));
+		self::assertSame(409, $this->refusal(fn () => $this->service()->dissolve(restrictionId: 'r-8', decisionId: 'dec-1')));
+		self::assertSame(409, $this->refusal(fn () => $this->service()->dissolve(restrictionId: 'r-9', decisionId: 'dec-1')), 'An unreadable ground keeps the restriction.');
+		self::assertSame([], $this->patches);
+	}//end testDissolveRefusesADirectLiftAndATerminalState()
+
+	/**
+	 * Without authority over the imposing body, ratify and dissolve are refused.
+	 *
+	 * @return void
+	 */
+	public function testRatifyAndDissolveCheckTheImposingBody(): void {
+		$this->objects['r-7'] = ['confidentiality-restriction', ['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-ratify', 'imposedByBody' => 'body-2', 'lifecycle' => 'ratified']];
+
+		self::assertSame(403, $this->refusal(fn () => $this->service()->ratify(restrictionId: 'r-7', decisionId: 'dec-1')));
+		self::assertSame(403, $this->refusal(fn () => $this->service()->dissolve(restrictionId: 'r-7', decisionId: 'dec-1')));
+		self::assertSame([], $this->patches);
+	}//end testRatifyAndDissolveCheckTheImposingBody()
+}//end class
