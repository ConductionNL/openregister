+<?php
+
+/**
+ * Unit tests for RatificationAgendaPlacement.
+ *
+ * @category Tests
+ * @package  OCA\Decidiq\Tests\Unit\Service
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Tests\Unit\Service;
+
+use DateTime;
+use OCA\Decidiq\Service\RatificationAgendaPlacement;
+use OCA\OpenRegister\Contract\ObjectServiceInterface;
+use OCA\OpenRegister\Db\ObjectEntity;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectSaveOptions;
+use OCP\AppFramework\Utility\ITimeFactory;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * The next scheduled meeting of a body, and the ratification item on it.
+ */
+class RatificationAgendaPlacementTest extends TestCase {
+
+	/**
+	 * Saved objects: [schema, payload, rbac].
+	 *
+	 * @var list<array{0: string, 1: array<string, mixed>, 2: bool}>
+	 */
+	private array $saved = [];
+
+	/**
+	 * The filters of each findAll call.
+	 *
+	 * @var list<array<string, mixed>>
+	 */
+	private array $queries = [];
+
+	/**
+	 * A placement over these meetings, with two items on every meeting.
+	 *
+	 * @param list<array<string, mixed>> $meetings The meetings the query returns.
+	 *
+	 * @return RatificationAgendaPlacement
+	 */
+	private function placement(array $meetings): RatificationAgendaPlacement {
+		$objects = $this->createMock(ObjectServiceInterface::class);
+		$objects->method('findAll')->willReturnCallback(
+			function (array $config=[], bool $_rbac=true, bool $_multitenancy=true) use ($meetings): array {
+				$this->queries[] = $config['filters'];
+				$rows = [['title' => 'One'], ['title' => 'Two']];
+				if ($config['filters']['schema'] === 'meeting') {
+					$rows = $meetings;
+				}
+
+				return array_map(
+					function (array $row): ObjectEntity {
+						$entity = new ObjectEntity();
+						$entity->setObject($row);
+						return $entity;
+					},
+					$rows
+				);
+			}
+		);
+		$objects->method('saveObject')->willReturnCallback(
+			function (array $object, ObjectSaveOptions $options=new ObjectSaveOptions(), bool $_rbac=true, bool $_multitenancy=true): ObjectEntity {
+				$this->saved[] = [(string)$options->target->schema, $object, $_rbac];
+				$entity = new ObjectEntity();
+				$entity->setUuid('ai-new');
+				$entity->setObject($object);
+				return $entity;
+			}
+		);
+
+		$time = $this->createMock(ITimeFactory::class);
+		$time->method('getDateTime')->willReturn(new DateTime('2026-11-17T10:00:00+00:00'));
+
+		return new RatificationAgendaPlacement(objectService: $objects, time: $time);
+	}//end placement()
+
+	/**
+	 * The earliest meeting still ahead wins; past and undated meetings are skipped.
+	 *
+	 * @return void
+	 */
+	public function testTheEarliestMeetingAheadIsChosen(): void {
+		$placement = $this->placement(
+			[
+				['id' => 'm-past', 'scheduledDate' => '2026-11-01T19:30:00+00:00'],
+				['id' => 'm-late', 'scheduledDate' => '2027-01-10T19:30:00+00:00'],
+				['id' => 'm-next', 'scheduledDate' => '2026-12-01T19:30:00+00:00'],
+				['id' => 'm-undated'],
+			]
+		);
+
+		self::assertSame(['id' => 'm-next', 'date' => '2026-12-01T19:30:00+00:00'], $placement->nextMeeting(bodyId: 'body-1'));
+		self::assertSame(['register' => 'decidiq', 'schema' => 'meeting', 'governanceBody' => 'body-1', 'lifecycle' => 'scheduled'], $this->queries[0]);
+	}//end testTheEarliestMeetingAheadIsChosen()
+
+	/**
+	 * The item lands last on that meeting, confidential and not public.
+	 *
+	 * @return void
+	 */
+	public function testThePlacedItemIsLastAndConfidential(): void {
+		$placed = $this->placement([['id' => 'm-next', 'scheduledDate' => '2026-12-01T19:30:00+00:00']])
+			->place(restrictionId: 'r-1', bodyId: 'body-1', title: 'Ratification');
+
+		self::assertSame(['agendaItem' => 'ai-new', 'meeting' => 'm-next', 'meetingDate' => '2026-12-01T19:30:00+00:00'], $placed);
+		self::assertSame('agenda-item', $this->saved[0][0]);
+		self::assertSame(
+			['title' => 'Ratification', 'itemType' => 'decision', 'orderNumber' => 3, 'meeting' => 'm-next', 'description' => 'Ratification of confidentiality restriction r-1', 'confidentiality' => 'confidential', 'public' => false],
+			$this->saved[0][1]
+		);
+	}//end testThePlacedItemIsLastAndConfidential()
+
+	/**
+	 * Without a meeting ahead, or without a body, nothing is placed.
+	 *
+	 * @return void
+	 */
+	public function testNoMeetingAheadPlacesNothing(): void {
+		$placement = $this->placement([['id' => 'm-past', 'scheduledDate' => '2026-01-01']]);
+
+		self::assertNull($placement->place(restrictionId: 'r-1', bodyId: 'body-1', title: 'Ratification'));
+		self::assertNull($placement->nextMeeting(bodyId: ''));
+		self::assertSame([], $this->saved);
+	}//end testNoMeetingAheadPlacesNothing()
+}//end class
