+use PHPUnit\Framework\TestCase;
+
+/**
+ * Impose, ratify and dissolve: authority, ground, classifier and placement.
+ */
+class ConfidentialityRestrictionServiceTest extends TestCase {
+
+	/**
+	 * Objects by uuid, as stored: [schema, payload].
+	 *
+	 * @var array<string, array{0: string, 1: array<string, mixed>}>
+	 */
+	private array $objects = [];
+
+	/**
+	 * The `_rbac` flag of each find, by uuid.
+	 *
+	 * @var array<string, bool>
+	 */
+	private array $findRbac = [];
+
+	/**
+	 * Saved objects: [schema, payload].
+	 *
+	 * @var list<array{0: string, 1: array<string, mixed>}>
+	 */
+	private array $saved = [];
+
+	/**
+	 * Patches: [schema, uuid, data].
+	 *
+	 * @var list<array{0: string, 1: string, 2: array<string, mixed>}>
+	 */
+	private array $patches = [];
+
+	/**
+	 * Whether the caller is an administrator.
+	 *
+	 * @var boolean
+	 */
+	private bool $admin = false;
+
+	/**
+	 * Whether the caller holds the chair scope of the body.
+	 *
+	 * @var boolean
+	 */
+	private bool $chair = true;
+
+	/**
+	 * The caller, or null when anonymous.
+	 *
+	 * @var string|null
+	 */
+	private ?string $uid = 'griffier';
+
+	/**
+	 * The placement double.
+	 *
+	 * @var RatificationAgendaPlacement&MockObject
+	 */
+	private RatificationAgendaPlacement&MockObject $placement;
+
+	/**
+	 * Seed the grounds, the targets and a decision.
+	 *
+	 * @return void
+	 */
+	protected function setUp(): void {
+		$this->objects = [
+			'g-ratify' => ['confidentiality-ground', ['name' => 'Municipal act 87', 'requiresRatification' => true, 'active' => true]],
+			'g-plain' => ['confidentiality-ground', ['name' => 'Information act 5.1', 'requiresRatification' => false, 'active' => true]],
+			'g-off' => ['confidentiality-ground', ['name' => 'Retired', 'requiresRatification' => false, 'active' => false]],
+			'dec-1' => ['decision', ['title' => 'A decision', 'isPublished' => 'internal']],
+			'item-1' => ['agenda-item', ['title' => 'An item', 'confidentiality' => 'internal']],
+			'doc-1' => ['digital-document', ['name' => 'A paper']],
+		];
+		$this->placement = $this->createMock(RatificationAgendaPlacement::class);
+	}//end setUp()
+
+	/**
+	 * The service under test, over the recording object service.
+	 *
+	 * @return ConfidentialityRestrictionService
+	 */
+	private function service(): ConfidentialityRestrictionService {
+		$objects = $this->createMock(ObjectServiceInterface::class);
+		$objects->method('find')->willReturnCallback(
+			function (int|string $id, ?ObjectFindOptions $options=null, bool $_rbac=true, bool $_multitenancy=true): ?ObjectEntity {
+				$this->findRbac[(string)$id] = $_rbac;
+				if (isset($this->objects[(string)$id]) === false || $this->objects[(string)$id][0] !== $options?->schema) {
+					return null;
+				}
+
+				return $this->entity(uuid: (string)$id, payload: $this->objects[(string)$id][1]);
+			}
+		);
+		$objects->method('saveObject')->willReturnCallback(
+			function (array $object, ObjectSaveOptions $options=new ObjectSaveOptions(), bool $_rbac=true, bool $_multitenancy=true): ObjectEntity {
+				$this->saved[] = [(string)$options->target->schema, $object];
+				$uuid = 'r-'.count($this->saved);
+				$this->objects[$uuid] = [(string)$options->target->schema, $object];
+				return $this->entity(uuid: $uuid, payload: $object);
+			}
+		);
+		$objects->method('patchObject')->willReturnCallback(
+			function (ObjectPatch $patch, bool $_rbac=true, bool $_multitenancy=true): ObjectEntity {
+				$this->patches[] = [(string)$patch->target->schema, $patch->objectId, $patch->data];
+				$current = ($this->objects[$patch->objectId][1] ?? []);
+				$this->objects[$patch->objectId][1] = array_merge($current, $patch->data);
+				return $this->entity(uuid: $patch->objectId, payload: $this->objects[$patch->objectId][1]);
+			}
+		);
+
+		$session = $this->createMock(IUserSession::class);
+		$user    = null;
+		if ($this->uid !== null) {
+			$user = $this->createMock(IUser::class);
+			$user->method('getUID')->willReturn($this->uid);
+		}
+
+		$session->method('getUser')->willReturn($user);
+		$groups = $this->createMock(IGroupManager::class);
+		$groups->method('isAdmin')->willReturnCallback(fn (): bool => $this->admin);
+		$scope = $this->createMock(GovernanceScopeGuardInterface::class);
+		$scope->method('isInBodyScope')->willReturnCallback(fn (string $userId, string $bodyId, string $scope): bool => $this->chair && $bodyId === 'body-1' && $scope === 'chair');
+		$time = $this->createMock(ITimeFactory::class);
+		$time->method('getDateTime')->willReturn(new DateTime('2026-11-17T10:00:00+00:00'));
+
+		return new ConfidentialityRestrictionService(
+			objectService: $objects,
+			userSession: $session,
+			groupManager: $groups,
+			scopeGuard: $scope,
+			classifier: new RestrictionTargetClassifier(objectService: $objects),
+			placement: $this->placement,
+			time: $time
+		);
+	}//end service()
+
+	/**
+	 * An entity with a uuid and a payload.
+	 *
+	 * @param string               $uuid    The uuid.
+	 * @param array<string, mixed> $payload The payload.
+	 *
+	 * @return ObjectEntity
+	 */
+	private function entity(string $uuid, array $payload): ObjectEntity {
+		$entity = new ObjectEntity();
+		$entity->setUuid($uuid);
+		$entity->setObject($payload);
+		return $entity;
+	}//end entity()
+
+	/**
