+<?php
+
+/**
+ * Decidiq Confidentiality Restriction Refused Exception
+ *
+ * An impose, ratify or dissolve request on a confidentiality restriction that
+ * cannot go ahead, with the HTTP status to answer.
+ *
+ * @category Exception
+ * @package  OCA\Decidiq\Exception
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Exception;
+
+/**
+ * A confidentiality restriction request that was refused.
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ */
+class ConfidentialityRestrictionRefusedException extends \RuntimeException {
+
+	/**
+	 * Constructor.
+	 *
+	 * @param string $message The reason, shown to the clerk.
+	 * @param int    $status  The HTTP status to answer.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function __construct(string $message, private readonly int $status=403) {
+		parent::__construct(message: $message);
+	}//end __construct()
+
+	/**
+	 * The HTTP status to answer.
+	 *
+	 * @return int The status.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function getStatus(): int {
+		return $this->status;
+	}//end getStatus()
+}//end class
diff --git a/lib/Service/ConfidentialityRestrictionService.php b/lib/Service/ConfidentialityRestrictionService.php
new file mode 100644
index 000000000..1cb451c14
--- /dev/null
+++ b/lib/Service/ConfidentialityRestrictionService.php
@@ -0,0 +1,510 @@
+<?php
+
+/**
+ * Decidiq Confidentiality Restriction Service
+ *
+ * Imposes, ratifies and dissolves confidentiality restrictions. Each action
+ * checks the caller's authority over the imposing body first, needs a
+ * structured ground, drives the target's existing classifier and, for a
+ * ground that must be ratified, puts the restriction on the confirming
+ * body's next agenda. Dissolving never publishes: the target returns to its
+ * non-public default and the normal publish flow takes it from there.
+ *
+ * @category Service
+ * @package  OCA\Decidiq\Service
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Service;
+
+use DateTimeInterface;
+use OCA\Decidiq\Exception\ConfidentialityRestrictionRefusedException;
+use OCA\Decidiq\Kernel\Contracts\GovernanceScopeGuardInterface;
+use OCA\Decidiq\Listener\EntityPayloadReader;
+use OCA\OpenRegister\Contract\ObjectServiceInterface;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectFindOptions;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectFindTarget;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectPatch;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectSaveOptions;
+use OCP\AppFramework\Http;
+use OCP\AppFramework\Utility\ITimeFactory;
+use OCP\IGroupManager;
+use OCP\IUserSession;
+
+/**
+ * The impose, ratify and dissolve actions on a confidentiality restriction.
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ */
+class ConfidentialityRestrictionService {
+
+	/**
+	 * The restriction schema slug.
+	 *
+	 * @var string
+	 */
+	public const SCHEMA = 'confidentiality-restriction';
+
+	/**
+	 * The ground schema slug.
+	 *
+	 * @var string
+	 */
+	public const GROUND_SCHEMA = 'confidentiality-ground';
+
+	/**
+	 * The organs that can impose a restriction.
+	 *
+	 * @var list<string>
+	 */
+	public const ORGANS = ['body', 'chair', 'executive-board'];
+
+	/**
+	 * Constructor.
+	 *
+	 * @param ObjectServiceInterface        $objectService The OpenRegister object service.
+	 * @param IUserSession                  $userSession   The caller.
+	 * @param IGroupManager                 $groupManager  Tells administrators apart.
+	 * @param GovernanceScopeGuardInterface $scopeGuard    Tells who holds the chair scope of a body.
+	 * @param RestrictionTargetClassifier   $classifier    Drives the target's classifier.
+	 * @param RatificationAgendaPlacement   $placement     Puts a restriction on the next agenda.
+	 * @param ITimeFactory                  $time          The clock.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function __construct(
+		private readonly ObjectServiceInterface $objectService,
+		private readonly IUserSession $userSession,
+		private readonly IGroupManager $groupManager,
+		private readonly GovernanceScopeGuardInterface $scopeGuard,
+		private readonly RestrictionTargetClassifier $classifier,
+		private readonly RatificationAgendaPlacement $placement,
+		private readonly ITimeFactory $time,
+	) {
+	}//end __construct()
+
+	/**
+	 * Impose a restriction on a document, an agenda item or a decision.
+	 *
+	 * Input: `scope`, `target`, `ground`, `imposedBy`, `imposedByBody`, and
+	 * optionally `ratificationDeadline` to override the meeting date.
+	 *
+	 * @param array<string, mixed> $input The request body.
+	 *
+	 * @return array<string, mixed> The stored restriction.
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 401, 403, 404 or 422 when it cannot be imposed.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function impose(array $input): array {
+		$bodyId = (string)($input['imposedByBody'] ?? '');
+		$this->assertAuthority(bodyId: $bodyId);
+
+		$scope = (string)($input['scope'] ?? '');
+		$organ = (string)($input['imposedBy'] ?? '');
+		$known = isset(RestrictionTargetClassifier::TARGET_SCHEMAS[$scope]);
+		if ($known === false || in_array($organ, self::ORGANS, true) === false) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'Give a scope of document, item or decision and the organ that imposes the restriction.',
+				status: Http::STATUS_UNPROCESSABLE_ENTITY
+			);
+		}
+
+		$targetId = (string)($input['target'] ?? '');
+		$ground   = $this->activeGround(groundId: (string)($input['ground'] ?? ''));
+		$this->assertReadableTarget(scope: $scope, targetId: $targetId);
+
+		$restriction = $this->create(
+			data: [
+				'scope' => $scope,
+				RestrictionTargetClassifier::TARGET_FIELDS[$scope] => $targetId,
+				'ground' => (string)$ground['id'],
+				'imposedBy' => $organ,
+				'imposedByBody' => $bodyId,
+				'imposedAt' => $this->now(),
+				'lifecycle' => 'imposed',
+			]
+		);
+		$this->classifier->close(scope: $scope, targetId: $targetId);
+
+		if ($this->requiresRatification(ground: $ground) === true) {
+			$restriction = $this->scheduleRatification(restriction: $restriction, ground: $ground, deadline: (string)($input['ratificationDeadline'] ?? ''));
+		}
+
+		return $restriction;
+	}//end impose()
+
+	/**
+	 * Record the confirming body's ratification decision.
+	 *
+	 * @param string $restrictionId The restriction's uuid.
+	 * @param string $decisionId    The ratification decision's uuid.
+	 *
+	 * @return array<string, mixed> The ratified restriction.
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 401, 403, 404, 409 or 422 when it cannot be ratified.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+	 */
+	public function ratify(string $restrictionId, string $decisionId): array {
+		$restriction = $this->authorisedRestriction(restrictionId: $restrictionId);
+		$ground      = $this->ground(groundId: (string)($restriction['ground'] ?? ''));
+		if ($this->requiresRatification(ground: $ground) === false) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'The ground of this restriction needs no ratification.',
+				status: Http::STATUS_CONFLICT
+			);
+		}
+
+		if (($restriction['lifecycle'] ?? '') !== 'imposed') {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'Only an imposed restriction can be ratified.',
+				status: Http::STATUS_CONFLICT
+			);
+		}
+
+		$this->assertDecision(decisionId: $decisionId);
+
+		return $this->patch(
+			restrictionId: $restrictionId,
+			data: ['lifecycle' => 'ratified', 'ratificationDecision' => $decisionId, 'ratificationDate' => $this->now()]
+		);
+	}//end ratify()
+
+	/**
+	 * Dissolve a restriction on a dissolution decision; the target becomes eligible, never public.
+	 *
+	 * @param string      $restrictionId The restriction's uuid.
+	 * @param string      $decisionId    The dissolution decision's uuid.
+	 * @param string|null $conditions    Optional conditions attached to the dissolution.
+	 *
+	 * @return array<string, mixed> The dissolved restriction.
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 401, 403, 404, 409 or 422 when it cannot be dissolved.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-004-opheffing-workflow-routing-into-the-normal-publication-machinery
+	 */
+	public function dissolve(string $restrictionId, string $decisionId, ?string $conditions=null): array {
+		$restriction = $this->authorisedRestriction(restrictionId: $restrictionId);
+		$this->assertDissolvable(restriction: $restriction);
+		$this->assertDecision(decisionId: $decisionId);
+
+		$data = ['lifecycle' => 'dissolved', 'dissolutionDecision' => $decisionId, 'liftingDate' => $this->now()];
+		if ($conditions !== null && trim($conditions) !== '') {
+			$data['liftingConditions'] = trim($conditions);
+		}
+
+		$dissolved = $this->patch(restrictionId: $restrictionId, data: $data);
+		$scope     = (string)($restriction['scope'] ?? '');
+		$this->classifier->reopen(scope: $scope, targetId: $this->targetOf(restriction: $restriction));
+
+		return $dissolved;
+	}//end dissolve()
+
+	/**
+	 * Refuse a dissolution from a terminal state, or a direct one where the ground needs ratification first.
+	 *
+	 * @param array<string, mixed> $restriction The restriction.
+	 *
+	 * @return void
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 409 when it cannot be dissolved now.
+	 */
+	private function assertDissolvable(array $restriction): void {
+		$state = (string)($restriction['lifecycle'] ?? '');
+		if (in_array($state, ['imposed', 'ratified'], true) === false) {
+			throw new ConfidentialityRestrictionRefusedException(message: 'This restriction is already dissolved.', status: Http::STATUS_CONFLICT);
+		}
+
+		$ground = $this->ground(groundId: (string)($restriction['ground'] ?? ''));
+		if ($state === 'imposed' && $this->requiresRatification(ground: $ground) === true) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'The ground of this restriction needs ratification before it can be dissolved.',
+				status: Http::STATUS_CONFLICT
+			);
+		}
+	}//end assertDissolvable()
+
+	/**
+	 * Place a restriction for ratification and record the deadline and the agenda item.
+	 *
+	 * @param array<string, mixed> $restriction The stored restriction.
+	 * @param array<string, mixed> $ground      Its ground.
+	 * @param string               $deadline    A deadline the clerk gave, or ''.
+	 *
+	 * @return array<string, mixed> The restriction with its ratification fields.
+	 */
+	private function scheduleRatification(array $restriction, array $ground, string $deadline): array {
+		$placed = $this->placement->place(
+			restrictionId: (string)$restriction['id'],
+			bodyId: (string)$restriction['imposedByBody'],
+			title: 'Ratification of confidentiality: '.(string)($ground['name'] ?? '')
+		);
+
+		$data = [];
+		if ($placed !== null) {
+			$data['ratificationAgendaItem'] = $placed['agendaItem'];
+			$data['ratificationDeadline']   = $placed['meetingDate'];
+		}
+
+		if (trim($deadline) !== '') {
+			$data['ratificationDeadline'] = trim($deadline);
+		}
+
+		if ($data === []) {
+			return $restriction;
+		}
+
+		return $this->patch(restrictionId: (string)$restriction['id'], data: $data);
+	}//end scheduleRatification()
+
+	/**
+	 * Admin, or the chair scope of the imposing body; otherwise refused.
+	 *
+	 * @param string $bodyId The imposing body's uuid.
+	 *
+	 * @return void
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 401 without a user, 403 without authority.
+	 */
+	private function assertAuthority(string $bodyId): void {
+		$user = $this->userSession->getUser();
+		if ($user === null) {
+			throw new ConfidentialityRestrictionRefusedException(message: 'Authentication required.', status: Http::STATUS_UNAUTHORIZED);
+		}
+
+		$uid = $user->getUID();
+		if ($this->groupManager->isAdmin($uid) === true) {
+			return;
+		}
+
+		if ($this->scopeGuard->isInBodyScope(userId: $uid, bodyId: $bodyId, scope: 'chair') === false) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'You may not impose, ratify or dissolve restrictions for this body.',
+				status: Http::STATUS_FORBIDDEN
+			);
+		}
+	}//end assertAuthority()
+
+	/**
+	 * The restriction, once the caller's authority over its body is checked.
+	 *
+	 * @param string $restrictionId The restriction's uuid.
+	 *
+	 * @return array<string, mixed>
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 401, 403 or 404.
+	 */
+	private function authorisedRestriction(string $restrictionId): array {
+		if ($this->userSession->getUser() === null) {
+			throw new ConfidentialityRestrictionRefusedException(message: 'Authentication required.', status: Http::STATUS_UNAUTHORIZED);
+		}
+
+		$restriction = $this->load(id: $restrictionId, schema: self::SCHEMA, rbac: false);
+		if ($restriction === null) {
+			throw new ConfidentialityRestrictionRefusedException(message: 'The restriction does not exist.', status: Http::STATUS_NOT_FOUND);
+		}
+
+		$this->assertAuthority(bodyId: (string)($restriction['imposedByBody'] ?? ''));
+
+		return $restriction;
+	}//end authorisedRestriction()
+
+	/**
+	 * A ground that can be chosen for a new restriction.
+	 *
+	 * @param string $groundId The ground's uuid.
+	 *
+	 * @return array<string, mixed>
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 422 when there is no such active ground.
+	 */
+	private function activeGround(string $groundId): array {
+		$ground = $this->load(id: $groundId, schema: self::GROUND_SCHEMA, rbac: false);
+		if ($ground === null || ($ground['active'] ?? true) === false) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'Choose an active ground for the restriction.',
+				status: Http::STATUS_UNPROCESSABLE_ENTITY
+			);
+		}
+
+		$ground['id'] = (string)($ground['id'] ?? $groundId);
+
+		return $ground;
+	}//end activeGround()
+
+	/**
+	 * A restriction's ground, active or not; [] when it cannot be found.
+	 *
+	 * @param string $groundId The ground's uuid.
+	 *
+	 * @return array<string, mixed>
+	 */
+	private function ground(string $groundId): array {
+		return ($this->load(id: $groundId, schema: self::GROUND_SCHEMA, rbac: false) ?? []);
+	}//end ground()
+
+	/**
+	 * Whether a ground needs ratification; a ground that cannot be read counts as needing it.
+	 *
+	 * @param array<string, mixed> $ground The ground.
+	 *
+	 * @return bool
+	 */
+	private function requiresRatification(array $ground): bool {
+		if ($ground === []) {
+			return true;
+		}
+
+		return ($ground['requiresRatification'] ?? false) === true;
+	}//end requiresRatification()
+
+	/**
+	 * Refuse a target the caller cannot read.
+	 *
+	 * @param string $scope    The restriction scope.
+	 * @param string $targetId The target's uuid.
+	 *
+	 * @return void
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 404 when the caller cannot read it.
+	 */
+	private function assertReadableTarget(string $scope, string $targetId): void {
+		$target = null;
+		if ($targetId !== '') {
+			$target = $this->load(id: $targetId, schema: RestrictionTargetClassifier::TARGET_SCHEMAS[$scope], rbac: true);
+		}
+
+		if ($target === null) {
+			throw new ConfidentialityRestrictionRefusedException(message: 'The object to restrict does not exist.', status: Http::STATUS_NOT_FOUND);
+		}
+	}//end assertReadableTarget()
+
+	/**
+	 * Refuse a decision reference that does not resolve.
+	 *
+	 * @param string $decisionId The decision's uuid.
+	 *
+	 * @return void
+	 *
+	 * @throws ConfidentialityRestrictionRefusedException 422 when it does not exist.
+	 */
+	private function assertDecision(string $decisionId): void {
+		if ($decisionId === '' || $this->load(id: $decisionId, schema: 'decision', rbac: false) === null) {
+			throw new ConfidentialityRestrictionRefusedException(
+				message: 'Link the decision this is based on.',
+				status: Http::STATUS_UNPROCESSABLE_ENTITY
+			);
+		}
+	}//end assertDecision()
+
+	/**
+	 * The target uuid a restriction points at.
+	 *
+	 * @param array<string, mixed> $restriction The restriction.
+	 *
+	 * @return string
+	 */
+	private function targetOf(array $restriction): string {
+		$field = (RestrictionTargetClassifier::TARGET_FIELDS[(string)($restriction['scope'] ?? '')] ?? '');
+		if ($field === '') {
+			return '';
+		}
+
+		return (string)($restriction[$field] ?? '');
+	}//end targetOf()
+
+	/**
+	 * Create a restriction as the system, once the caller's authority is checked.
+	 *
+	 * @param array<string, mixed> $data The restriction.
+	 *
+	 * @return array<string, mixed>
+	 */
+	private function create(array $data): array {
+		$entity = $this->objectService->saveObject(
+			object: $data,
+			options: new ObjectSaveOptions(target: new ObjectFindTarget(register: 'decidiq', schema: self::SCHEMA)),
+			_rbac: false,
+			_multitenancy: false
+		);
+
+		return ['id' => (string)$entity->getUuid()] + (new EntityPayloadReader())->payloadOf(entity: $entity) + $data;
+	}//end create()
+
+	/**
+	 * Patch a restriction as the system, carrying every other field.
+	 *
+	 * @param string               $restrictionId The restriction's uuid.
+	 * @param array<string, mixed> $data          The fields to set.
+	 *
+	 * @return array<string, mixed>
+	 */
+	private function patch(string $restrictionId, array $data): array {
+		$entity = $this->objectService->patchObject(
+			patch: new ObjectPatch(
+				objectId: $restrictionId,
+				data: $data,
+				target: new ObjectFindTarget(register: 'decidiq', schema: self::SCHEMA)
+			),
+			_rbac: false,
+			_multitenancy: false
+		);
+
+		return ['id' => $restrictionId] + (new EntityPayloadReader())->payloadOf(entity: $entity);
+	}//end patch()
+
+	/**
+	 * An object's data, or null when it does not exist or cannot be read.
+	 *
+	 * @param string $id     The uuid.
+	 * @param string $schema The schema slug.
+	 * @param bool   $rbac   Whether the caller's read rights apply.
+	 *
+	 * @return array<string, mixed>|null
+	 */
+	private function load(string $id, string $schema, bool $rbac): ?array {
+		if ($id === '') {
+			return null;
+		}
+
+		try {
+			$entity = $this->objectService->find(
+				id: $id,
+				options: new ObjectFindOptions(register: 'decidiq', schema: $schema),
+				_rbac: $rbac,
+				_multitenancy: $rbac
+			);
+		} catch (\Throwable) {
+			return null;
+		}
+
+		if ($entity === null) {
+			return null;
+		}
+
+		return (new EntityPayloadReader())->payloadOf(entity: $entity);
+	}//end load()
+
+	/**
+	 * The current time as ISO 8601.
+	 *
+	 * @return string
+	 */
+	private function now(): string {
+		return $this->time->getDateTime()->format(DateTimeInterface::ATOM);
+	}//end now()
+}//end class
diff --git a/lib/Service/RatificationAgendaPlacement.php b/lib/Service/RatificationAgendaPlacement.php
new file mode 100644
index 000000000..864e55f49
--- /dev/null
+++ b/lib/Service/RatificationAgendaPlacement.php
@@ -0,0 +1,195 @@
+<?php
+
+/**
+ * Decidiq Ratification Agenda Placement
+ *
+ * Puts a confidentiality restriction that must be ratified on the agenda of
+ * the confirming body's next scheduled meeting, and tells the deadline that
+ * meeting sets.
+ *
+ * @category Service
+ * @package  OCA\Decidiq\Service
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Service;
+
+use DateTimeImmutable;
+use DateTimeInterface;
+use OCA\Decidiq\Listener\EntityPayloadReader;
+use OCA\OpenRegister\Contract\ObjectServiceInterface;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectFindTarget;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectSaveOptions;
+use OCP\AppFramework\Utility\ITimeFactory;
+
+/**
+ * Finds the next meeting of a body and places a ratification item on it.
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+ */
+class RatificationAgendaPlacement {
+
+	/**
+	 * The most meetings or items read for one placement.
+	 *
+	 * @var integer
+	 */
+	private const LIMIT = 500;
+
+	/**
+	 * Constructor.
+	 *
+	 * @param ObjectServiceInterface $objectService Reads meetings and items, writes the item.
+	 * @param ITimeFactory           $time          The clock.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+	 */
+	public function __construct(
+		private readonly ObjectServiceInterface $objectService,
+		private readonly ITimeFactory $time,
+	) {
+	}//end __construct()
+
+	/**
+	 * Place the restriction on the body's next scheduled meeting.
+	 *
+	 * @param string $restrictionId The restriction's uuid.
+	 * @param string $bodyId        The confirming body's uuid.
+	 * @param string $title         The agenda item's title.
+	 *
+	 * @return array{agendaItem: string, meeting: string, meetingDate: string}|null The placement, or null when the body has no scheduled meeting ahead.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+	 */
+	public function place(string $restrictionId, string $bodyId, string $title): ?array {
+		$meeting = $this->nextMeeting(bodyId: $bodyId);
+		if ($meeting === null) {
+			return null;
+		}
+
+		$item = $this->objectService->saveObject(
+			object: [
+				'title' => $title,
+				'itemType' => 'decision',
+				'orderNumber' => ($this->itemCount(meetingId: $meeting['id']) + 1),
+				'meeting' => $meeting['id'],
+				'description' => 'Ratification of confidentiality restriction '.$restrictionId,
+				'confidentiality' => 'confidential',
+				'public' => false,
+			],
+			options: new ObjectSaveOptions(target: new ObjectFindTarget(register: 'decidiq', schema: 'agenda-item')),
+			_rbac: false,
+			_multitenancy: false
+		);
+
+		return [
+			'agendaItem' => (string)$item->getUuid(),
+			'meeting' => $meeting['id'],
+			'meetingDate' => $meeting['date'],
+		];
+	}//end place()
+
+	/**
+	 * The body's earliest scheduled meeting from now on, or null.
+	 *
+	 * @param string $bodyId The body's uuid.
+	 *
+	 * @return array{id: string, date: string}|null
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+	 */
+	public function nextMeeting(string $bodyId): ?array {
+		if ($bodyId === '') {
+			return null;
+		}
+
+		$meetings = $this->objectService->findAll(
+			config: [
+				'filters' => ['register' => 'decidiq', 'schema' => 'meeting', 'governanceBody' => $bodyId, 'lifecycle' => 'scheduled'],
+				'limit' => self::LIMIT,
+			],
+			_rbac: false,
+			_multitenancy: false
+		);
+
+		$now  = $this->time->getDateTime()->getTimestamp();
+		$next = null;
+		foreach ($meetings as $meeting) {
+			$candidate = $this->candidate(meeting: $meeting, now: $now);
+			if ($candidate !== null && ($next === null || $candidate['at'] < $next['at'])) {
+				$next = $candidate;
+			}
+		}
+
+		if ($next === null) {
+			return null;
+		}
+
+		return ['id' => $next['id'], 'date' => $next['date']];
+	}//end nextMeeting()
+
+	/**
+	 * A meeting that is still ahead, with its time, or null.
+	 *
+	 * @param object $meeting The meeting entity.
+	 * @param int    $now     The current timestamp.
+	 *
+	 * @return array{id: string, date: string, at: int}|null
+	 */
+	private function candidate(object $meeting, int $now): ?array {
+		$data = (new EntityPayloadReader())->payloadOf(entity: $meeting);
+		$date = (string)($data['scheduledDate'] ?? '');
+		$id   = (string)($data['id'] ?? '');
+		if ($id === '' && method_exists($meeting, 'getUuid') === true) {
+			$id = (string)$meeting->getUuid();
+		}
+
+		if ($date === '' || $id === '') {
+			return null;
+		}
+
+		try {
+			$at = (new DateTimeImmutable($date))->getTimestamp();
+		} catch (\Exception) {
+			return null;
+		}
+
+		if ($at < $now) {
+			return null;
+		}
+
+		return ['id' => $id, 'date' => (new DateTimeImmutable($date))->format(DateTimeInterface::ATOM), 'at' => $at];
+	}//end candidate()
+
+	/**
+	 * How many agenda items a meeting has.
+	 *
+	 * @param string $meetingId The meeting's uuid.
+	 *
+	 * @return int
+	 */
+	private function itemCount(string $meetingId): int {
+		return count(
+			$this->objectService->findAll(
+				config: [
+					'filters' => ['register' => 'decidiq', 'schema' => 'agenda-item', 'meeting' => $meetingId],
+					'limit' => self::LIMIT,
+				],
+				_rbac: false,
+				_multitenancy: false
+			)
+		);
+	}//end itemCount()
+}//end class
diff --git a/lib/Service/RestrictionTargetClassifier.php b/lib/Service/RestrictionTargetClassifier.php
new file mode 100644
index 000000000..290a87201
--- /dev/null
+++ b/lib/Service/RestrictionTargetClassifier.php
@@ -0,0 +1,150 @@
+<?php
+
+/**
+ * Decidiq Restriction Target Classifier
+ *
+ * Drives the existing confidentiality classifier of the object a
+ * confidentiality restriction targets: closed while the restriction is
+ * active, back to its non-public default once it is dissolved. It never makes
+ * a target public; publishing stays the publish flow's job.
+ *
+ * @category Service
+ * @package  OCA\Decidiq\Service
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Service;
+
+use OCA\OpenRegister\Contract\ObjectServiceInterface;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectFindTarget;
+use OCA\OpenRegister\Kernel\Contracts\Value\ObjectPatch;
+
+/**
+ * Sets and resets the classifier fields of a restriction's target.
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ */
+class RestrictionTargetClassifier {
+
+	/**
+	 * The schema slug of each scope's target.
+	 *
+	 * @var array<string, string>
+	 */
+	public const TARGET_SCHEMAS = [
+		'document' => 'digital-document',
+		'item' => 'agenda-item',
+		'decision' => 'decision',
+	];
+
+	/**
+	 * The restriction field holding each scope's target reference.
+	 *
+	 * @var array<string, string>
+	 */
+	public const TARGET_FIELDS = [
+		'document' => 'targetDocument',
+		'item' => 'targetAgendaItem',
+		'decision' => 'targetDecision',
+	];
+
+	/**
+	 * The fields set on a target while a restriction on it is active.
+	 *
+	 * @var array<string, array<string, mixed>>
+	 */
+	private const CLOSED = [
+		'document' => ['public' => false],
+		'item' => ['confidentiality' => 'confidential', 'public' => false],
+		'decision' => ['isPublished' => 'confidential'],
+	];
+
+	/**
+	 * The fields set on a target once its restriction is dissolved: the
+	 * non-public default, never public. A document keeps `public: false`.
+	 *
+	 * @var array<string, array<string, mixed>>
+	 */
+	private const REOPENED = [
+		'document' => [],
+		'item' => ['confidentiality' => 'internal'],
+		'decision' => ['isPublished' => 'internal'],
+	];
+
+	/**
+	 * Constructor.
+	 *
+	 * @param ObjectServiceInterface $objectService Writes the target's classifier.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function __construct(
+		private readonly ObjectServiceInterface $objectService,
+	) {
+	}//end __construct()
+
+	/**
+	 * Close the target of an active restriction.
+	 *
+	 * @param string $scope    `document`, `item` or `decision`.
+	 * @param string $targetId The target's uuid.
+	 *
+	 * @return void
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function close(string $scope, string $targetId): void {
+		$this->patch(scope: $scope, targetId: $targetId, fields: (self::CLOSED[$scope] ?? []));
+	}//end close()
+
+	/**
+	 * Return the target of a dissolved restriction to its non-public default.
+	 *
+	 * @param string $scope    `document`, `item` or `decision`.
+	 * @param string $targetId The target's uuid.
+	 *
+	 * @return void
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-004-opheffing-workflow-routing-into-the-normal-publication-machinery
+	 */
+	public function reopen(string $scope, string $targetId): void {
+		$this->patch(scope: $scope, targetId: $targetId, fields: (self::REOPENED[$scope] ?? []));
+	}//end reopen()
+
+	/**
+	 * Patch the target's fields as the system, carrying every other field.
+	 *
+	 * @param string               $scope    The restriction scope.
+	 * @param string               $targetId The target's uuid.
+	 * @param array<string, mixed> $fields   The fields to set.
+	 *
+	 * @return void
+	 */
+	private function patch(string $scope, string $targetId, array $fields): void {
+		if ($fields === [] || isset(self::TARGET_SCHEMAS[$scope]) === false || $targetId === '') {
+			return;
+		}
+
+		$this->objectService->patchObject(
+			patch: new ObjectPatch(
+				objectId: $targetId,
+				data: $fields,
+				target: new ObjectFindTarget(register: 'decidiq', schema: self::TARGET_SCHEMAS[$scope])
+			),
+			_rbac: false,
+			_multitenancy: false
+		);
+	}//end patch()
+}//end class
