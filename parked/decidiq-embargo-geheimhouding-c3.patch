@@ -0,0 +1,146 @@
+<?php
+
+/**
+ * Decidiq Confidentiality Restriction Controller
+ *
+ * The impose, ratify and dissolve actions on a confidentiality restriction.
+ * Reading and listing restrictions stays on the OpenRegister object API.
+ *
+ * @category Controller
+ * @package  OCA\Decidiq\Controller
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Decidiq\Controller;
+
+use OCA\Decidiq\Exception\ConfidentialityRestrictionRefusedException;
+use OCA\Decidiq\Kernel\AppIdentity;
+use OCA\Decidiq\Service\ConfidentialityRestrictionService;
+use OCP\AppFramework\Controller;
+use OCP\AppFramework\Http;
+use OCP\AppFramework\Http\Attribute\NoAdminRequired;
+use OCP\AppFramework\Http\JSONResponse;
+use OCP\IRequest;
+
+/**
+ * Impose, ratify and dissolve confidentiality restrictions.
+ *
+ * Access control: per-object guard in ConfidentialityRestrictionService for
+ * every action: 401 when anonymous, 403 unless the caller is an
+ * administrator or holds the chair scope of the imposing body.
+ *
+ * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+ */
+class ConfidentialityRestrictionController extends Controller {
+
+	/**
+	 * Constructor.
+	 *
+	 * @param IRequest                          $request      The request.
+	 * @param ConfidentialityRestrictionService $restrictions Checks and performs the actions.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	public function __construct(
+		IRequest $request,
+		private readonly ConfidentialityRestrictionService $restrictions,
+	) {
+		parent::__construct(appName: AppIdentity::APP_ID, request: $request);
+	}//end __construct()
+
+	/**
+	 * Impose a restriction.
+	 *
+	 * POST /api/confidentiality-restrictions/{scope}/{target}
+	 * Body: { ground, imposedBy, imposedByBody, ratificationDeadline? }
+	 *
+	 * @param string $scope  `document`, `item` or `decision`.
+	 * @param string $target The uuid of the object to restrict.
+	 *
+	 * @return JSONResponse 201 the restriction; 401, 403, 404 or 422 with a message.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-001-geheimhouding-record-with-structured-legal-ground
+	 */
+	#[NoAdminRequired]
+	public function impose(string $scope, string $target): JSONResponse {
+		$input = ['scope' => $scope, 'target' => $target];
+		foreach (['ground', 'imposedBy', 'imposedByBody', 'ratificationDeadline'] as $key) {
+			$input[$key] = (string)$this->request->getParam($key, '');
+		}
+
+		return $this->answer(action: fn (): array => $this->restrictions->impose(input: $input), status: Http::STATUS_CREATED);
+	}//end impose()
+
+	/**
+	 * Ratify a restriction on the confirming body's decision.
+	 *
+	 * POST /api/confidentiality-restrictions/{id}/ratify
+	 * Body: { decision }
+	 *
+	 * @param string $id The restriction.
+	 *
+	 * @return JSONResponse 200 the restriction; 401, 403, 404, 409 or 422 with a message.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-003-bekrachtiging-workflow-with-fail-visible-overdue-flag
+	 */
+	#[NoAdminRequired]
+	public function ratify(string $id): JSONResponse {
+		$decision = (string)$this->request->getParam('decision', '');
+
+		return $this->answer(action: fn (): array => $this->restrictions->ratify(restrictionId: $id, decisionId: $decision), status: Http::STATUS_OK);
+	}//end ratify()
+
+	/**
+	 * Dissolve a restriction on a dissolution decision.
+	 *
+	 * POST /api/confidentiality-restrictions/{id}/dissolve
+	 * Body: { decision, conditions? }
+	 *
+	 * @param string $id The restriction.
+	 *
+	 * @return JSONResponse 200 the restriction; 401, 403, 404, 409 or 422 with a message.
+	 *
+	 * @spec openspec/changes/embargo-geheimhouding/specs/embargo-geheimhouding/spec.md#requirement-req-emb-004-opheffing-workflow-routing-into-the-normal-publication-machinery
+	 */
+	#[NoAdminRequired]
+	public function dissolve(string $id): JSONResponse {
+		$decision   = (string)$this->request->getParam('decision', '');
+		$conditions = $this->request->getParam('conditions');
+		if (is_string($conditions) === false) {
+			$conditions = null;
+		}
+
+		return $this->answer(
+			action: fn (): array => $this->restrictions->dissolve(restrictionId: $id, decisionId: $decision, conditions: $conditions),
+			status: Http::STATUS_OK
+		);
+	}//end dissolve()
+
+	/**
+	 * Run an action and answer with its result or its refusal.
+	 *
+	 * @param callable $action The action, returning the restriction.
+	 * @param int      $status The status on success.
+	 *
+	 * @return JSONResponse
+	 */
+	private function answer(callable $action, int $status): JSONResponse {
+		try {
+			return new JSONResponse($action(), $status);
+		} catch (ConfidentialityRestrictionRefusedException $e) {
+			return new JSONResponse(['message' => $e->getMessage()], $e->getStatus());
+		}
+	}//end answer()
+}//end class
