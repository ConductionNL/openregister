+	 * @param callable $call The call.
+	 *
+	 * @return int
+	 */
+	private function refusal(callable $call): int {
+		try {
+			$call();
+		} catch (ConfidentialityRestrictionRefusedException $e) {
+			return $e->getStatus();
+		}
+
+		self::fail('The call was not refused.');
+	}//end refusal()
+
+	/**
+	 * Imposing on a decision stores the restriction and closes the decision.
+	 *
+	 * @return void
+	 */
+	public function testImposeOnADecisionStoresTheRecordAndClosesTheDecision(): void {
+		$this->placement->expects(self::never())->method('place');
+
+		$restriction = $this->service()->impose(input: $this->input());
+
+		self::assertSame('r-1', $restriction['id']);
+		self::assertSame(
+			['scope' => 'decision', 'targetDecision' => 'dec-1', 'ground' => 'g-plain', 'imposedBy' => 'executive-board', 'imposedByBody' => 'body-1', 'imposedAt' => '2026-11-17T10:00:00+00:00', 'lifecycle' => 'imposed'],
+			$this->saved[0][1]
+		);
+		self::assertSame('confidentiality-restriction', $this->saved[0][0]);
+		self::assertSame([['decision', 'dec-1', ['isPublished' => 'confidential']]], $this->patches);
+		self::assertSame(['title' => 'A decision', 'isPublished' => 'confidential'], $this->objects['dec-1'][1]);
+		self::assertTrue($this->findRbac['dec-1'], 'The target is read with the caller\'s rights.');
+	}//end testImposeOnADecisionStoresTheRecordAndClosesTheDecision()
+
+	/**
+	 * Imposing on an agenda item drives its existing confidentiality enum.
+	 *
+	 * @return void
