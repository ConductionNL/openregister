+<?php
+
+/**
+ * Unit tests for SetupTemplates (configuration-store, REQ-FTS-006 and REQ-FTS-007).
+ *
+ * The store controller is a small fake with the two methods the routes reach
+ * on OpenRegister's GenericStoreController, `search()` and `install(slug:)`:
+ * the tests show which cards the Sjablonen step offers and what an install
+ * reports, without OpenRegister.
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Humaniq\Tests\Unit\Service\Setup;
+
+use OCA\Humaniq\Service\Setup\SetupTemplates;
+use OCP\AppFramework\Http\JSONResponse;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Psr\Container\ContainerInterface;
+use Psr\Log\LoggerInterface;
+use RuntimeException;
+
+/**
+ * The Sjablonen step's cards and installs, through the store plane.
+ */
+#[CoversClass(SetupTemplates::class)]
+class SetupTemplatesTest extends TestCase {
+
+	/**
+	 * Built-in items and published cards become one card each, then "No templates".
+	 *
+	 * @return void
+	 */
+	public function testTheCardsAreTheStoresItemsThenNone(): void {
+		$store = $this->store(search: [
+			'outcome' => 'ok',
+			'builtIn' => [['slug' => 'leave-policy-basic', 'title' => 'Basic leave policy', 'description' => 'Statutory leave only.']],
+			'cards'   => [
+				['slug' => 'review-cycle', 'title' => 'Yearly review cycle'],
+				['slug' => 'leave-policy-basic', 'title' => 'Same slug again'],
+				['slug' => 'Not A Slug', 'title' => 'Refused'],
+				'not an entry',
+			],
+		]);
+
+		$choices = $this->templates(store: $store)->listChoices();
+
+		$this->assertSame(['leave-policy-basic', 'review-cycle', 'none'], array_column($choices, 'id'));
+		$this->assertSame('Basic leave policy', $choices[0]['name']);
+		$this->assertSame('Statutory leave only.', $choices[0]['description']);
+		$this->assertSame('Yearly review cycle', $choices[1]['name']);
+		$this->assertSame('', $choices[1]['description']);
+		$this->assertSame('No templates', $choices[2]['name']);
+	}//end testTheCardsAreTheStoresItemsThenNone()
+
+	/**
+	 * With no registry the store answers not_configured with the built-in
+	 * items only, and so does the step.
+	 *
+	 * @return void
+	 */
+	public function testWithNoRegistryOnlyTheOwnItemsAreOffered(): void {
+		$store = $this->store(search: [
+			'outcome' => 'not_configured',
+			'cards'   => [],
+			'builtIn' => [['slug' => 'leave-policy-basic', 'title' => 'Basic leave policy']],
+		]);
+
+		$this->assertSame(['leave-policy-basic', 'none'], array_column($this->templates(store: $store)->listChoices(), 'id'));
+		$this->assertSame(1, $store->searches);
+	}//end testWithNoRegistryOnlyTheOwnItemsAreOffered()
