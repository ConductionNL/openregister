+	/**
+	 * The Sjablonen step's cards. While the step is open they come from the
+	 * store (one search, no network call without a registry); once answered
+	 * they are the sets it installed plus "no templates", so the setup gate's
+	 * status read on every page does not search a registry again.
+	 *
+	 * @param bool $answered Whether the step has its answer.
+	 *
+	 * @return list<array<string, string>>
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#requirement-the-setup-wizard-shall-offer-a-sjablonen-step-that-installs-chosen-sets-req-fts-007
+	 */
+	private function templateChoices(bool $answered): array {
+		if ($this->templates === null) {
+			return [];
+		}
+
+		if ($answered === false) {
+			return $this->templates->listChoices();
+		}
+
+		$installed = json_decode($this->appConfig->getValueString(Application::APP_ID, self::TEMPLATES_INSTALLED_KEY, '[]'), true);
+		if (is_array($installed) === false) {
+			$installed = [];
+		}
+
+		$choices = array_values(array_filter($installed, static fn (mixed $entry): bool => is_array($entry) === true && isset($entry['id'], $entry['name']) === true));
+		$choices[] = ['id' => SetupTemplates::NONE, 'name' => 'No templates'];
+
+		return $choices;
+	}//end templateChoices()
+
+	/**
+	 * Install the sets a posted Sjablonen answer picked, or null when nothing was posted and all installed.
+	 *
+	 * An unknown slug is refused before anything is installed or stored. A
+	 * set that does not install leaves the answer unstored, so the step stays
+	 * open and the wizard names the set; the sets that did install are kept
+	 * and named in the summary.
+	 *
+	 * @return JSONResponse|null 400 for an unknown set, 502 when a set did not install, else null.
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#scenario-picked-templates-show-in-the-summary
+	 */
+	private function installTemplates(): ?JSONResponse {
+		$posted = $this->request->getParam(self::TEMPLATES_KEY);
+		if ($posted === null) {
+			return null;
+		}
+
+		$ids = self::templateIds(posted: $posted);
+		if ($ids === null || $ids === [] || $this->templates === null) {
+			return new JSONResponse(
+				data: ['success' => false, 'message' => 'Pick a template, or "No templates".'],
+				statusCode: Http::STATUS_BAD_REQUEST,
+			);
+		}
+
+		$unknown = $this->templates->unknown(ids: $ids);
+		if ($unknown !== []) {
+			return new JSONResponse(
+				data: ['success' => false, 'message' => 'No template is called "' . $unknown[0] . '".'],
+				statusCode: Http::STATUS_BAD_REQUEST,
+			);
+		}
+
+		$names  = array_column($this->templates->listChoices(), 'name', 'id');
+		$report = $this->templates->install(ids: $ids);
+		$this->recordInstalledTemplates(installed: $report['installed'], names: $names);
+
+		if ($report['failed'] !== []) {
+			return new JSONResponse(
+				data: ['success' => false, 'message' => 'These templates could not be installed: ' . implode(', ', $report['failed']) . '.'],
+				statusCode: Http::STATUS_BAD_GATEWAY,
+			);
+		}
+
+		return null;
+	}//end installTemplates()
+
+	/**
+	 * Add the sets that installed to the recorded list, each once.
+	 *
+	 * @param list<string>          $installed The slugs that installed.
+	 * @param array<string, string> $names     The cards' names by slug.
+	 *
+	 * @return void
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#scenario-picked-templates-show-in-the-summary
+	 */
+	private function recordInstalledTemplates(array $installed, array $names): void {
+		if ($installed === []) {
+			return;
+		}
+
+		$recorded = json_decode($this->appConfig->getValueString(Application::APP_ID, self::TEMPLATES_INSTALLED_KEY, '[]'), true);
+		if (is_array($recorded) === false) {
+			$recorded = [];
+		}
+
+		$byId = array_column(array_filter($recorded, 'is_array'), null, 'id');
+		foreach ($installed as $id) {
+			$byId[$id] = ['id' => $id, 'name' => (string)($names[$id] ?? $id)];
+		}
+
+		$this->appConfig->setValueString(Application::APP_ID, self::TEMPLATES_INSTALLED_KEY, (string)json_encode(array_values($byId)));
+	}//end recordInstalledTemplates()
+
+	/**
+	 * A posted Sjablonen answer as a list of slugs, or null when it is not one.
+	 *
+	 * @param mixed $posted A slug or a list of slugs.
+	 *
+	 * @return list<string>|null
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#requirement-the-setup-wizard-shall-offer-a-sjablonen-step-that-installs-chosen-sets-req-fts-007
+	 */
+	private static function templateIds(mixed $posted): ?array {
+		if (is_string($posted) === true) {
+			$posted = [$posted];
+		}
+
+		if (is_array($posted) === false) {
+			return null;
+		}
+
+		$ids = [];
+		foreach ($posted as $id) {
+			if (is_string($id) === false) {
+				return null;
+			}
+
+			$ids[] = $id;
+		}
+
+		return array_values(array_unique($ids));
+	}//end templateIds()
+
 	/**
 	 * Act on the dataset a card's Load button posted as `dataset`, or on the
 	 * stored pick when nothing is posted.
diff --git a/lib/Service/Setup/SetupTemplates.php b/lib/Service/Setup/SetupTemplates.php
new file mode 100644
