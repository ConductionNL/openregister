+	/**
+	 * A container that hands out the fake store under the aliased controller name.
+	 *
+	 * @param object $store The fake store controller.
+	 *
+	 * @return ContainerInterface
+	 */
+	private function container(object $store): ContainerInterface {
+		$container = $this->createMock(ContainerInterface::class);
+		$container->method('get')->with('OCA\\Humaniq\\Controller\\StoreController')->willReturn($store);
+
+		return $container;
+	}//end container()
+
+	/**
+	 * A fake store controller: search answers the given body (or throws it),
+	 * install answers per slug (or throws) and records the slugs it was asked.
+	 *
+	 * @param array<string, mixed>|RuntimeException          $search   The search body.
+	 * @param array<string, JSONResponse|RuntimeException> $installs The install answers by slug.
+	 *
+	 * @return object
+	 */
+	private function store(array|RuntimeException $search, array $installs = []): object {
+		return new class($search, $installs) {
+			/**
+			 * @var int
+			 */
+			public int $searches = 0;
+
+			/**
+			 * @var list<string>
+			 */
+			public array $installed = [];
+
+			/**
+			 * @param array<string, mixed>|RuntimeException          $search   The search body.
+			 * @param array<string, JSONResponse|RuntimeException> $installs The install answers.
+			 */
+			public function __construct(
+				private readonly array|RuntimeException $search,
+				private readonly array $installs,
+			) {
+			}
+
+			/**
+			 * @return JSONResponse
+			 */
+			public function search(): JSONResponse {
+				$this->searches++;
+				if ($this->search instanceof RuntimeException) {
+					throw $this->search;
+				}
+
+				return new JSONResponse($this->search);
+			}
+
+			/**
+			 * @param string $slug The set slug.
+			 *
+			 * @return JSONResponse
+			 */
+			public function install(string $slug): JSONResponse {
+				$this->installed[] = $slug;
+				$answer = $this->installs[$slug] ?? new JSONResponse(['success' => false], 404);
+				if ($answer instanceof RuntimeException) {
+					throw $answer;
+				}
+
+				return $answer;
+			}
+		};
+	}//end store()
+}//end class
