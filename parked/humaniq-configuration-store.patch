@@ -0,0 +1,265 @@
+<?php
+
+/**
+ * Humaniq SetupTemplates
+ *
+ * The setup wizard's Sjablonen step (configuration-store REQ-FTS-007): the
+ * configuration sets the Marketplace page offers, as wizard cards, and the
+ * install of the sets an administrator picked. It holds no store code of its
+ * own (design.md D1): both the list and the install go through
+ * `Controller\StoreController`, which Application::register() aliases at
+ * OpenRegister's GenericStoreController, so the step and the Marketplace page
+ * share one search and one install path, the same registry configuration and
+ * the same admin-only install posture. With no registry configured that
+ * controller answers `not_configured` without a network call and the step
+ * lists humaniq's own items only (D3).
+ *
+ * @category Service
+ * @package  OCA\Humaniq\Service\Setup
+ *
+ * @author    Conduction Development Team <info@conduction.nl>
+ * @copyright 2026 Conduction B.V.
+ * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
+ *
+ * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
+ * SPDX-License-Identifier: EUPL-1.2
+ *
+ * @link https://conduction.nl
+ *
+ * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+ */
+
+declare(strict_types=1);
+
+namespace OCA\Humaniq\Service\Setup;
+
+use OCP\AppFramework\Http\JSONResponse;
+use Psr\Container\ContainerInterface;
+use Psr\Log\LoggerInterface;
+use Throwable;
+
+/**
+ * Lists and installs the Sjablonen step's configuration sets through the store plane.
+ *
+ * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+ */
+class SetupTemplates {
+
+	/**
+	 * The card that answers the step with "no templates", like the demo-data
+	 * step's "none": picking it records the step as dealt with.
+	 */
+	public const NONE = 'none';
+
+	/**
+	 * The store controller the routes alias, resolved lazily: it exists only
+	 * while OpenRegister is installed and enabled.
+	 */
+	private const STORE_CONTROLLER = 'OCA\\Humaniq\\Controller\\StoreController';
+
+	/**
+	 * Constructor.
+	 *
+	 * @param ContainerInterface $container Resolves the aliased store controller.
+	 * @param LoggerInterface    $logger    Records a store that could not be reached.
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+	 */
+	public function __construct(
+		private readonly ContainerInterface $container,
+		private readonly LoggerInterface $logger,
+	) {
+	}//end __construct()
+
+	/**
+	 * The step's cards: humaniq's built-in items and the sets the trusted
+	 * registries publish, each once by slug, then the "no templates" card.
+	 *
+	 * @return list<array{id: string, name: string, description: string}>
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#requirement-the-setup-wizard-shall-offer-a-sjablonen-step-that-installs-chosen-sets-req-fts-007
+	 */
+	public function listChoices(): array {
+		$choices = [];
+		$data    = $this->searchData();
+		foreach (['builtIn', 'cards'] as $list) {
+			$entries = $data[$list] ?? [];
+			if (is_array($entries) === false) {
+				continue;
+			}
+
+			foreach ($entries as $entry) {
+				$choice = self::choice(entry: $entry);
+				if ($choice !== null && isset($choices[$choice['id']]) === false) {
+					$choices[$choice['id']] = $choice;
+				}
+			}
+		}
+
+		$choices[self::NONE] = [
+			'id'          => self::NONE,
+			'name'        => 'No templates',
+			'description' => 'Start without a published configuration. You can install one later from the Marketplace.',
+		];
+
+		return array_values($choices);
+	}//end listChoices()
+
+	/**
+	 * The ids among the given ones that are not a card of the step, in order.
+	 *
+	 * @param list<string> $ids The picked ids.
+	 *
+	 * @return list<string>
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#requirement-the-setup-wizard-shall-offer-a-sjablonen-step-that-installs-chosen-sets-req-fts-007
+	 */
+	public function unknown(array $ids): array {
+		$known = array_column($this->listChoices(), 'id');
+
+		return array_values(array_filter($ids, static fn (string $id): bool => in_array($id, $known, true) === false));
+	}//end unknown()
+
+	/**
+	 * Install the picked sets through the store, one by one, and report which
+	 * landed and which did not. "none" installs nothing.
+	 *
+	 * @param list<string> $ids The picked set slugs.
+	 *
+	 * @return array{installed: list<string>, failed: list<string>}
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#scenario-picked-templates-show-in-the-summary
+	 */
+	public function install(array $ids): array {
+		$report = ['installed' => [], 'failed' => []];
+		foreach ($ids as $id) {
+			if ($id === self::NONE) {
+				continue;
+			}
+
+			$key = 'failed';
+			if ($this->installOne(slug: $id) === true) {
+				$key = 'installed';
+			}
+
+			$report[$key][] = $id;
+		}
+
+		return $report;
+	}//end install()
+
+	/**
+	 * Install one set through the store controller; false when it refused or failed.
+	 *
+	 * @param string $slug The set slug.
+	 *
+	 * @return bool
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#scenario-picked-templates-show-in-the-summary
+	 */
+	private function installOne(string $slug): bool {
+		$store = $this->store();
+		if ($store === null || method_exists($store, 'install') === false) {
+			return false;
+		}
+
+		try {
+			$response = $store->install(slug: $slug);
+		} catch (Throwable $e) {
+			$this->logger->error('Setup: installing template ' . $slug . ' failed: ' . $e::class);
+			return false;
+		}
+
+		if (($response instanceof JSONResponse) === false || $response->getStatus() >= 400) {
+			return false;
+		}
+
+		$data = $response->getData();
+
+		return is_array($data) === true && ($data['success'] ?? true) !== false;
+	}//end installOne()
+
+	/**
+	 * The store search's response body, or an empty one when there is no store or it failed.
+	 *
+	 * @return array<string, mixed>
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md#scenario-no-registry-means-no-outside-call
+	 */
+	private function searchData(): array {
+		$store = $this->store();
+		if ($store === null || method_exists($store, 'search') === false) {
+			return [];
+		}
+
+		try {
+			$response = $store->search();
+		} catch (Throwable $e) {
+			$this->logger->warning('Setup: the template store could not be searched: ' . $e::class);
+			return [];
+		}
+
+		if (($response instanceof JSONResponse) === false) {
+			return [];
+		}
+
+		$data = $response->getData();
+		if (is_array($data) === false) {
+			return [];
+		}
+
+		return $data;
+	}//end searchData()
+
+	/**
+	 * The aliased store controller, or null when OpenRegister does not provide it.
+	 *
+	 * @return object|null
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+	 */
+	private function store(): ?object {
+		try {
+			$store = $this->container->get(self::STORE_CONTROLLER);
+		} catch (Throwable $e) {
+			return null;
+		}
+
+		if (is_object($store) === false) {
+			return null;
+		}
+
+		return $store;
+	}//end store()
+
+	/**
+	 * One store entry as a wizard card, or null when it has no usable slug.
+	 *
+	 * @param mixed $entry A store card or built-in item.
+	 *
+	 * @return array{id: string, name: string, description: string}|null
+	 *
+	 * @spec openspec/changes/configuration-store/specs/first-time-setup/spec.md
+	 */
+	private static function choice(mixed $entry): ?array {
+		if (is_array($entry) === false) {
+			return null;
+		}
+
+		$slug = trim((string)($entry['slug'] ?? ($entry['id'] ?? '')));
+		if ($slug === '' || $slug === self::NONE || preg_match('/^[a-z0-9][a-z0-9-]*[a-z0-9]$/', $slug) !== 1) {
+			return null;
+		}
+
+		$name = trim((string)($entry['title'] ?? ($entry['name'] ?? '')));
+		if ($name === '') {
+			$name = $slug;
+		}
+
+		return [
+			'id'          => $slug,
+			'name'        => $name,
+			'description' => trim((string)($entry['description'] ?? '')),
+		];
+	}//end choice()
+}//end class
