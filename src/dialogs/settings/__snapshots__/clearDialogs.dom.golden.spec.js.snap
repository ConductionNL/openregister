exports[`clear dialog audit renders with clearing false 1`] = `
"<x-ncdialog name="Confirm Clear Audit Trails" size="small" noclose="false" class="" open="true">
  <slot-default>
    <div class="clear-dialog-content">
      <h3>⚠️ Confirm Clear All Audit Trails</h3>
      <p>This operation will permanently delete all audit trail logs from the database. This action cannot be undone.</p>
      <p><strong>Current audit trails: 12</strong></p>
      <p><strong>This operation may take some time to complete.</strong></p>
      <div class="dialog-actions">
        <x-ncbutton>
          <slot-default>t:Cancel</slot-default>
        </x-ncbutton>
        <x-ncbutton variant="error" disabled="false">
          <slot-default> Confirm Clear All</slot-default>
          <slot-icon>
            <x-delete size="20"></x-delete>
          </slot-icon>
        </x-ncbutton>
      </div>
    </div></slot-default>
</x-ncdialog>"
`;

