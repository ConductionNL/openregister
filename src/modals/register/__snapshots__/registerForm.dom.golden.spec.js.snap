    </x-ncselect>
    <div class="register-languages-editor"><label class="register-languages-editor__label">t:Languages</label>
      <p class="register-languages-editor__help">t:Ordered BCP 47 language tags. The first language is the register default and drives Accept-Language fallback for translatable properties.</p>
      <p class="register-languages-editor__empty">No languages configured</p>
      <form class="register-languages-editor__add"><input type="text" aria-label="BCP 47 tag (e.g. nl, en, ar-SA)" placeholder="BCP 47 tag (e.g. nl, en, ar-SA)" maxlength="35" class="register-languages-editor__input"><button type="submit" class="register-languages-editor__btn" disabled="">Add</button></form>
    </div>
  </div>
</x-cnformdialog>"
`;

