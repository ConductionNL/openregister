  <div class="formContainer">
    <x-nctextfield label="t:Title *" modelvalue="Reg" error="true" helpertext="bad title">
    </x-nctextfield>
    <x-nctextfield label="t:Slug *" modelvalue="reg" error="false">
    </x-nctextfield>
    <x-nctextarea label="t:Description" modelvalue="D">
    </x-nctextarea>
