exports[`audit trail action badge golden changes: renders the badge for every action 1`] = `
{
  "create": "<span class="action-badge action-create"><x-plus size="16"></x-plus> CREATE</span>",
  "delete": "<span class="action-badge action-delete"><x-delete size="16"></x-delete> DELETE</span>",
  "lock": "<span class="action-badge action-lock"> LOCK</span>",
  "read": "<span class="action-badge action-read"><x-eye size="16"></x-eye> READ</span>",
