exports[`audit trail action badge golden changes: renders the open dialog 1`] = `
"<x-ncdialog name="t:Audit Trail Changes" size="large">
  <slot-actions>
    <x-ncbutton>
      <slot-default> t:Copy Changes</slot-default>
      <slot-icon>
        <x-contentcopy size="20"></x-contentcopy>
      </slot-icon>
    </x-ncbutton>
    <x-ncbutton>
      <slot-default> t:View Full Details</slot-default>
      <slot-icon>
        <x-eye size="20"></x-eye>
      </slot-icon>
    </x-ncbutton>
    <x-ncbutton>
      <slot-default> t:Close</slot-default>
      <slot-icon>
        <x-close size="20"></x-close>
      </slot-icon>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="audit-trail-changes">
      
      <div class="changes-header">
        <h3>t:Changes for Audit Trail #{id}{"id":42}</h3>
        <div class="audit-info"><span class="action-badge action-update"><x-pencil size="16"></x-pencil> UPDATE</span><span class="timestamp">local-time</span><span class="user">Alice</span></div>
      </div>
      <div class="changes-section">
        <div class="changes-table-container">
          <table class="changes-table">
            <thead>
              <tr>
                <th scope="col">t:Field</th>
                <th scope="col">t:Old Value</th>
                <th scope="col">t:New Value</th>
                <th scope="col">t:Change Type</th>
              </tr>
            </thead>
            <tbody>
              <tr class="change-row">
                <td class="field-name">title</td>
                <td class="old-value"><span>a</span></td>
                <td class="new-value"><span>b</span></td>
                <td class="change-type"><span class="type-badge modified">t:Modified</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

