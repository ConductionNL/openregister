exports[`EditSource golden opens on a internal source: dom 1`] = `
"<x-ncdialog name="Edit Source" size="normal" noclose="">
  <slot-actions>
    <x-ncbutton data-on="onClick">
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
      <slot-default> Cancel</slot-default>
    </x-ncbutton>
    <x-ncbutton disabled="false" variant="primary" data-on="onClick">
      <slot-icon>
        <x-contentsaveoutline size="20"></x-contentsaveoutline>
      </slot-icon>
      <slot-default> Save</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="formContainer">
      <x-nctextfield modelvalue="Main" disabled="false" label="Title *" data-on="onUpdate:modelValue"></x-nctextfield>
      <x-nctextarea modelvalue="d" disabled="false" label="Description" data-on="onUpdate:modelValue"></x-nctextarea>
      <x-ncselect clearable="false" options="[object Object],[object Object],[object Object]" modelvalue="[object Object]" inputlabel="Type" disabled="false" data-on="onUpdate:modelValue" value="[object Object]"></x-ncselect>
      <x-nctextfield disabled="false" label="Schedule" placeholder="0 * * * *" data-on="onUpdate:modelValue"></x-nctextfield>
      <x-nctextfield disabled="false" label="Account" data-on="onUpdate:modelValue"></x-nctextfield>
      <x-nctextfield disabled="false" label="Database URL" data-on="onUpdate:modelValue"></x-nctextfield>
    </div>
  </slot-default>
</x-ncdialog>"
`;

