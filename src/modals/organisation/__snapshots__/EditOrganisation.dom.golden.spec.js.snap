exports[`EditOrganisation markup renders create another 1`] = `
"<x-ncdialog name="Create Organisation" size="large" data-on="onUpdate:open">
  <slot-actions>
    <x-nccheckboxradioswitch modelvalue="true" class="create-another-checkbox" disabled="false" data-on="onUpdate:modelValue">
      <slot-default>Create another</slot-default>
    </x-nccheckboxradioswitch>
    <x-ncbutton data-on="onClick">
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
      <slot-default> Close</slot-default>
    </x-ncbutton>
    <x-ncbutton disabled="true" variant="primary" data-on="onClick">
      <slot-icon>
        <x-plus size="20"></x-plus>
      </slot-icon>
      <slot-default> Create</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <x-ncnotecard type="success">
      <slot-default>
        <p>Organisation successfully created</p>
      </slot-default>
    </x-ncnotecard>
    <div>
      <div class="tabContainer">
        <x-apptabs modelvalue="0" contentclass="mt-3" justified="" data-on="onUpdate:modelValue">
          <slot-default>
            <x-apptab active="">
              <slot-title>
                <x-cog size="16"></x-cog><span>Settings</span>
              </slot-title>
              <slot-default>
                <div class="form-editor">
                  <x-nctextfield modelvalue="" disabled="false" label="Name *" error="true" placeholder="Enter organisation name" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield modelvalue="" disabled="false" label="Slug" placeholder="Optional URL-friendly identifier" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextarea modelvalue="" disabled="false" label="Description" placeholder="Enter organisation description (optional)" rows="4" data-on="onUpdate:modelValue"></x-nctextarea>
                  <div class="groups-select-container"><label class="groups-label">Nextcloud Groups</label>
                    <x-ncselect modelvalue="[]" inputlabel="Selected Groups" disabled="false" options="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" label="name" trackby="id" multiple="true" labeloutside="true" filterable="false" placeholder="Search groups..." data-on="onUpdate:modelValue onSearchChange">
                      <slot-option>
                        <div class="group-option"><span class="group-name"></span></div>
                      </slot-option>
                      <slot-no-options><span>No groups found. Try a different search.</span></slot-no-options>
                    </x-ncselect>
                    <p class="field-hint">Only members of selected groups can access this organisation</p>
                  </div>
                  <x-nccheckboxradioswitch modelvalue="true" disabled="false" data-on="onUpdate:modelValue">
                    <slot-default>Active</slot-default>
                  </x-nccheckboxradioswitch>
                </div>
              </slot-default>
            </x-apptab>
            <x-apptab>
              <slot-title>
                <x-database size="16"></x-database><span>Quota</span>
              </slot-title>
              <slot-default>
                <div class="form-editor">
                  <x-nctextfield disabled="false" label="Storage Quota (MB)" type="number" placeholder="0 = unlimited" modelvalue="0" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="false" label="Bandwidth Quota (MB/month)" type="number" placeholder="0 = unlimited" modelvalue="0" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="false" label="API Request Quota (requests/day)" type="number" placeholder="0 = unlimited" modelvalue="0" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="false" label="User Quota" type="number" placeholder="0 = unlimited" modelvalue="0" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="false" label="Group Quota" type="number" placeholder="0 = unlimited" modelvalue="0" data-on="onUpdate:modelValue"></x-nctextfield>
                </div>
              </slot-default>
            </x-apptab>
            <x-apptab disabled="true">
              <slot-title>
                <x-accountmultiple size="16"></x-accountmultiple><span>Users</span>
              </slot-title>
              <slot-default>
                <div class="users-section">
                  <div class="users-header">
                  </div>
                  <div class="no-users">
                    <p>No users in this organisation.</p>
                  </div>
                  <x-ncnotecard type="warning">
                    <slot-default>
                      <p>Save the organisation first to manage users.</p>
                    </slot-default>
                  </x-ncnotecard>
                </div>
              </slot-default>
            </x-apptab>
            <x-apptab>
              <slot-title>
                <x-shield size="16"></x-shield><span>Security</span>
              </slot-title>
              <slot-default>
                <div class="security-section">
                  <div class="rbac-container">
                    <x-apptabs contentclass="mt-3" pills="">
                      <slot-default>
                        <x-apptab title="Registers">
                          <slot-default>
                            <x-rbactable entitytype="register" authorization="{}" availablegroups="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" organisationgroups="[]" data-on="onUpdate"></x-rbactable>
                          </slot-default>
                        </x-apptab>
                        <x-apptab title="Schemas">
                          <slot-default>
                            <x-rbactable entitytype="schema" authorization="{}" availablegroups="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" organisationgroups="[]" data-on="onUpdate"></x-rbactable>
                          </slot-default>
                        </x-apptab>
                        <x-apptab title="Objects">
                          <slot-default>
                            <x-rbactable entitytype="object" authorization="{}" availablegroups="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" organisationgroups="[]" data-on="onUpdate"></x-rbactable>
                          </slot-default>
                        </x-apptab>
                        <x-apptab title="Views">
                          <slot-default>
                            <x-rbactable entitytype="view" authorization="{}" availablegroups="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" organisationgroups="[]" data-on="onUpdate"></x-rbactable>
                          </slot-default>
                        </x-apptab>
