  <slot-default>
    <x-ncnotecard type="error">
      <slot-default>
        <p>Nope</p>
      </slot-default>
    </x-ncnotecard>
    <div>
      <div class="tabContainer">
        <x-apptabs modelvalue="0" contentclass="mt-3" justified="" data-on="onUpdate:modelValue">
          <slot-default>
            <x-apptab active="">
              <slot-title>
                <x-cog size="16"></x-cog><span>Settings</span>
              </slot-title>
              <slot-default>
                <div class="form-editor">
                  <x-nctextfield modelvalue="" disabled="false" label="Name *" error="true" placeholder="Enter organisation name" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield modelvalue="" disabled="false" label="Slug" placeholder="Optional URL-friendly identifier" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextarea modelvalue="" disabled="false" label="Description" placeholder="Enter organisation description (optional)" rows="4" data-on="onUpdate:modelValue"></x-nctextarea>
