    </x-ncbutton>
    <x-ncbutton disabled="true" variant="primary" data-on="onClick">
      <slot-icon>
        <x-ncloadingicon size="20"></x-ncloadingicon>
      </slot-icon>
      <slot-default> Save</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div>
      <div class="tabContainer">
        <x-apptabs modelvalue="0" contentclass="mt-3" justified="" data-on="onUpdate:modelValue">
          <slot-default>
            <x-apptab active="">
              <slot-title>
                <x-cog size="16"></x-cog><span>Settings</span>
              </slot-title>
              <slot-default>
                <div class="form-editor">
                  <x-nctextfield modelvalue="Org" disabled="true" label="Name *" error="false" placeholder="Enter organisation name" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield modelvalue="org" disabled="true" label="Slug" placeholder="Optional URL-friendly identifier" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextarea modelvalue="d" disabled="true" label="Description" placeholder="Enter organisation description (optional)" rows="4" data-on="onUpdate:modelValue"></x-nctextarea>
                  <div class="groups-select-container"><label class="groups-label">Nextcloud Groups</label>
                    <x-ncselect modelvalue="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;gone&quot;,&quot;name&quot;:&quot;gone&quot;,&quot;userCount&quot;:0}]" inputlabel="Selected Groups" disabled="true" options="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" label="name" trackby="id" multiple="true" labeloutside="true" filterable="false" placeholder="Search groups..." data-on="onUpdate:modelValue onSearchChange">
                      <slot-option>
                        <div class="group-option"><span class="group-name"></span></div>
                      </slot-option>
                      <slot-no-options><span>No groups found. Try a different search.</span></slot-no-options>
                    </x-ncselect>
                    <p class="field-hint">Only members of selected groups can access this organisation</p>
                  </div>
                  <x-nccheckboxradioswitch modelvalue="false" disabled="true" data-on="onUpdate:modelValue">
                    <slot-default>Active</slot-default>
                  </x-nccheckboxradioswitch>
                  <x-ncnotecard type="warning">
                    <slot-default>
                      <p>Inactive organisations cannot be used</p>
                    </slot-default>
                  </x-ncnotecard>
                </div>
              </slot-default>
            </x-apptab>
            <x-apptab>
              <slot-title>
                <x-database size="16"></x-database><span>Quota</span>
              </slot-title>
              <slot-default>
                <div class="form-editor">
                  <x-nctextfield disabled="true" label="Storage Quota (MB)" type="number" placeholder="0 = unlimited" modelvalue="3" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="true" label="Bandwidth Quota (MB/month)" type="number" placeholder="0 = unlimited" modelvalue="1" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="true" label="API Request Quota (requests/day)" type="number" placeholder="0 = unlimited" modelvalue="7" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="true" label="User Quota" type="number" placeholder="0 = unlimited" modelvalue="8" data-on="onUpdate:modelValue"></x-nctextfield>
                  <x-nctextfield disabled="true" label="Group Quota" type="number" placeholder="0 = unlimited" modelvalue="9" data-on="onUpdate:modelValue"></x-nctextfield>
                </div>
              </slot-default>
            </x-apptab>
            <x-apptab disabled="false">
              <slot-title>
                <x-accountmultiple size="16"></x-accountmultiple><span>Users</span>
              </slot-title>
              <slot-default>
                <div class="users-section">
                  <div class="users-header">
                    <x-ncbutton variant="primary" disabled="true" data-on="onClick">
                      <slot-icon>
                        <x-accountplus size="20"></x-accountplus>
                      </slot-icon>
                      <slot-default> Add User</slot-default>
                    </x-ncbutton>
                  </div>
                  <div class="users-list">
                    <h3>Members ({count}) {"count":2}</h3>
                    <div class="user-items">
                      <div class="user-item">
                        <div class="user-info">
                          <x-accountcircle size="20" class="user-icon"></x-accountcircle><span class="user-id">owner</span><span class="owner-badge">Owner</span></div>
                      </div>
                      <div class="user-item">
                        <div class="user-info">
                          <x-accountcircle size="20" class="user-icon"></x-accountcircle><span class="user-id">member</span></div>
