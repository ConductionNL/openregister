                          <slot-default>
                            <x-rbactable entitytype="agent" authorization="{}" availablegroups="[{&quot;id&quot;:&quot;admin&quot;,&quot;name&quot;:&quot;Admins&quot;,&quot;userCount&quot;:2},{&quot;id&quot;:&quot;staff&quot;,&quot;name&quot;:&quot;Staff&quot;,&quot;userCount&quot;:9}]" organisationgroups="[]" data-on="onUpdate"></x-rbactable>
