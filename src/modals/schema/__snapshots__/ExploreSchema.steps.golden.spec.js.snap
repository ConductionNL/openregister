exports[`explore schema before an analysis lists the analysis steps 2`] = `
"<x-ncdialog name="Analyze Schema Properties" size="large">
<slot-default>
<x-ncnotecard type="error">
<slot-default>
<p>t:No schema selected for exploration</p>
</slot-default>
</x-ncnotecard>
