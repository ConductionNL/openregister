exports[`bulk dialogs DOM golden purge: busy 1`] = `
"<x-ncdialog name="Purge {count} objects from database {&quot;count&quot;:4}" size="normal" noclose="">
  <slot-actions>
    <x-ncbutton data-on="onClick">
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
      <slot-default> Cancel</slot-default>
    </x-ncbutton>
    <x-ncbutton disabled="true" variant="error" data-on="onClick">
      <slot-icon>
        <x-ncloadingicon size="20"></x-ncloadingicon>
        <!--v-if-->
      </slot-icon>
      <slot-default> Purge</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="delete-step">
      <h3 class="step-title">Confirm Permanent Object Deletion</h3>
      <x-ncnotecard type="warning">
        <slot-default>Review the selected objects below. You can remove any objects you don't want to permanently delete by clicking the remove button. This action cannot be undone.</slot-default>
      </x-ncnotecard>
      <div class="selected-objects-container">
        <h4>Selected Objects ({count}) {"count":4}</h4>
        <div class="selected-objects-list">
          <div class="selected-object-item">
            <div class="object-info"><strong>First</strong>
              <p class="object-id">ID: {id} {"id":"a"}</p>
            </div>
            <x-ncbutton variant="tertiary" aria-label="Remove {title} {&quot;title&quot;:&quot;First&quot;}" data-on="onClick">
              <slot-icon>
                <x-close size="20"></x-close>
              </slot-icon>
            </x-ncbutton>
          </div>
          <div class="selected-object-item">
            <div class="object-info"><strong>two.pdf</strong>
              <p class="object-id">ID: {id} {"id":"b"}</p>
            </div>
            <x-ncbutton variant="tertiary" aria-label="Remove {title} {&quot;title&quot;:&quot;two.pdf&quot;}" data-on="onClick">
              <slot-icon>
                <x-close size="20"></x-close>
              </slot-icon>
            </x-ncbutton>
          </div>
          <div class="selected-object-item">
            <div class="object-info"><strong>Nested</strong>
              <p class="object-id">ID: {id} {"id":"c"}</p>
            </div>
            <x-ncbutton variant="tertiary" aria-label="Remove {title} {&quot;title&quot;:&quot;Nested&quot;}" data-on="onClick">
              <slot-icon>
                <x-close size="20"></x-close>
              </slot-icon>
            </x-ncbutton>
          </div>
          <div class="selected-object-item">
            <div class="object-info"><strong>d</strong>
              <p class="object-id">ID: {id} {"id":"d"}</p>
            </div>
            <x-ncbutton variant="tertiary" aria-label="Remove {title} {&quot;title&quot;:&quot;d&quot;}" data-on="onClick">
              <slot-icon>
                <x-close size="20"></x-close>
              </slot-icon>
            </x-ncbutton>
          </div>
        </div>
      </div>
    </div>
    <!--v-if-->
    <!--v-if-->
  </slot-default>
</x-ncdialog>"
`;

