// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`LLM configuration modal DOM golden closed 1`] = `""`;

exports[`LLM configuration modal DOM golden open 1`] = `
"<x-ncdialog name="LLM Configuration" size="large" data-on="onClosing">
  <slot-actions>
    <div class="actions-left">
      <x-ncbutton variant="error" disabled="false" data-on="onClick">
        <slot-icon>
          <x-delete size="20"></x-delete>
        </slot-icon>
        <slot-default> Clear All Embeddings</slot-default>
      </x-ncbutton>
    </div>
    <div class="actions-right">
      <x-ncbutton data-on="onClick">
        <slot-default>Cancel</slot-default>
      </x-ncbutton>
      <x-ncbutton variant="primary" disabled="false" data-on="onClick">
        <slot-icon>
          <x-contentsave size="20"></x-contentsave>
        </slot-icon>
        <slot-default> Save Configuration</slot-default>
      </x-ncbutton>
    </div>
  </slot-actions>
  <slot-default>
    <div class="llm-config-content">
      <div class="info-box">
        <x-informationoutline size="20"></x-informationoutline>
        <p>Configure large language model (LLM) providers for ai-powered features including semantic search, embeddings, and chat.</p>
      </div>
      <div class="providers-grid">
        <div class="provider-column">
          <h3>Embedding Provider</h3>
          <p class="section-description">For vector embeddings and semantic search</p>
          <x-ncselect options="[object Object],[object Object],[object Object]" label="name" inputlabel="Embedding Provider" placeholder="Select provider" data-on="onUpdate:modelValue">
            <slot-option>
              <div class="provider-option"><strong></strong><small></small></div>
            </slot-option>
          </x-ncselect>
        </div>
        <div class="provider-column">
          <h3>Chat Provider (RAG)</h3>
          <p class="section-description">For chat and retrieval-augmented generation</p>
          <x-ncselect options="[object Object],[object Object],[object Object]" label="name" inputlabel="Chat Provider" placeholder="Select provider" data-on="onUpdate:modelValue">
            <slot-option>
              <div class="provider-option"><strong></strong><small></small></div>
            </slot-option>
          </x-ncselect>
        </div>
      </div>
      <div class="config-section">
        <h3>Vector Search Backend</h3>
        <p class="section-description">Choose how vector similarity calculations are performed for semantic search</p>
        <div class="form-group"><label for="vector-backend">Search Method</label>
          <x-ncselect inputlabel="Selected Vector Backend" options="[object Object]" label="name" placeholder="Select backend" disabled="false" data-on="onUpdate:modelValue" modelvalue="[object Object]">
            <slot-option>
              <div class="backend-option backend-disabled">
                <div class="backend-header"><strong></strong>
                </div><small></small><small class="warning-text">⚠️ Not available</small>
              </div>
            </slot-option>
          </x-ncselect>
        </div>
      </div>
      <div class="config-section">
        <h3>✨ AI Features</h3>
        <div class="features-grid">
          <x-nccheckboxradioswitch modelvalue="true" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">✍️ Text Generation</span></slot-default>
          </x-nccheckboxradioswitch>
          <x-nccheckboxradioswitch modelvalue="true" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">📋 Document Summarization</span></slot-default>
          </x-nccheckboxradioswitch>
          <x-nccheckboxradioswitch modelvalue="true" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">🔍 Semantic Search</span></slot-default>
          </x-nccheckboxradioswitch>
          <x-nccheckboxradioswitch modelvalue="true" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">🧮 Text Embeddings</span></slot-default>
          </x-nccheckboxradioswitch>
          <x-nccheckboxradioswitch modelvalue="false" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">🌍 Translation</span></slot-default>
          </x-nccheckboxradioswitch>
          <x-nccheckboxradioswitch modelvalue="false" type="checkbox" data-on="onUpdate:modelValue">
            <slot-default><span class="feature-label">🏷️ Content Classification</span></slot-default>
          </x-nccheckboxradioswitch>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

