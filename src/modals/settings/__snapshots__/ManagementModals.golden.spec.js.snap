          </x-nccheckboxradioswitch><small>Include ids and names of related objects for better contextual search</small>
        </div>
      </div>
      <div class="config-section">
        <h3>⚡ Batch Processing</h3>
        <div class="form-group"><label for="batch-size">Batch Size</label><input id="batch-size" type="number" min="1" max="100" step="1" class="input-field"><small>Number of objects to vectorize in one API call. Higher = faster but more memory. Recommended: 10-50.</small></div>
        <div class="form-group">
          <x-nccheckboxradioswitch modelvalue="true" type="switch" data-on="onUpdate:modelValue">
            <slot-default>Auto-retry failed vectorizations</slot-default>
          </x-nccheckboxradioswitch><small>Automatically retry failed vectorization attempts (max 3 retries)</small>
        </div>
      </div>
      <div class="config-section">
        <h3>ℹ️ current configuration</h3>
        <div class="info-grid">
          <div class="info-item"><span class="info-label">Embedding Provider</span><span class="info-value">ollama</span></div>
          <div class="info-item"><span class="info-label">Embedding Model</span><span class="info-value">nomic</span></div>
          <div class="info-item"><span class="info-label">Vector Dimensions</span><span class="info-value">768</span></div>
        </div>
        <div class="info-note"><small>To change the embedding provider or model, go to LLM configuration.</small></div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;
