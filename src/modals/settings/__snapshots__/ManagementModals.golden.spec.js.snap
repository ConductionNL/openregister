"<x-ncdialog name="File Vectorization" size="large" data-on="onClosing">
  <slot-actions>
    <x-ncbutton data-on="onClick">
      <slot-default>Cancel</slot-default>
    </x-ncbutton>
    <x-ncbutton variant="primary" disabled="false" data-on="onClick">
      <slot-icon>
        <x-contentsave size="20"></x-contentsave>
      </slot-icon>
      <slot-default> Save Configuration</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="file-config-content">
      <div class="info-box">
        <x-informationoutline size="20"></x-informationoutline>
        <div>
          <h4>Using Pre-Generated Chunks</h4>
          <p>Text chunks are generated during file extraction and stored in the database. Vectorization reads these pre-chunked files and converts them to embeddings.</p>
          <p><strong>To adjust chunk size or strategy, go to file configuration → processing limits.</strong></p>
        </div>
      </div>
      <div class="config-section">
        <h3>🔢 Vectorization Settings</h3>
        <div class="form-group">
          <x-nccheckboxradioswitch modelvalue="true" type="switch" data-on="onUpdate:modelValue">
            <slot-default>Enable automatic file vectorization</slot-default>
          </x-nccheckboxradioswitch><small>Automatically generate vector embeddings from text chunks when files are uploaded and processed</small>
        </div>
      </div>
      <div class="config-section">
        <h3>⚡ Batch Processing</h3>
        <div class="form-group"><label for="batch-size">Batch Size</label><input id="batch-size" type="number" min="1" max="100" step="1" class="input-field"><small>Number of chunks to vectorize in one API call. Higher = faster but more memory. Recommended: 10-50.</small></div>
        <div class="form-group">
          <x-nccheckboxradioswitch modelvalue="true" type="switch" data-on="onUpdate:modelValue">
            <slot-default>Auto-retry failed vectorizations</slot-default>
          </x-nccheckboxradioswitch><small>Automatically retry failed vectorization attempts (max 3 retries)</small>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

