exports[`edit modal select options DOM golden configuration 1`] = `
[
  "<x-select id="type-select" modelvalue="[object Object]" inputlabel="Selected Type" options="[object Object],[object Object],[object Object]" label="label" trackby="value" labeloutside="true" placeholder="Select configuration type...">
