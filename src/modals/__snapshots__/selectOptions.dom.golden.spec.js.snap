exports[`edit modal select options DOM golden webhook 1`] = `
[
  "<x-select inputlabel="Selected Method" options="[object Object],[object Object],[object Object],[object Object],[object Object]" label="label" trackby="value" labeloutside="true" placeholder="Select HTTP method" modelvalue="[object Object]">
  <x-option>
    <div class="option-content"><span class="option-title">A label</span><span class="option-description">Told</span></div>
  </x-option>
  <x-option>
    <div class="option-content"><span class="option-title">B label</span>
      <!--v-if-->
    </div>
  </x-option>
</x-select>",
  "<x-select inputlabel="Selected Event" options="" label="label" trackby="value" labeloutside="true" filterable="true" placeholder="Select event to listen to...">
  <x-option>
    <div class="option-content"><span class="option-title">A label</span><span class="option-description">Told</span><span class="option-meta"> • After</span></div>
  </x-option>
  <x-option>
    <div class="option-content"><span class="option-title">B label</span>
      <!--v-if--><span class="option-meta"> • After</span>
    </div>
  </x-option>
</x-select>",
  "<x-select inputlabel="Selected Retry Policy" options="[object Object],[object Object],[object Object]" label="label" trackby="value" labeloutside="true" placeholder="Select retry policy" modelvalue="[object Object]">
  <x-option>
    <div class="option-content"><span class="option-title">A label</span><span class="option-description">Told</span></div>
  </x-option>
  <x-option>
    <div class="option-content"><span class="option-title">B label</span>
      <!--v-if-->
    </div>
  </x-option>
</x-select>",
  "<x-select inputlabel="Payload mapping" options="" label="label" trackby="value" labeloutside="true" clearable="true" loading="false" placeholder="No mapping: send the standard payload">
  <x-option></x-option>
  <x-option></x-option>
</x-select>",
]
`;
