    <p>Failed to load branches</p>
  </div>
  <div class="publishForm">
    <div class="formRow">
      <div class="formSection formSection--inline formSection--config">
        <h3>Configuration</h3>
        <p class="formDescription">Base</p>
      </div>
      <div class="formSection formSection--inline">
        <h3>Repository</h3>
        <div data-nc="NcSelect" modelvalue="acme/site" options="[object Object],[object Object]" label="label" trackby="value" placeholder="Select a repository" disabled="false" labeloutside="true" aria-label-combobox="Repository selection"></div>
        <p class="formHint">Select a repository you have write access to</p>
      </div>
      <div class="formSection formSection--inline">
        <h3>Branch</h3>
        <div data-nc="NcSelect" options="" label="label" trackby="value" placeholder="Select a branch" disabled="false" labeloutside="true" aria-label-combobox="Branch selection" modelvalue="dev"></div>
        <p class="formHint">Select the branch to publish to</p>
      </div>
    </div>
    <div class="formSection">
      <h3>File Path</h3>
      <div data-nc="NcTextField" modelvalue="lib/settings/base.json" placeholder="e.g., lib/settings/config.json" disabled="false" label="Path in repository"></div>
      <p class="formHint">Path where the configuration file will be saved in the repository</p>
    </div>
    <div class="formSection">
      <h3>Commit Message</h3>
      <div data-nc="NcTextField" modelvalue="Update configuration: Base" placeholder="Update configuration: ..." disabled="false" label="Commit message"></div>
    </div>
    <div class="formActions">
      <div data-nc="NcButton" variant="primary" disabled="false">
        <!----> Publish
      </div>
      <div data-nc="NcButton" disabled="false">Cancel</div>
    </div>
  </div>
</div>",
