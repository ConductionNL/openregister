exports[`view modals DOM golden source, filled, tab 0 1`] = `
"<x-ncdialog name="View Source: Source" size="large" noclose="">
  <slot-actions>
    <x-ncactionbutton closeafterclick="">
      <slot-icon>
        <x-pencil size="20"></x-pencil>
      </slot-icon>
      <slot-default> Edit Source </slot-default>
    </x-ncactionbutton>
    <x-ncactionbutton closeafterclick="">
      <slot-icon>
        <x-trashcanoutline size="20"></x-trashcanoutline>
      </slot-icon>
      <slot-default> Delete Source </slot-default>
    </x-ncactionbutton>
    <x-ncbutton variant="primary">
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
      <slot-default> Close</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="formContainer viewSourceDialog">
      <div class="sourceDetailsGrid">
        <div class="sourceMainInfo">
          <h2>Source</h2>
          <p class="sourceDescription">About it</p>
        </div>
        <div class="sourceProperties">
          <div class="propertyItem"><strong>t:Type:</strong><span>internal</span></div>
          <div class="propertyItem"><strong>t:Database URL:</strong><span class="urlValue">mysql://x</span></div>
          <div class="propertyItem"><strong>t:Created:</strong><span>2026-01-02T03:04:05.000Z</span></div>
          <div class="propertyItem"><strong>t:Updated:</strong><span>2026-01-02T03:04:05.000Z</span></div>
        </div>
      </div>
      <div class="tabContainer">
        <div class="tabHeaders"><button class="tabHeader active">t:Registers</button><button class="tabHeader">t:Logs</button></div>
        <div class="tabContent">
          <div class="tabPanel">
            <div class="registersGrid">
              <div class="registerCard">
                <div class="registerHeader">
                  <h3>Reg</h3>
                  <x-ncactions>
                    <slot-default>
                      <x-ncactionbutton closeafterclick="">
                        <slot-icon>
                          <x-eye size="20"></x-eye>
                        </slot-icon>
                        <slot-default> View </slot-default>
                      </x-ncactionbutton>
                      <x-ncactionbutton closeafterclick="">
                        <slot-icon>
                          <x-pencil size="20"></x-pencil>
                        </slot-icon>
                        <slot-default> Edit </slot-default>
                      </x-ncactionbutton>
                    </slot-default>
                  </x-ncactions>
                </div>
                <p class="registerDescription">R</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

