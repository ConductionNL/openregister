// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`view modals DOM golden configuration, filled, tab 0 1`] = `
"<x-ncdialog name="View Configuration: Config" size="large" noclose="">
  <slot-actions>
    <x-ncactionbutton closeafterclick="">
      <slot-icon>
        <x-pencil size="20"></x-pencil>
      </slot-icon>
      <slot-default> Edit Configuration </slot-default>
    </x-ncactionbutton>
    <x-ncactionbutton closeafterclick="">
      <slot-icon>
        <x-download size="20"></x-download>
      </slot-icon>
      <slot-default> Export Configuration </slot-default>
    </x-ncactionbutton>
    <x-ncactionbutton closeafterclick="">
      <slot-icon>
        <x-trashcanoutline size="20"></x-trashcanoutline>
      </slot-icon>
      <slot-default> Delete Configuration </slot-default>
    </x-ncactionbutton>
    <x-ncbutton variant="primary">
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
      <slot-default> Close</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div class="formContainer viewConfigurationDialog">
      <div class="configurationDetailsGrid">
        <div class="configurationMainInfo">
          <h2>Config</h2>
          <p class="configurationDescription">About it</p>
        </div>
        <div class="configurationProperties">
          <div class="propertyItem"><strong>t:Type:</strong><span>app</span></div>
          <div class="propertyItem"><strong>t:Owner:</strong><span>admin</span></div>
          <div class="propertyItem"><strong>t:Created:</strong><span>2026-01-02T03:04:05.000Z</span></div>
          <div class="propertyItem"><strong>t:Updated:</strong><span>2026-01-02T03:04:05.000Z</span></div>
        </div>
      </div>
      <div class="tabContainer">
        <div class="tabHeaders"><button class="tabHeader active">t:Configuration</button><button class="tabHeader">t:Logs</button></div>
        <div class="tabContent">
          <div class="tabPanel">
            <div class="configurationJsonContainer">
              <h3>t:Configuration Data</h3>
              <div class="jsonViewer"><pre>{
  "a": 1
}</pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

