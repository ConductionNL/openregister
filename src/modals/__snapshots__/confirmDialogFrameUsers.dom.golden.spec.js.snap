      <slot-default>
        <p><strong>t:Warning:</strong> t:This will permanently delete:</p>
        <ul>
          <li>t:The saved view and all its search configuration</li>
          <li>t:Any favorites and sharing settings for this view</li>
        </ul>
      </slot-default>
    </x-ncnotecard>
  </slot-default>
</x-ncdialog>"
`;

