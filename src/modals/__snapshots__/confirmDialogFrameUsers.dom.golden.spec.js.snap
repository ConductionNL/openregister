"<x-ncdialog name="t:Delete View" size="normal" noclose="">
  <slot-actions>
    <x-ncbutton>
      <slot-default> t:Cancel</slot-default>
      <slot-icon>
        <x-close size="20"></x-close>
      </slot-icon>
    </x-ncbutton>
    <x-ncbutton disabled="false" variant="error">
      <slot-default> t:Delete View</slot-default>
      <slot-icon>
        <x-delete size="20"></x-delete>
      </slot-icon>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <p>t:Are you sure you want to permanently delete <b>V</b>? t:This action cannot be undone.</p>
