exports[`dialog schemaObjects asks 1`] = `
"<x-ncdialog name="Delete Schema Objects" size="normal" noclose="true">
  <slot-actions>
    <x-ncbutton>
      <slot-default> Cancel</slot-default>
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
    </x-ncbutton>
    <x-ncbutton disabled="false" variant="error">
      <slot-default> Delete All Objects</slot-default>
      <slot-icon>
        <x-deletesweep size="20"></x-deletesweep>
      </slot-icon>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <div>
      <p> Are you sure you want to delete <strong>all objects</strong> in the schema <strong>Books</strong>? </p>
      <div class="deletion-warning-section">
        <x-ncnotecard type="warning" class="deletion-warning">
          <slot-default> t:Objects will be soft-deleted (marked as deleted but kept in database). They can be recovered later if needed.</slot-default>
          <slot-icon>
            <x-alertcircle size="20"></x-alertcircle>
          </slot-icon>
          <slot-title>t:Soft Delete Mode</slot-title>
        </x-ncnotecard>
      </div>
      <div class="object-count-info">
        <x-schemastatsblock objectcount="4" objectstats="{&quot;total&quot;:4,&quot;deleted&quot;:1}" loading="false" title="t:Objects to be deleted"></x-schemastatsblock>
        <div class="hard-delete-option">
          <x-nccheckboxradioswitch modelvalue="[]" name="hardDelete" label="t:Permanently delete already soft-deleted objects" type="checkbox" value="hardDelete"></x-nccheckboxradioswitch>
          <p class="hard-delete-description">t:This will permanently remove {count} already soft-deleted objects from the database. This action cannot be undone.</p>
        </div>
      </div>
    </div>
  </slot-default>
</x-ncdialog>"
`;

