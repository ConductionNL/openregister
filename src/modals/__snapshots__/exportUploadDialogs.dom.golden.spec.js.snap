exports[`ReimportDescriptorDialog (DOM golden) renders the question 1`] = `
"<!-- Re-importing takes the file's authorization over a local change, and
	     re-imports the whole app's configuration where it has a base
	     document: say so before it runs, not after. -->
<x-ncdialog name="t:Re-import {register}? {&quot;register&quot;:&quot;Reg&quot;}" size="small" noclose="false" class="">
  <slot-actions>
    <x-ncbutton disabled="false" data-testid="cn-dialog-actions-cancel">
      <slot-default>t:Cancel</slot-default>
    </x-ncbutton>
    <x-ncbutton variant="primary" disabled="false" data-testid="cn-dialog-actions-submit">
      <slot-default> t:Re-import</slot-default>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <!--v-if-->
    <p>t:Re-importing {app} takes the authorization of its schemas from the file, replacing any change made on this instance, and may re-import every register of the app, not only {register}. {"app":"app","register":"Reg"}</p>
  </slot-default>
</x-ncdialog>"
`;

exports[`import, export, upload and download dialogs (DOM golden) exportConfiguration renders a reported error 1`] = `
"<x-ncdialog name="export-configuration-dialog" title="t:Export Configuration" size="small" noclose="">
  <slot-actions>
    <x-ncbutton>
      <slot-default> Cancel</slot-default>
      <slot-icon>
        <x-cancel size="20"></x-cancel>
      </slot-icon>
    </x-ncbutton>
    <x-ncbutton disabled="false" variant="primary">
      <slot-default> Export </slot-default>
      <slot-icon>
        <x-export size="20"></x-export>
      </slot-icon>
    </x-ncbutton>
  </slot-actions>
  <slot-default>
    <x-ncnotecard type="error">
      <slot-default>
        <p>refused</p>
      </slot-default>
    </x-ncnotecard>
    <div class="formContainer">
      <p>Export configuration "Conf"?</p>
      <x-nccheckboxradioswitch modelvalue="false">
        <slot-default> Include related objects </slot-default>
      </x-nccheckboxradioswitch>
    </div>
  </slot-default>
</x-ncdialog>"
`;

