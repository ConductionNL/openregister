      <div class="or-mail-object-card__header"><span class="or-mail-object-card__schema"><i data-icon="default" size="16" class="or-mail-object-card__icon"></i> Zaken</span>
        <div data-stub="NcButton" variant="tertiary" aria-label="t:Remove connection to Zaak 1"><i data-icon="Close" size="20"></i></div>
      </div><a class="or-mail-object-card__title" href="/index.php/apps/openregister/registers/2/5/u-1" title="t:Open connected item">Zaak 1</a>
      <p class="or-mail-object-card__drop">t:Drop an attachment here to add it</p>
    </div>
    <div class="or-mail-object-card">
      <div class="or-mail-object-card__header"><span class="or-mail-object-card__schema"><i data-icon="default" size="16" class="or-mail-object-card__icon"></i> Leads</span>
        <div data-stub="NcButton" variant="tertiary" aria-label="t:Remove connection to Lead 2"><i data-icon="Close" size="20"></i></div>
      </div><a class="or-mail-object-card__title" href="/apps/pipelinq/leads/u-2" title="t:Open connected item">Lead 2</a>
      <p class="or-mail-object-card__drop">t:Drop an attachment here to add it</p>
    </div>
  </div>
  <!---->
</section>"
`;

