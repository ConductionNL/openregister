exports[`EntitiesTab golden renders grouped entities and reloads when the message changes 1`] = `
"<div class="or-tab-entities">
  <div>
    <div class="or-entity-group">
      <h4 class="or-entity-group-title">t:Email Addresses</h4>
      <ul class="or-entity-list">
        <li class="or-entity-item"><span class="or-entity-value">a@example.com</span>
          <!--v-if-->
        </li>
      </ul>
    </div>
    <div class="or-entity-group">
      <h4 class="or-entity-group-title">t:People</h4>
      <ul class="or-entity-list">
        <li class="or-entity-item"><span class="or-entity-value">Alice</span>
          <!--v-if-->
        </li>
      </ul>
    </div>
    <div class="or-entity-group">
      <h4 class="or-entity-group-title">t:Links</h4>
      <ul class="or-entity-list">
        <li class="or-entity-item"><span class="or-entity-value">https://example.com/x</span>
          <!--v-if-->
        </li>
      </ul>
