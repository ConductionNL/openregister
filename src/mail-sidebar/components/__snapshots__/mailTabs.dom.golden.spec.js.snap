    <div class="or-entity-group">
      <h4 class="or-entity-group-title">t:Phone Numbers</h4>
      <ul class="or-entity-list">
        <li class="or-entity-item"><span class="or-entity-value">+31 6 12345678</span>
          <!--v-if-->
        </li>
      </ul>
    </div>
  </div>
</div>"
`;

exports[`EntitiesTab golden renders the empty state without a message and makes no request 1`] = `
"<div class="or-tab-entities">
  <div class="or-tab-empty">t:No entities detected for this email.</div>
</div>"
`;

exports[`EntitiesTab golden renders the loading state while the body loads 1`] = `
"<div class="or-tab-entities">
  <div class="or-tab-loading">t:Loading entities...</div>
</div>"
`;

exports[`ObjectsTab golden renders nothing and counts zero without an account 1`] = `"<!--v-if-->"`;

