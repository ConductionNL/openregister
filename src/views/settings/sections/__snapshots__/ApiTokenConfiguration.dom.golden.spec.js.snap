<div class="token-field-group">
<label for="gitlab-url">GitLab API Base URL</label>
<x-nctextfield id="gitlab-url" modelvalue="https://git.example/api/v4" placeholder="https://gitlab.com/api/v4">
<slot-trailing-button-icon>
<x-web size="20">
</x-web>
