exports[`OrganisationConfiguration saves a selected default and hides the success after three seconds 1`] = `
{
  "afterSave": {
    "autoCreateDefault": false,
    "loadingOrganisations": false,
    "organisations": [],
    "originalAutoCreateDefault": false,
    "originalDefaultOrganisation": {
      "id": "o1",
      "label": "One",
      "uuid": "o1",
    },
    "saveError": null,
    "saveSuccess": true,
    "saving": false,
    "selectedDefaultOrganisation": {
      "id": "o1",
      "label": "One",
      "uuid": "o1",
    },
    "stats": {
      "activeOrganisations": 0,
      "averageMembersPerOrg": 0,
      "totalMembers": 0,
      "totalOrganisations": 0,
    },
  },
  "afterThreeSeconds": false,
  "beforeThreeSeconds": true,
  "seen": [
    [
      [
        "/gen/apps/openregister/api/settings/organisation",
        {
          "auto_create_default_organisation": false,
          "default_organisation": "o1",
        },
      ],
      true,
      false,
      null,
    ],
  ],
}
`;

