exports[`push notifications section renders active, check failed 1`] = `
"<x-settingssection id="push-notifications" name="t:Push Notifications" description="t:Real-time push notification status via notify_push">
<slot-default>
<div class="push-status-section">
<div class="push-status push-status--success">
<div class="push-status__badge">
<x-checkcircle size="20">
</x-checkcircle>
<span>t:Realtime push active</span>
</div>
<p class="push-status__hint">t:Real-time push notifications are active. Connected clients receive instant updates when objects are created, updated, or deleted.</p>
</div>
<div class="push-vapid-section">
<h4 class="push-vapid-section__title">t:Browser Web Push (VAPID)</h4>
<div class="push-status push-status--warning">
<div class="push-status__badge">
<x-alertoutline size="20">
</x-alertoutline>
<span>t:Browser web push is not configured</span>
</div>
<p class="push-status__hint">t:No VAPID keypair is configured yet. Generate one with the following occ command to enable browser notifications:</p>
<p class="push-status__hint">
<code class="push-vapid-section__command">occ openregister:web-push:generate-vapid</code>
</p>
</div>
</div>
</div>
</slot-default>
</x-settingssection>"
`;

