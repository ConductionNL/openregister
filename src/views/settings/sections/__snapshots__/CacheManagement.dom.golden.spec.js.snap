exports[`cache management renders when unavailable 1`] = `
"<div>
<x-settingssection name="Cache Management" description="Monitor and manage API caching for optimal performance" loading="false" loadingmessage="t:Loading cache statistics...">
<slot-actions>
<x-ncbutton variant="secondary" disabled="false">
<slot-default>Refresh</slot-default>
<slot-icon>
<x-refresh size="20">
</x-refresh>
</slot-icon>
</x-ncbutton>
<x-ncbutton variant="error" disabled="true">
<slot-default>Clear Cache</slot-default>
<slot-icon>
<x-delete size="20">
</x-delete>
</slot-icon>
</x-ncbutton>
</slot-actions>
<slot-default>
<div class="cache-unavailable">
<div class="unavailable-message">
<h4>⚠️ Cache Statistics Unavailable</h4>
<p>Cache monitoring is not available. This can happen when:</p>
<ul>
<li>Cache systems are not properly configured</li>
<li>Statistics collection is disabled for performance reasons</li>
<li>Cache backends don't support statistics</li>
</ul>
<div class="error-details">
<strong>Technical Details:</strong>No stats</div>
<p class="performance-note">
<strong>Note:</strong>This is normal behavior as storing cache metadata in database tables would cause performance issues. Cache systems are working but detailed statistics are not collected.</p>
</div>
</div>
</slot-default>
</x-settingssection>
</div>"
`;

