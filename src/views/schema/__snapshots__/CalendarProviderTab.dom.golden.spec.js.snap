  </div><!-- Save button -->
  <div class="fieldRow actions">
    <x-ncbutton variant="primary" disabled="false" data-on="onClick">
      <slot-icon>
        <x-contentsave size="20"></x-contentsave>
      </slot-icon>
      <slot-default> Save</slot-default>
    </x-ncbutton>
  </div>
</div>"
`;
