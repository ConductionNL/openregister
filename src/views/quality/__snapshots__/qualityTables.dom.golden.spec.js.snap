            </x-tr>
          </x-tbody>
        </x-cndatatable>
      </section>
      <section class="recentFailuresSection">
        <h2>t:Recent failures</h2>
        <x-cndatatable rowkey="rowKey">
          <x-thead>
            <x-th>t:Webhook</x-th>
