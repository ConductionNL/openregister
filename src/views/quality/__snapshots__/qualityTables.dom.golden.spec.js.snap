exports[`quality tables golden golden record: renders noProvenance 1`] = `
"<div class="goldenRecordPanel">
  <div class="goldenRecordHeader">
    <h2>t:Golden record</h2>
    <div class="goldenRecordHeader__actions">
      <x-ncbutton variant="secondary" data-testid="mdm-resolve-conflicts">
        <slot-default>t:Resolve conflicts</slot-default>
      </x-ncbutton>
      <x-ncbutton variant="tertiary">
        <slot-default>t:Close</slot-default>
      </x-ncbutton>
    </div>
  </div>
  <div class="goldenRecordMeta"><span><strong>t:Id:</strong> g1</span><span><strong>t:Quality score:</strong> 80</span><span><strong>t:Quality status:</strong> —</span></div>
  <x-ncemptycontent name="t:No golden-record provenance" description="t:This object has no materialised attribute-provenance map.">
    <slot-icon>
      <x-accountboxoutline size="48"></x-accountboxoutline>
    </slot-icon>
  </x-ncemptycontent>
  
</div>"
`;

