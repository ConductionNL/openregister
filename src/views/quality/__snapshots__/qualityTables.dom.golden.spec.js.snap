            <tr>
              <td>1</td>
              <td>ObjectUpdatedEvent</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>
  </slot-default>
</x-ncappcontent>",
  "mounted": [
    [
      "fetchWebhookHealth",
    ],
  ],
}
`;

