      </section>
      <section class="recentFailuresSection">
        <h2>t:Recent failures</h2>
        <table class="recentFailuresTable">
          <thead>
            <tr>
              <th scope="col">t:Webhook</th>
              <th scope="col">t:Event</th>
              <th scope="col">t:Status code</th>
              <th scope="col">t:Error</th>
              <th scope="col">t:Created</th>
            </tr>
