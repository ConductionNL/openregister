              <x-td>—</x-td>
              <x-td>—</x-td>
            </x-tr>
          </x-tbody>
        </x-cndatatable>
      </section>
    </div>
  </slot-default>
</x-ncappcontent>",
  "mounted": [
    [
      "fetchWebhookHealth",
    ],
  ],
}
`;

