        <InvalidMethodCall errorLevel="suppress"/>
        <UndefinedInterfaceMethod errorLevel="suppress"/>
        <MissingTemplateParam errorLevel="suppress"/>
    </issueHandlers>
    <extraFiles>
        <directory name="vendor/nextcloud/ocp" />
    </extraFiles>
</psalm>
