#
# Local settings for docker-compose.yml. Copy this file to .env (which git
# ignores) and fill in the values. Docker Compose reads .env on its own.
#
# Pairing secrets for the ExApp sidecars. Each ExApp container and its AppAPI
# registration must share the same value. Generate one per ExApp:
#
#   openssl rand -hex 20
#
# An empty value leaves that ExApp unpaired, so AppAPI refuses its requests.
N8N_APP_SECRET=
KEYCLOAK_APP_SECRET=
OPENKLANT_APP_SECRET=
OPENZAAK_APP_SECRET=
VALTIMO_APP_SECRET=
OPENTALK_APP_SECRET=
